Date: Mon, 27 Apr 2026 14:10:53 +0200
Subject: [PATCH 09/12] virtio_msg: ffa: add FIFO transfer common code

Add shared FF-A FIFO transfer helpers for the virtio message FF-A binding.

Signed-off-by: Bertrand Marquis <bertrand.marquis@arm.com>
---
 drivers/virtio/Kconfig                        |  11 +
 drivers/virtio/Makefile                       |   2 +
 drivers/virtio/virtio_msg_bus_ffa.h           |   6 -
 drivers/virtio/virtio_msg_bus_ffa_common.c    |  38 --
 drivers/virtio/virtio_msg_bus_ffa_xfer.h      |   6 +
 drivers/virtio/virtio_msg_bus_ffa_xfer_fifo.c | 427 ++++++++++++++++++
 drivers/virtio/virtio_msg_bus_ffa_xfer_fifo.h | 273 +++++++++++
 7 files changed, 719 insertions(+), 44 deletions(-)
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_xfer_fifo.c
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_xfer_fifo.h

diff --git a/drivers/virtio/Kconfig b/drivers/virtio/Kconfig
index 8aa80c557c30..ec6620d61661 100644
--- a/drivers/virtio/Kconfig
+++ b/drivers/virtio/Kconfig
@@ -234,6 +234,17 @@ config VIRTIO_MSG_FFA_XFER_INDIRECT
 
 	  Indirect transfer is the shared bootstrap path.
 
+config VIRTIO_MSG_FFA_XFER_FIFO
+	bool "Virtio message bus FF-A FIFO transfer support"
+	depends on VIRTIO_MSG_FFA_XFER_INDIRECT
+	default y
+	help
+	  Enable FIFO transfer support for the virtio message bus FF-A
+	  bindings.
+
+	  FIFO is a runtime upgrade path and always requires a non-FIFO
+	  bootstrap method.
+
 endif
 
 config VIRTIO_DMA_SHARED_BUFFER
