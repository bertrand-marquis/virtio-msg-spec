+#define VIRTIO_MSG_FFA_NOTIF_ID_MIN			0
+#define VIRTIO_MSG_FFA_NOTIF_ID_MAX			63
+#define VIRTIO_MSG_FFA_NOTIF_ID_INVALID		U16_MAX
+
