+		return -ENODEV;
+
+	mutex_lock(&vdev->lock);
+	if (READ_ONCE(vdev->shutting_down))
+		ret = -ENODEV;
+	else
+		ret = virtio_msg_ffa_device_area_mmap_locked(vdev, mmap_offset,
+							     vma);
