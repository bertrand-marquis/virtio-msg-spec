Message-ID: <abe6cae624a5f1f071641fdfb6bd847e21257252.1779811422.git.bertrand.marquis@arm.com>
In-Reply-To: <c754a13f81b5c8d7c27544ed31f5e983f8786f74.1779811421.git.bertrand.marquis@arm.com>
References: <c754a13f81b5c8d7c27544ed31f5e983f8786f74.1779811421.git.bertrand.marquis@arm.com>
From: Bertrand Marquis <bertrand.marquis@arm.com>
Date: Mon, 27 Apr 2026 14:11:01 +0200
Subject: [PATCH 10/12] virtio_msg: ffa: add driver role support

Add the FF-A driver-role binding for virtio message devices, including topology discovery, bus request handling, area sharing, indirect and FIFO transfer support, deferred event handling, and inbound response classification.

Signed-off-by: Bertrand Marquis <bertrand.marquis@arm.com>
---
 drivers/virtio/Kconfig                        |   20 +
 drivers/virtio/Makefile                       |   10 +
 drivers/virtio/virtio_msg_bus_ffa_driver.c    | 2194 +++++++++++++++++
 .../virtio/virtio_msg_bus_ffa_driver_area.c   |  828 +++++++
 .../virtio/virtio_msg_bus_ffa_driver_priv.h   |  214 ++
 .../virtio_msg_bus_ffa_driver_topology.c      |  971 ++++++++
 .../virtio_msg_bus_ffa_xfer_fifo_driver.c     |  827 +++++++
 .../virtio_msg_bus_ffa_xfer_indirect_driver.c |  485 ++++
 8 files changed, 5549 insertions(+)
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_driver.c
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_driver_area.c
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_driver_priv.h
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_driver_topology.c
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_xfer_fifo_driver.c
 create mode 100644 drivers/virtio/virtio_msg_bus_ffa_xfer_indirect_driver.c

diff --git a/drivers/virtio/Kconfig b/drivers/virtio/Kconfig
index ec6620d61661..9374f89ea4e1 100644
--- a/drivers/virtio/Kconfig
+++ b/drivers/virtio/Kconfig
@@ -225,6 +225,26 @@ config VIRTIO_MSG_FFA_COMMON
 	  This enables role-neutral FF-A helpers shared by the virtio
 	  message bus driver-binding and device-binding modules.
 
+config VIRTIO_MSG_FFA_DRIVER_BINDING
+	tristate "Virtio message bus FF-A driver binding"
+	depends on VIRTIO_MSG_TRANSPORT
+	depends on HAS_DMA
+	select VIRTIO_MSG_FFA_COMMON
+	select VIRTIO_MSG_BUS_QUEUE_HELPER
+	select VIRTIO_MSG_BUS_DMA_DRIVER_HELPER
+	select VIRTIO_MSG_FFA_XFER_DIRECT if !VIRTIO_MSG_FFA_XFER_INDIRECT
+	help
+	  This enables the FF-A driver binding for the virtio message
+	  bus.
+
+	  The driver discovers virtio message bus services over FF-A and
+	  exposes the resulting devices through the virtio message transport
+	  core.
+
+	  At least one bootstrap-capable transfer method must be enabled.
+
+	  If unsure, say M.
+
 config VIRTIO_MSG_FFA_XFER_INDIRECT
 	bool "Virtio message bus FF-A indirect transfer support"
 	default y
diff --git a/drivers/virtio/Makefile b/drivers/virtio/Makefile
index a1e6821e79c1..bbe571dced9e 100644
--- a/drivers/virtio/Makefile
+++ b/drivers/virtio/Makefile
@@ -20,6 +20,16 @@ virtio_msg_bus_ffa_common-$(CONFIG_VIRTIO_MSG_FFA_XFER_FIFO) += \
 obj-$(CONFIG_VIRTIO_MSG_FFA_COMMON) += virtio_msg_bus_ffa_common_module.o
 virtio_msg_bus_ffa_common_module-y := $(virtio_msg_bus_ffa_common-y)
 
+virtio_msg_bus_ffa_driver-y := virtio_msg_bus_ffa_driver.o \
+			 virtio_msg_bus_ffa_driver_area.o \
+			 virtio_msg_bus_ffa_driver_topology.o
+virtio_msg_bus_ffa_driver-$(CONFIG_VIRTIO_MSG_FFA_XFER_INDIRECT) += \
+			 virtio_msg_bus_ffa_xfer_indirect_driver.o
+virtio_msg_bus_ffa_driver-$(CONFIG_VIRTIO_MSG_FFA_XFER_FIFO) += \
+			 virtio_msg_bus_ffa_xfer_fifo_driver.o
+obj-$(CONFIG_VIRTIO_MSG_FFA_DRIVER_BINDING) += virtio_msg_bus_ffa_driver_module.o
+virtio_msg_bus_ffa_driver_module-y := $(virtio_msg_bus_ffa_driver-y)
+
 obj-$(CONFIG_VIRTIO_PCI) += virtio_pci.o
 virtio_pci-y := virtio_pci_modern.o virtio_pci_common.o
 virtio_pci-$(CONFIG_VIRTIO_PCI_LEGACY) += virtio_pci_legacy.o
diff --git a/drivers/virtio/virtio_msg_bus_ffa_driver.c b/drivers/virtio/virtio_msg_bus_ffa_driver.c
