+    VirtIODevice *vdev = virtio_msg_vdev(s, mdev->dev_num);
     VirtIOMSG msg;
 
     if (!vdev || !virtio_msg_bus_connected(&s->msg_bus)) {
@@ -821,7 +880,7 @@ static int virtio_msg_set_guest_notifier(DeviceState *d, int n, bool assign,
 {
