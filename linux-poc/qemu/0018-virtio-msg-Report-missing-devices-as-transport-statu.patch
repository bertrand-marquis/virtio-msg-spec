+    VirtIODevice *vdev;
     uint32_t index = msg->set_vqueue.index;
     VirtIOMSG msg_resp;
+    int ret;
+
+    ret = virtio_msg_lookup_vdev(s, msg->dev_num, NULL, &vdev);
+    if (ret != VIRTIO_MSG_NO_ERROR) {
+        return ret;
+    }
 
-    if (!vdev || index >= VIRTIO_QUEUE_MAX) {
-        /* Missing device or OOB index, ignore. */
+    if (index >= VIRTIO_QUEUE_MAX) {
+        /* OOB index, ignore. */
         return VIRTIO_MSG_NO_ERROR;
     }
 
@@ -472,11 +527,13 @@ static int virtio_msg_set_vqueue(VirtIOMSGProxy *s, VirtIOMSG *msg)
 
 static int virtio_msg_reset_vqueue(VirtIOMSGProxy *s, VirtIOMSG *msg)
 {
-    VirtIODevice *vdev = virtio_msg_lookup_vdev(s, msg->dev_num, __func__);
+    VirtIODevice *vdev;
     VirtIOMSG msg_resp;
+    int ret;
 
-    if (!vdev) {
-        return VIRTIO_MSG_NO_ERROR;
+    ret = virtio_msg_lookup_vdev(s, msg->dev_num, NULL, &vdev);
+    if (ret != VIRTIO_MSG_NO_ERROR) {
+        return ret;
     }
 
     virtio_queue_reset(vdev, msg->reset_vqueue.index);
@@ -488,12 +545,14 @@ static int virtio_msg_reset_vqueue(VirtIOMSGProxy *s, VirtIOMSG *msg)
 static int virtio_msg_event_avail(VirtIOMSGProxy *s,
                                   VirtIOMSG *msg)
 {
-    VirtIODevice *vdev = virtio_msg_lookup_vdev(s, msg->dev_num, __func__);
+    VirtIODevice *vdev;
     uint16_t vq_idx = msg->event_avail.index;
     VirtQueue *vq;
+    int ret;
 
-    if (!vdev) {
-        return VIRTIO_MSG_NO_ERROR;
+    ret = virtio_msg_lookup_vdev(s, msg->dev_num, NULL, &vdev);
+    if (ret != VIRTIO_MSG_NO_ERROR) {
