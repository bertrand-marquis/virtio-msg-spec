From: Bertrand Marquis <bertrand.marquis@arm.com>
Date: Fri, 22 May 2026 10:27:21 +0200
Subject: [PATCH 05/30] memory: Fully reset MemoryRegionCache state

Make address_space_cache_init_empty() clear the cached pointer,
translation, length, write state, FlatView pointer, and full
MemoryRegionSection.

Empty caches must be safe to destroy after failed cache initialization.
Direct-map-only address spaces rely on this invariant when cache setup
rejects indirect mappings and normalizes the cache back to an inert state.

Signed-off-by: Bertrand Marquis <bertrand.marquis@arm.com>
---
 include/system/memory_cached.h | 6 +++++-
 system/physmem.c               | 7 +++++--
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/include/system/memory_cached.h b/include/system/memory_cached.h
index 6eb6179140b8..66976fbaacab 100644
--- a/include/system/memory_cached.h
+++ b/include/system/memory_cached.h
@@ -132,9 +132,13 @@ int64_t address_space_cache_init(MemoryRegionCache *cache,
  */
 static inline void address_space_cache_init_empty(MemoryRegionCache *cache)
 {
-    cache->mrs.mr = NULL;
+    cache->ptr = NULL;
+    cache->xlat = 0;
+    cache->len = 0;
+    cache->mrs = (MemoryRegionSection) { };
     /* There is no real need to initialize fv, but it makes Coverity happy. */
     cache->fv = NULL;
+    cache->is_write = false;
 }
 
 /**
diff --git a/system/physmem.c b/system/physmem.c
index e5ff26acecd2..3a6d01e52fe3 100644
--- a/system/physmem.c
+++ b/system/physmem.c
@@ -3897,14 +3897,17 @@ void address_space_cache_destroy(MemoryRegionCache *cache)
     if (!cache->mrs.mr) {
         return;
     }
+    /*
+     * cache->mrs.mr was validated above, and init_empty() normalization keeps
+     * cache->ptr/cache->xlat/cache->len safe to dereference for teardown.
+     */
 
     if (xen_enabled()) {
         xen_invalidate_map_cache_entry(cache->ptr);
     }
     memory_region_unref(cache->mrs.mr);
     flatview_unref(cache->fv);
-    cache->mrs.mr = NULL;
-    cache->fv = NULL;
+    address_space_cache_init_empty(cache);
 }
 
 /* Called from RCU critical section.  This function has the same
-- 
