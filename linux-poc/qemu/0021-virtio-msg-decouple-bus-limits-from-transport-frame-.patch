             virtio_msg_bus_receive(bd, &msg);
         }
     } while (r);
@@ -307,13 +323,25 @@ static int vmsg_bus_amp_pci_send(VirtIOMSGBusDevice *bd, VirtIOMSG *msg_req)
 {
     VmsgAmpPciState *pci_s = VMSG_AMP_PCI(OBJECT(bd)->parent);
