 {
     uint64_t r = 0;
@@ -282,7 +289,6 @@ static void vmsg_bus_amp_pci_process(VirtIOMSGBusDevice *bd)
 {
     VmsgBusAmpPciState *s = VMSG_BUS_AMP_PCI(bd);
     spsc_queue *q;
-    VirtIOMSG msg;
     bool r;
 
     if (!vmsg_bus_amp_pci_map_fifo(s)) {
@@ -295,8 +301,18 @@ static void vmsg_bus_amp_pci_process(VirtIOMSGBusDevice *bd)
      */
     q = bd->peer->is_driver ? &s->shm.device : &s->shm.driver;
     do {
-        r = spsc_recv(q, &msg, sizeof msg);
+        VirtIOMSG msg = { 0 };
+        uint16_t msg_size;
+
+        r = spsc_recv(q, &msg, VMSG_BUS_AMP_PCI_MAX_MSG_SIZE);
         if (r) {
+            msg_size = le16_to_cpu(msg.msg_size);
+            if (!vmsg_bus_amp_pci_valid_msg_size(msg_size)) {
+                qemu_log_mask(LOG_GUEST_ERROR,
+                              "%s: dropping malformed message size %u\n",
+                              __func__, msg_size);
