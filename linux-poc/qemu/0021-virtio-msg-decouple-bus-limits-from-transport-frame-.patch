 hw/virtio/virtio-msg-bus.c          |   1 +
 hw/virtio/virtio-msg.c              | 128 +++++++++++++++++++---------
 include/hw/virtio/virtio-msg-bus.h  |   1 +
 include/hw/virtio/virtio-msg-prot.h |  50 +++++++++--
 5 files changed, 178 insertions(+), 50 deletions(-)

