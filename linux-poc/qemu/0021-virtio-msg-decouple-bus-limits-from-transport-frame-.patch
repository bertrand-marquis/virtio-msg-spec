+static inline unsigned int virtio_msg_max_feature_num_for_size(
+    uint16_t max_msg_size)
+{
+    size_t msg_prefix_size = offsetof(VirtIOMSG, get_features_resp.b32);
+
+    if (max_msg_size <= msg_prefix_size) {
+        return 0;
+    }
+
+    return (max_msg_size - msg_prefix_size) / sizeof(uint32_t);
+}
+
+static inline unsigned int virtio_msg_max_config_bytes_for_size(
+    uint16_t max_msg_size)
+{
+    size_t msg_prefix_size = offsetof(VirtIOMSG, set_config.data);
+
+    if (max_msg_size <= msg_prefix_size) {
+        return 0;
+    }
+
+    return max_msg_size - msg_prefix_size;
+}
