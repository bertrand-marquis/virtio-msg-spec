 hw/core/sysbus-fdt.c                          |   2 +
 hw/virtio/meson.build                         |   6 +-
 hw/virtio/virtio-msg-linux-bridge-transport.c | 190 ++++++++++++++++++
 4 files changed, 199 insertions(+), 2 deletions(-)
 create mode 100644 hw/virtio/virtio-msg-linux-bridge-transport.c

