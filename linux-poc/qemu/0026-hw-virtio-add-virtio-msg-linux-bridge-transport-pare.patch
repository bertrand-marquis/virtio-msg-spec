diff --git a/hw/virtio/virtio-msg-linux-bridge-transport.c b/hw/virtio/virtio-msg-linux-bridge-transport.c
new file mode 100644
index 000000000000..d7abd6dc603a
--- /dev/null
+++ b/hw/virtio/virtio-msg-linux-bridge-transport.c
@@ -0,0 +1,190 @@
+/*
+ * Virtio-msg Linux bridge transport composite device.
+ *
+ * Copyright (c) 2026 Arm Limited or its affiliates. All rights reserved.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "hw/virtio/virtio-msg.h"
+
+#define TYPE_VIRTIO_MSG_LINUX_BRIDGE "virtio-msg-linux-bridge"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtIOMSGLinuxBridgeTransport,
+                           VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT)
+
+#define VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_BRIDGE_CHILD "bridge"
+
+typedef struct VirtIOMSGLinuxBridgeTransport {
+    SysBusDevice parent_obj;
+
+    BusState outer_bus;
+    VirtIOMSGProxy proxy;
+    DeviceState *bridge;
+} VirtIOMSGLinuxBridgeTransport;
+
+static void virtio_msg_linux_bridge_transport_add_bridge_aliases(
+    Object *obj, Object *bridge)
+{
+    static const char * const aliases[] = {
+        "endpoint",
+        "create-endpoint",
+        "devnode",
+        "tx-ring-entries",
+        "tx-ring-entry-size",
+        "rx-ring-entries",
+        "rx-ring-entry-size",
+    };
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(aliases); i++) {
+        object_property_add_alias(obj, aliases[i], bridge, aliases[i]);
+    }
+}
+
+static void virtio_msg_linux_bridge_transport_move_msg_bus_last(
+    VirtIOMSGLinuxBridgeTransport *s)
+{
+    DeviceState *proxy = DEVICE(&s->proxy);
+    BusState *bus;
+    BusState *last = NULL;
+
+    /*
+     * qdev unrealize walks child buses in list order. Keep proxy.msg_bus after
+     * the proxy's ordinary virtio child buses so transport children are torn
+     * down after the virtio device model has stopped using the message bus.
+     */
+    QLIST_REMOVE(&s->proxy.msg_bus, sibling);
+    QLIST_FOREACH(bus, &proxy->child_bus, sibling) {
+        last = bus;
+    }
+    assert(last);
+    QLIST_INSERT_AFTER(last, &s->proxy.msg_bus, sibling);
+}
+
+static void virtio_msg_linux_bridge_transport_add_bridge_child(
+    VirtIOMSGLinuxBridgeTransport *s)
+{
+    /*
+     * Keep the bridge off the transport instance, so device property
+     * introspection only sees the transport aliases from instance_init.
+     */
+    object_property_add_child(OBJECT(&s->proxy),
+                              VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_BRIDGE_CHILD,
+                              OBJECT(s->bridge));
+}
+
+static void virtio_msg_linux_bridge_transport_del_bridge_child(
+    VirtIOMSGLinuxBridgeTransport *s)
+{
+    /*
+     * Unparenting the proxy child also clears parent_bus if bridge realize
+     * failed after qdev_set_parent_bus(), or if the bridge is still realized.
+     */
+    object_unparent(OBJECT(s->bridge));
+}
+
+static void virtio_msg_linux_bridge_transport_realize(DeviceState *dev,
+                                                      Error **errp)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(dev);
+    Object *obj = OBJECT(dev);
+    g_autofree char *endpoint = NULL;
+
+    endpoint = object_property_get_str(OBJECT(s->bridge), "endpoint", errp);
+    if (!endpoint) {
+        return;
+    }
+
+    if (!endpoint[0]) {
+        error_setg(errp, "endpoint is required and must not be empty");
+        return;
+    }
+
+    if (!object_property_set_uint(OBJECT(s->bridge), "vmm-max-msg-size",
+                                  VIRTIO_MSG_MAX_SIZE, errp)) {
+        return;
+    }
+
+    qbus_init(&s->outer_bus, sizeof(s->outer_bus),
+              TYPE_VIRTIO_MSG_OUTER_BUS, dev, "bus");
+
+    object_initialize_child(obj, "virtio-msg", &s->proxy, TYPE_VIRTIO_MSG);
+    if (!qdev_realize(DEVICE(&s->proxy), BUS(&s->outer_bus), errp)) {
+        return;
+    }
+
+    virtio_msg_linux_bridge_transport_add_bridge_child(s);
+    if (!qdev_realize(s->bridge, &s->proxy.msg_bus, errp)) {
+        virtio_msg_linux_bridge_transport_del_bridge_child(s);
+        qdev_unrealize(DEVICE(&s->proxy));
+        return;
+    }
+
+    virtio_msg_linux_bridge_transport_move_msg_bus_last(s);
+}
+
+static void virtio_msg_linux_bridge_transport_unrealize(DeviceState *dev)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(dev);
+
+    if (s->bridge) {
+        virtio_msg_linux_bridge_transport_del_bridge_child(s);
+    }
+
+    qdev_unrealize(DEVICE(&s->proxy));
+}
+
+static void virtio_msg_linux_bridge_transport_finalize(Object *obj)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(obj);
+
+    if (s->bridge) {
+        virtio_msg_linux_bridge_transport_del_bridge_child(s);
+        object_unref(OBJECT(s->bridge));
+        s->bridge = NULL;
+    }
+}
+
+static void virtio_msg_linux_bridge_transport_init(Object *obj)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(obj);
+
+    s->bridge = qdev_new(TYPE_VIRTIO_MSG_LINUX_BRIDGE);
+    virtio_msg_linux_bridge_transport_add_bridge_aliases(
+        obj, OBJECT(s->bridge));
+}
+
+static void virtio_msg_linux_bridge_transport_class_init(ObjectClass *klass,
+                                                         const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "virtio-msg Linux bridge transport composite parent";
+    dc->user_creatable = true;
+    dc->realize = virtio_msg_linux_bridge_transport_realize;
+    dc->unrealize = virtio_msg_linux_bridge_transport_unrealize;
+}
+
+static const TypeInfo virtio_msg_linux_bridge_transport_type_info = {
+    .name = TYPE_VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VirtIOMSGLinuxBridgeTransport),
+    .instance_init = virtio_msg_linux_bridge_transport_init,
+    .instance_finalize = virtio_msg_linux_bridge_transport_finalize,
+    .class_init = virtio_msg_linux_bridge_transport_class_init,
+};
+
+static void virtio_msg_linux_bridge_transport_register_types(void)
+{
+    type_register_static(&virtio_msg_linux_bridge_transport_type_info);
+}
+
+type_init(virtio_msg_linux_bridge_transport_register_types)
-- 
