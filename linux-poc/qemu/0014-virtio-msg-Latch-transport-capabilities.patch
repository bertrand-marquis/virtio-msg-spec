--- a/include/hw/virtio/virtio-msg-prot.h
+++ b/include/hw/virtio/virtio-msg-prot.h
@@ -46,6 +46,7 @@ enum {
     VIRTIO_MSG_MAX = VIRTIO_MSG_EVENT_USED,
 };
 
