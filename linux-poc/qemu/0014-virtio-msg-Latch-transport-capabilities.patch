 /* This is reusing the VirtioBusState typedef from TYPE_VIRTIO_BUS */
@@ -50,7 +53,13 @@ struct VirtIOMSGProxy {
     BusState devs_bus[VIRTIO_MSG_MAX_DEVS];
     VirtIOMSGDev devs[VIRTIO_MSG_MAX_DEVS];
 
