-    uint16_t req_offset = msg->bus_get_devices.offset;
-    uint16_t offset = MIN(req_offset, VIRTIO_MSG_MAX_DEVS);
-    uint16_t max_window = VIRTIO_MSG_MAX_DEVS - offset;
-    uint16_t num = MIN(msg->bus_get_devices.num, max_window);
-    uint16_t next_offset = offset + num;
+    uint16_t offset = msg->bus_get_devices.offset;
+    uint16_t num = msg->bus_get_devices.num;
+    uint16_t next_offset = 0;
     int i;
 
+    if ((offset & (VIRTIO_MSG_GET_DEVICES_ALIGN - 1)) ||
+        (num & (VIRTIO_MSG_GET_DEVICES_ALIGN - 1))) {
+        offset = 0;
+        num = 0;
+        goto out;
+    }
+
+    if (offset < VIRTIO_MSG_MAX_DEVS) {
+        uint16_t max_window = VIRTIO_MSG_MAX_DEVS - offset;
+
+        num = MIN(num, max_window);
+        if (offset + num < VIRTIO_MSG_MAX_DEVS) {
+            next_offset = offset + num;
+        }
+    } else {
+        num = 0;
+    }
+
     for (i = 0; i < num; i++) {
-        uint16_t dev_idx = offset + i;
-        VirtIODevice *vdev = virtio_msg_vdev(s, dev_idx);
+        uint16_t dev_num = offset + i;
+        VirtIODevice *vdev = virtio_msg_vdev(s, dev_num);
 
         if (vdev) {
             data[i / 8] |= 1U << (i & 7);
         }
     }
 
