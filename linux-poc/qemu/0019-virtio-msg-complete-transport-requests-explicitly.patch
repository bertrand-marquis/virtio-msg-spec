     switch (msg->msg_id) {
@@ -70,6 +82,9 @@ static bool virtio_msg_bad(VirtIOMSGProxy *s, VirtIOMSG *msg)
     case VIRTIO_MSG_RESET_VQUEUE:
         min_size += sizeof msg->reset_vqueue;
         break;
+    case VIRTIO_MSG_GET_SHM:
+        min_size += sizeof msg->get_shm;
+        break;
     case VIRTIO_MSG_EVENT_AVAIL:
         min_size += sizeof msg->event_avail;
         break;
@@ -85,7 +100,7 @@ static bool virtio_msg_bad(VirtIOMSGProxy *s, VirtIOMSG *msg)
         return true;
     }
 
-    if (msg->dev_num >= ARRAY_SIZE(s->devs)) {
+    if (!virtio_msg_dev_num_to_slot(s, msg->dev_num, &slot)) {
         return true;
     }
 
@@ -94,23 +109,39 @@ static bool virtio_msg_bad(VirtIOMSGProxy *s, VirtIOMSG *msg)
 
 static VirtIODevice *virtio_msg_vdev(VirtIOMSGProxy *s, uint16_t dev_num)
 {
-    VirtIODevice *vdev;
+    uint16_t slot;
+
+    if (!virtio_msg_dev_num_to_slot(s, dev_num, &slot)) {
+        return NULL;
+    }
 
-    vdev = virtio_bus_get_device(&s->devs[dev_num].bus);
-    return vdev;
+    return virtio_bus_get_device(&s->devs[slot].bus);
