diff --git a/hw/virtio/virtio-msg-linux-bridge-transport.c b/hw/virtio/virtio-msg-linux-bridge-transport.c
new file mode 100644
index 000000000000..64f210f3088e
--- /dev/null
+++ b/hw/virtio/virtio-msg-linux-bridge-transport.c
@@ -0,0 +1,203 @@
+/*
+ * Virtio-msg Linux bridge transport composite device.
+ *
+ * Copyright (c) 2026 Arm Limited or its affiliates. All rights reserved.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/virtio/virtio-msg.h"
+
+#define TYPE_VIRTIO_MSG_LINUX_BRIDGE "virtio-msg-linux-bridge"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtIOMSGLinuxBridgeTransport,
+                           VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT)
+
+#define VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_VMM_MAX_MSG_SIZE_DEFAULT \
+    VIRTIO_MSG_MAX_SIZE
+#define VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_RING_ENTRY_SIZE_DEFAULT \
+    VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_VMM_MAX_MSG_SIZE_DEFAULT
+#define VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_RING_ENTRIES_DEFAULT 256U
+
+typedef struct VirtIOMSGLinuxBridgeTransport {
+    SysBusDevice parent_obj;
+
+    BusState outer_bus;
+    VirtIOMSGProxy proxy;
+    DeviceState *bridge;
+
+    char *endpoint;
+    bool create_endpoint;
+    char *devnode;
+    uint32_t tx_ring_entries;
+    uint32_t tx_ring_entry_size;
+    uint32_t rx_ring_entries;
+    uint32_t rx_ring_entry_size;
+} VirtIOMSGLinuxBridgeTransport;
+
+static bool virtio_msg_linux_bridge_transport_set_bridge_props(
+    VirtIOMSGLinuxBridgeTransport *s, DeviceState *bridge, Error **errp)
+{
+    if (!object_property_set_str(OBJECT(bridge), "endpoint",
+                                 s->endpoint, errp)) {
+        return false;
+    }
+
+    if (!object_property_set_bool(OBJECT(bridge), "create-endpoint",
+                                  s->create_endpoint, errp)) {
+        return false;
+    }
+
+    if (s->devnode &&
+        !object_property_set_str(OBJECT(bridge), "devnode", s->devnode, errp)) {
+        return false;
+    }
+
+    if (!object_property_set_uint(OBJECT(bridge), "tx-ring-entries",
+                                  s->tx_ring_entries, errp)) {
+        return false;
+    }
+
+    if (!object_property_set_uint(OBJECT(bridge), "tx-ring-entry-size",
+                                  s->tx_ring_entry_size, errp)) {
+        return false;
+    }
+
+    if (!object_property_set_uint(OBJECT(bridge), "rx-ring-entries",
+                                  s->rx_ring_entries, errp)) {
+        return false;
+    }
+
+    if (!object_property_set_uint(OBJECT(bridge), "rx-ring-entry-size",
+                                  s->rx_ring_entry_size, errp)) {
+        return false;
+    }
+
+    if (!object_property_set_uint(
+            OBJECT(bridge), "vmm-max-msg-size",
+            VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_VMM_MAX_MSG_SIZE_DEFAULT,
+            errp)) {
+        return false;
+    }
+
+    return true;
+}
+
+static void virtio_msg_linux_bridge_transport_realize(DeviceState *dev,
+                                                      Error **errp)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(dev);
+    Object *obj = OBJECT(dev);
+    DeviceState *bridge;
+
+    if (!s->endpoint || !s->endpoint[0]) {
+        error_setg(errp, "endpoint is required and must not be empty");
+        return;
+    }
+
+    qbus_init(&s->outer_bus, sizeof(s->outer_bus),
+              TYPE_VIRTIO_MSG_OUTER_BUS, dev, "bus");
+
+    object_initialize_child(obj, "virtio-msg", &s->proxy, TYPE_VIRTIO_MSG);
+    if (!qdev_realize(DEVICE(&s->proxy), BUS(&s->outer_bus), errp)) {
+        return;
+    }
+
+    bridge = qdev_new(TYPE_VIRTIO_MSG_LINUX_BRIDGE);
+    if (!virtio_msg_linux_bridge_transport_set_bridge_props(s, bridge, errp)) {
+        object_unref(OBJECT(bridge));
+        qdev_unrealize(DEVICE(&s->proxy));
+        return;
+    }
+
+    if (!qdev_realize(bridge, &s->proxy.msg_bus, errp)) {
+        object_unref(OBJECT(bridge));
+        qdev_unrealize(DEVICE(&s->proxy));
+        return;
+    }
+
+    s->bridge = bridge;
+}
+
+static void virtio_msg_linux_bridge_transport_unrealize(DeviceState *dev)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(dev);
+
+    if (s->bridge) {
+        qdev_unrealize(s->bridge);
+        object_unref(OBJECT(s->bridge));
+        s->bridge = NULL;
+    }
+
+    qdev_unrealize(DEVICE(&s->proxy));
+}
+
+static const Property virtio_msg_linux_bridge_transport_properties[] = {
+    DEFINE_PROP_STRING("endpoint", VirtIOMSGLinuxBridgeTransport, endpoint),
+    DEFINE_PROP_BOOL("create-endpoint", VirtIOMSGLinuxBridgeTransport,
+                     create_endpoint, false),
+    DEFINE_PROP_STRING("devnode", VirtIOMSGLinuxBridgeTransport, devnode),
+    DEFINE_PROP_UINT32("tx-ring-entries", VirtIOMSGLinuxBridgeTransport,
+                       tx_ring_entries,
+                       VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_RING_ENTRIES_DEFAULT),
+    DEFINE_PROP_UINT32("tx-ring-entry-size", VirtIOMSGLinuxBridgeTransport,
+                       tx_ring_entry_size,
+                    VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_RING_ENTRY_SIZE_DEFAULT),
+    DEFINE_PROP_UINT32("rx-ring-entries", VirtIOMSGLinuxBridgeTransport,
+                       rx_ring_entries,
+                       VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_RING_ENTRIES_DEFAULT),
+    DEFINE_PROP_UINT32("rx-ring-entry-size", VirtIOMSGLinuxBridgeTransport,
+                       rx_ring_entry_size,
+                    VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT_RING_ENTRY_SIZE_DEFAULT),
+};
+
+static void virtio_msg_linux_bridge_transport_finalize(Object *obj)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(obj);
+
+    g_free(s->endpoint);
+    g_free(s->devnode);
+}
+
+static void virtio_msg_linux_bridge_transport_init(Object *obj)
+{
+    VirtIOMSGLinuxBridgeTransport *s =
+        VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT(obj);
+
+    s->bridge = NULL;
+}
+
+static void virtio_msg_linux_bridge_transport_class_init(ObjectClass *klass,
+                                                         const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_props(dc, virtio_msg_linux_bridge_transport_properties);
+    dc->desc = "virtio-msg Linux bridge transport composite parent";
+    dc->user_creatable = true;
+    dc->realize = virtio_msg_linux_bridge_transport_realize;
+    dc->unrealize = virtio_msg_linux_bridge_transport_unrealize;
+}
+
+static const TypeInfo virtio_msg_linux_bridge_transport_type_info = {
+    .name = TYPE_VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(VirtIOMSGLinuxBridgeTransport),
+    .instance_init = virtio_msg_linux_bridge_transport_init,
+    .instance_finalize = virtio_msg_linux_bridge_transport_finalize,
+    .class_init = virtio_msg_linux_bridge_transport_class_init,
+};
+
+static void virtio_msg_linux_bridge_transport_register_types(void)
+{
+    type_register_static(&virtio_msg_linux_bridge_transport_type_info);
+}
+
+type_init(virtio_msg_linux_bridge_transport_register_types)
