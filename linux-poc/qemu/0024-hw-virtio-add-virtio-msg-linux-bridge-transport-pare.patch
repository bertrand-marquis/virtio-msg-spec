 #define TYPE_VIRTIO_MSG "virtio-msg"
 OBJECT_DECLARE_SIMPLE_TYPE(VirtIOMSGProxy, VIRTIO_MSG)
 
+#define TYPE_VIRTIO_MSG_LINUX_BRIDGE_TRANSPORT \
+    "virtio-msg-linux-bridge-transport"
