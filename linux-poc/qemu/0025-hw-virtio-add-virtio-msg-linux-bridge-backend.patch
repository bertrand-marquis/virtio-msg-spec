+static void virtio_msg_linux_bridge_drain_callfd(VirtIOMSGLinuxBridge *s)
+{
+    if (s->call_initialized) {
+        event_notifier_test_and_clear(&s->call);
+    }
+}
+
+static VirtIOMSGLinuxBridgeCapsValidationResult
+virtio_msg_linux_bridge_validate_caps_common(uint32_t revision,
+                                             uint32_t max_msg_size,
+                                             uint32_t *validated_max_msg_size)
+{
+    uint32_t normalized_max_msg_size = max_msg_size;
+
+    if (!normalized_max_msg_size) {
+        normalized_max_msg_size = VIRTIO_MSG_MAX_SIZE;
+    }
+
+    *validated_max_msg_size = normalized_max_msg_size;
+
+    if (revision != VIRTIO_MSG_LINUX_BRIDGE_REVISION_SUPPORTED) {
+        return VIRTIO_MSG_LINUX_BRIDGE_CAPS_VALIDATION_BAD_REVISION;
+    }
+
+    if (normalized_max_msg_size < bridge_local_min_msg_size() ||
+        normalized_max_msg_size > VIRTIO_MSG_MAX_SIZE) {
+        return VIRTIO_MSG_LINUX_BRIDGE_CAPS_VALIDATION_BAD_MAX_MSG_SIZE;
+    }
+
+    return VIRTIO_MSG_LINUX_BRIDGE_CAPS_VALIDATION_OK;
+}
+
+static bool virtio_msg_linux_bridge_validate_online_max_msg_size(
+    uint32_t max_msg_size, uint32_t *validated_max_msg_size)
+{
+    uint32_t normalized_max_msg_size = max_msg_size;
+
+    if (!normalized_max_msg_size) {
+        normalized_max_msg_size = VIRTIO_MSG_MAX_SIZE;
+    }
+
+    *validated_max_msg_size = normalized_max_msg_size;
+    return normalized_max_msg_size >= bridge_local_min_msg_size() &&
+        normalized_max_msg_size <= VIRTIO_MSG_MAX_SIZE;
+}
+
+static void virtio_msg_linux_bridge_apply_caps_common(
+    VirtIOMSGLinuxBridge *s,
+    uint32_t revision,
+    uint32_t max_msg_size,
+    uint64_t transport_features,
+    uint64_t bridge_features)
+{
+    s->caps.revision = revision;
+    s->caps.max_msg_size = max_msg_size;
+    s->caps.transport_features =
+        virtio_msg_linux_bridge_transport_features_effective(
+            transport_features);
+    s->caps.bridge_features = bridge_features;
+}
+
+static bool virtio_msg_linux_bridge_refresh_proxy_transport_caps(
+    VirtIOMSGLinuxBridge *s, Error **errp)
+{
+    VirtIOMSGProxy *proxy = virtio_msg_linux_bridge_get_proxy(s);
+
+    if (!proxy) {
+        error_setg(errp, "virtio-msg Linux bridge has no proxy");
+        return false;
+    }
+
+    return virtio_msg_refresh_transport_caps(proxy, errp);
+}
+
+static bool virtio_msg_linux_bridge_lifecycle_epoch_stale(
+    VirtIOMSGLinuxBridge *s, uint64_t msg_epoch)
+{
+    bool stale = s->caps.online_epoch != 0 ?
+        msg_epoch < s->caps.online_epoch :
+        msg_epoch != 0 && msg_epoch <= s->last_online_epoch;
+
+    if (stale) {
+        trace_virtio_msg_linux_bridge_lifecycle(
+            s->endpoint_handle, "stale-lifecycle", s->session_state,
+            msg_epoch, s->last_online_epoch);
+        return true;
+    }
+
+    return false;
+}
+
+static bool virtio_msg_linux_bridge_epoch_is_future(
+    VirtIOMSGLinuxBridge *s, uint64_t msg_epoch)
+{
+    if (msg_epoch > s->caps.online_epoch) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "future bridge-local epoch=%" PRIu64
+            " current=%" PRIu64 " last=%" PRIu64,
+            msg_epoch, (uint64_t)s->caps.online_epoch,
+            s->last_online_epoch);
+        virtio_msg_linux_bridge_fail_attach(s);
+        return true;
+    }
+
+    return false;
+}
+
+static bool virtio_msg_linux_bridge_enter_online(
+    VirtIOMSGLinuxBridge *s, uint64_t online_epoch, const char *bus_name,
+    uint32_t max_msg_size, Error **errp)
+{
+    uint32_t validated_max_msg_size;
+
+    if (online_epoch == 0) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR("ENDPOINT_ONLINE epoch is zero");
+        virtio_msg_linux_bridge_fail_attach(s);
+        return false;
+    }
+
+    if (!virtio_msg_linux_bridge_validate_online_max_msg_size(
+            max_msg_size, &validated_max_msg_size)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "ENDPOINT_ONLINE unsupported max_msg_size=%u supported=%u..%u",
+            validated_max_msg_size,
+            (unsigned int)bridge_local_min_msg_size(),
+            (unsigned int)VIRTIO_MSG_MAX_SIZE);
+        virtio_msg_linux_bridge_fail_attach(s);
+        return false;
+    }
+
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_enter_online(
+            s, online_epoch, bus_name, max_msg_size);
+        return true;
+    }
+
+    virtio_msg_linux_bridge_clear_pending_tx(s);
+    virtio_msg_linux_bridge_clear_rx_bridge_error(s);
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    virtio_msg_linux_bridge_unmap_all(s);
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_enter_online(
+            s, online_epoch, bus_name, max_msg_size);
+        return true;
+    }
+
+    s->caps.online_epoch = online_epoch;
+    s->last_online_epoch = online_epoch;
+    memcpy(s->endpoint_addr.bus_name, bus_name,
+           sizeof(s->endpoint_addr.bus_name));
+    s->endpoint_addr.bus_name[VMSG_BRIDGE_UAPI_BUS_NAME_LEN - 1] = '\0';
+    s->endpoint_max_msg_size = validated_max_msg_size;
+    s->caps.max_msg_size = virtio_msg_linux_bridge_max_msg_size(s);
+    virtio_msg_linux_bridge_latch_transport_caps(s);
+    if (!virtio_msg_linux_bridge_refresh_proxy_transport_caps(s, errp)) {
+        virtio_msg_linux_bridge_fail_attach(s);
+        return false;
+    }
+    virtio_msg_linux_bridge_set_state(
+        s,
+        VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_NEEDS_TOPOLOGY);
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "endpoint-online", s->session_state,
+        online_epoch, s->endpoint_max_msg_size);
+    return virtio_msg_linux_bridge_maybe_publish_topology(s, errp);
+}
+
+static bool virtio_msg_linux_bridge_handle_endpoint_online(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSG *msg)
+{
+    const struct virtio_msg_bus_bridge_endpoint_online *online =
+        (const void *)msg->payload_u8;
+    uint64_t online_epoch = le64_to_cpu(online->online_epoch);
+    Error *local_err = NULL;
+
+    if (online_epoch <= s->last_online_epoch) {
+        trace_virtio_msg_linux_bridge_lifecycle(
+            s->endpoint_handle, "stale-endpoint-online", s->session_state,
+            online_epoch, s->last_online_epoch);
+        return true;
+    }
+
+    if (s->caps.online_epoch != 0 &&
+        virtio_msg_linux_bridge_epoch_is_future(s, online_epoch)) {
+        return false;
+    }
+
+    if (!virtio_msg_linux_bridge_enter_online(
+            s, online_epoch, online->bus_name,
+            le32_to_cpu(online->max_msg_size), &local_err)) {
+        if (local_err) {
+            error_report_err(local_err);
+        }
+        return false;
+    }
+
+    return true;
+}
+
+static void virtio_msg_linux_bridge_complete_endpoint_offline(
+    VirtIOMSGLinuxBridge *s, uint64_t online_epoch, uint32_t reason)
+{
+    virtio_msg_linux_bridge_clear_pending_tx(s);
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    virtio_msg_linux_bridge_unmap_all(s);
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_endpoint_offline(
+            s, online_epoch, reason);
+        return;
+    }
+
+    virtio_msg_linux_bridge_set_state(
+        s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_OFFLINE);
+    s->caps.online_epoch = 0;
+    s->endpoint_max_msg_size = 0;
+    virtio_msg_linux_bridge_mark_transport_offline(s);
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "endpoint-offline", s->session_state,
+        online_epoch, reason);
+    virtio_msg_linux_bridge_reset_devices(s);
+}
+
+static bool virtio_msg_linux_bridge_handle_endpoint_offline(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSG *msg)
+{
+    const struct virtio_msg_bus_bridge_endpoint_offline *offline =
+        (const void *)msg->payload_u8;
+    uint64_t online_epoch = le64_to_cpu(offline->online_epoch);
+    uint32_t reason = le32_to_cpu(offline->reason);
+
+    if (virtio_msg_linux_bridge_lifecycle_epoch_stale(s, online_epoch)) {
+        return true;
+    }
+
+    if (virtio_msg_linux_bridge_epoch_is_future(s, online_epoch)) {
+        return false;
+    }
+
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_endpoint_offline(s, online_epoch,
+                                                       reason);
+        return true;
+    }
+
+    virtio_msg_linux_bridge_complete_endpoint_offline(s, online_epoch, reason);
+    return true;
+}
+
+typedef enum VirtIOMSGLinuxBridgeRxResult {
+    VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED,
+    VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED_STOP,
+    VIRTIO_MSG_LINUX_BRIDGE_RX_RETRY,
+    VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED,
+} VirtIOMSGLinuxBridgeRxResult;
+
+static void virtio_msg_linux_bridge_drain_after_delayed_map_response(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (s->map_add_deferred ||
+        virtio_msg_linux_bridge_has_pending_failed_map_add_resp(s)) {
+        return;
+    }
+
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, true);
+    }
+    virtio_msg_linux_bridge_process_rx_ring(s, false);
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, true);
+    }
+}
+
+static VirtIOMSGLinuxBridgeRxResult
+virtio_msg_linux_bridge_send_map_add_resp(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSG msg = { 0 };
+    int ret;
+
+    virtio_msg_linux_bridge_pack_map_add_resp(
+        &msg, event->token, event->epoch, event->map_seq,
+        event->map_id, event->status);
+    trace_virtio_msg_linux_bridge_map_add_resp_tx(
+        s->endpoint_handle, event->epoch, event->token,
+        event->map_seq, event->map_id, event->status);
+
+    ret = virtio_msg_linux_bridge_send_bridge_local_must_deliver(s, &msg);
+    if (ret != VIRTIO_MSG_NO_ERROR) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD response failed token=%u map_seq=%" PRIu64
+            " map_id=%" PRIu64 " status=%d: %s",
+            event->token, event->map_seq, event->map_id, event->status,
+            virtio_msg_linux_bridge_result_to_str(ret));
+        virtio_msg_linux_bridge_fail_attach(s);
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+    }
+
+    if (!virtio_msg_linux_bridge_map_status_is_failure(event)) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+    }
+
+    if (virtio_msg_linux_bridge_has_pending_failed_map_add_resp(s)) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED_STOP;
+    }
+
+    VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+        "MAP_ADD failure response accepted token=%u map_seq=%" PRIu64
+        " map_id=%" PRIu64 " status=%d; entering ATTACHED_FAILED",
+        event->token, event->map_seq, event->map_id, event->status);
+    virtio_msg_linux_bridge_fail_attach(s);
+    return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+}
+
+static bool virtio_msg_linux_bridge_send_map_del_resp(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSG msg = { 0 };
+    int ret;
+
+    virtio_msg_linux_bridge_pack_map_del_resp(
+        &msg, event->token, event->epoch, event->map_seq,
+        event->map_id, event->status);
+    trace_virtio_msg_linux_bridge_map_del_resp_tx(
+        s->endpoint_handle, event->epoch, event->token,
+        event->map_seq, event->map_id, event->status);
+
+    ret = virtio_msg_linux_bridge_send_bridge_local_must_deliver(s, &msg);
+    if (ret == VIRTIO_MSG_NO_ERROR) {
+        return true;
+    }
+
+    VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+        "MAP_DEL response failed token=%u map_seq=%" PRIu64
+        " map_id=%" PRIu64 " status=%d: %s",
+        event->token, event->map_seq, event->map_id, event->status,
+        virtio_msg_linux_bridge_result_to_str(ret));
+    virtio_msg_linux_bridge_fail_attach(s);
+    return false;
+}
+
+static bool virtio_msg_linux_bridge_send_map_released(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSG msg = { 0 };
+    int ret;
+
+    virtio_msg_linux_bridge_pack_map_released(
+        &msg, event->epoch, event->map_seq, event->map_id,
+        event->bus_addr, event->length);
+    trace_virtio_msg_linux_bridge_map_released_tx(
+        s->endpoint_handle, event->epoch, event->map_seq, event->map_id,
+        event->bus_addr, event->length);
+
+    ret = virtio_msg_linux_bridge_send_bridge_local_must_deliver(s, &msg);
+    if (ret == VIRTIO_MSG_NO_ERROR) {
+        return true;
+    }
+
+    VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+        "MAP_RELEASED failed map_seq=%" PRIu64 " map_id=%" PRIu64
+        ": %s",
+        event->map_seq, event->map_id,
+        virtio_msg_linux_bridge_result_to_str(ret));
+    virtio_msg_linux_bridge_fail_attach(s);
+    return false;
+}
+
+static void virtio_msg_linux_bridge_map_add_defer_timer_cb(void *opaque)
+{
+    VirtIOMSGLinuxBridge *s = opaque;
+    VirtIOMSGLinuxBridgeMapEvent event;
+    VirtIOMSGLinuxBridgeRxResult rx_result;
+
+    if (!s->map_add_deferred) {
+        virtio_msg_linux_bridge_clear_map_add_defer(s);
+        return;
+    }
+
+    event = s->map_add_deferred_event;
+    if (!virtio_msg_linux_bridge_handle_map_event_add(s, &event)) {
+        return;
+    }
+
+    rx_result = virtio_msg_linux_bridge_send_map_add_resp(s, &event);
+    if (rx_result == VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED) {
+        virtio_msg_linux_bridge_drain_after_delayed_map_response(s);
+    }
+}
+
+static void virtio_msg_linux_bridge_map_completion_bh(void *opaque)
+{
+    VirtIOMSGLinuxBridge *s = opaque;
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+    VirtIOMSGLinuxBridgeMapEntry *next;
+    VirtIOMSGLinuxBridgeMapEvent event;
+
+again:
+    qemu_mutex_lock(&s->map_lock);
+    s->map_completion_bh_scheduled = false;
+
+    QTAILQ_FOREACH_SAFE(entry, &s->map_entries, node, next) {
+        if (!entry->release_requested) {
+            continue;
+        }
+
+        if (!virtio_msg_linux_bridge_prepare_release_event_locked(
+                s, entry, &event)) {
+            entry->release_requested = false;
+            qemu_mutex_unlock(&s->map_lock);
+            virtio_msg_linux_bridge_fail_attach(s);
+            return;
+        }
+
+        qemu_mutex_unlock(&s->map_lock);
+        object_unref(OBJECT(entry));
+        goto again;
+    }
+    qemu_mutex_unlock(&s->map_lock);
+    virtio_msg_linux_bridge_maybe_complete_deferred_cleanup(s);
+}
+
+static void virtio_msg_linux_bridge_map_reclaim_bh(void *opaque)
+{
+    VirtIOMSGLinuxBridge *s = opaque;
+
+    qemu_mutex_lock(&s->map_lock);
+    s->map_reclaim_bh_scheduled = false;
+    qemu_mutex_unlock(&s->map_lock);
+
+    if (!qatomic_read(&s->non_retained_live_count)) {
+        return;
+    }
+
+    virtio_msg_linux_bridge_reclaim_non_retained_maps(s);
+}
+
+static bool virtio_msg_linux_bridge_rx_bridge_local_allowed(
+    const VirtIOMSG *msg)
+{
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_ONLINE:
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_OFFLINE:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_ADD:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_DEL:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool virtio_msg_linux_bridge_rx_bridge_local_valid(
+    const VirtIOMSG *msg, uint16_t msg_size)
+{
+    size_t payload_size;
+
+    if ((msg->type & VIRTIO_MSG_TYPE_MASK) != VIRTIO_MSG_TYPE_BUS ||
+        le16_to_cpu(msg->dev_num) != 0) {
+        return false;
+    }
+
+    if (msg->msg_id == VIRTIO_MSG_BUS_BRIDGE_MAP_ADD ||
+        msg->msg_id == VIRTIO_MSG_BUS_BRIDGE_MAP_DEL) {
+        if (le16_to_cpu(msg->token) == 0) {
+            return false;
+        }
+    } else if (le16_to_cpu(msg->token) != 0) {
+        return false;
+    }
+
+    if (!virtio_msg_linux_bridge_rx_bridge_local_allowed(msg)) {
+        return false;
+    }
+
+    payload_size = virtio_msg_linux_bridge_bridge_local_payload_size(msg);
+    return msg_size == virtio_msg_header_size() + payload_size;
+}
+
+static bool virtio_msg_linux_bridge_map_epoch_valid(
+    VirtIOMSGLinuxBridge *s, uint64_t epoch, bool *stale)
+{
+    *stale = false;
+    if ((s->caps.online_epoch != 0 && epoch < s->caps.online_epoch) ||
+        (s->caps.online_epoch == 0 && epoch != 0 &&
+         epoch <= s->last_online_epoch)) {
+        trace_virtio_msg_linux_bridge_map_event_stale(
+            s->endpoint_handle, epoch, s->caps.online_epoch,
+            s->last_online_epoch);
+        *stale = true;
+        return true;
+    }
+
+    return !virtio_msg_linux_bridge_epoch_is_future(s, epoch);
+}
+
+static VirtIOMSGLinuxBridgeRxResult
+virtio_msg_linux_bridge_handle_map_add_msg(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSG *msg)
+{
+    const struct virtio_msg_bus_bridge_map_add_req *payload =
+        (const void *)msg->payload_u8;
+    VirtIOMSGLinuxBridgeMapEvent event = {
+        .token = le16_to_cpu(msg->token),
+        .map_seq = le64_to_cpu(payload->map_seq),
+        .map_id = le64_to_cpu(payload->map_id),
+        .epoch = le64_to_cpu(payload->online_epoch),
+        .bus_addr = le64_to_cpu(payload->bus_addr),
+        .length = le64_to_cpu(payload->length),
+        .mmap_offset = le64_to_cpu(payload->mmap_offset),
+        .mmap_length = le64_to_cpu(payload->mmap_length),
+        .flags = le32_to_cpu(payload->flags),
+        .retain_hint = le32_to_cpu(payload->flags) &
+                       VIRTIO_MSG_BUS_BRIDGE_MAP_F_RETENTION_REQUESTED,
+    };
+    uint32_t reserved = le32_to_cpu(payload->reserved);
+    bool stale;
+
+    if (!virtio_msg_linux_bridge_map_epoch_valid(s, event.epoch, &stale)) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+    }
+    if (stale) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+    }
+    if (!virtio_msg_linux_bridge_state_allows_map(s)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD while endpoint=%u state=%d is not active",
+            s->endpoint_handle, s->session_state);
+        virtio_msg_linux_bridge_fail_attach(s);
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+    }
+
+    if (!event.map_seq || !event.map_id) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD invalid identity map_seq=%" PRIu64
+            " map_id=%" PRIu64,
+            event.map_seq, event.map_id);
+        event.status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_add(s, &event);
+        return virtio_msg_linux_bridge_send_map_add_resp(s, &event);
+    }
+
+    if (event.flags & ~VIRTIO_MSG_BUS_BRIDGE_MAP_F_RETENTION_REQUESTED) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD unsupported flags map_seq=%" PRIu64 " flags=0x%x",
+            event.map_seq, event.flags);
+        event.status = -EOPNOTSUPP;
+        virtio_msg_linux_bridge_trace_map_add(s, &event);
+        return virtio_msg_linux_bridge_send_map_add_resp(s, &event);
+    }
+
+    if (reserved) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD nonzero reserved map_seq=%" PRIu64 " reserved=0x%x",
+            event.map_seq, reserved);
+        event.status = -EPROTO;
+        virtio_msg_linux_bridge_trace_map_add(s, &event);
+        return virtio_msg_linux_bridge_send_map_add_resp(s, &event);
+    }
+
+    if (!virtio_msg_linux_bridge_handle_map_event_add(s, &event)) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED_STOP;
+    }
+
+    return virtio_msg_linux_bridge_send_map_add_resp(s, &event);
+}
+
+static VirtIOMSGLinuxBridgeRxResult
+virtio_msg_linux_bridge_handle_map_del_msg(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSG *msg)
+{
+    const struct virtio_msg_bus_bridge_map_del_req *payload =
+        (const void *)msg->payload_u8;
+    VirtIOMSGLinuxBridgeMapEvent event = {
+        .token = le16_to_cpu(msg->token),
+        .map_seq = le64_to_cpu(payload->map_seq),
+        .map_id = le64_to_cpu(payload->map_id),
+        .epoch = le64_to_cpu(payload->online_epoch),
+        .bus_addr = le64_to_cpu(payload->bus_addr),
+        .length = le64_to_cpu(payload->length),
+    };
+    uint64_t reserved = le64_to_cpu(payload->reserved);
+    bool stale;
+
+    if (!virtio_msg_linux_bridge_map_epoch_valid(s, event.epoch, &stale)) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+    }
+    if (stale) {
+        if (virtio_msg_linux_bridge_state_allows_map(s) &&
+            event.map_seq && event.map_id && !reserved) {
+            bool retired;
+
+            qemu_mutex_lock(&s->map_lock);
+            retired = virtio_msg_linux_bridge_retire_tombstone_locked(s,
+                                                                      &event);
+            qemu_mutex_unlock(&s->map_lock);
+            if (retired &&
+                !virtio_msg_linux_bridge_send_map_del_resp(s, &event)) {
+                return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+            }
+        }
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+    }
+    if (!virtio_msg_linux_bridge_state_allows_map(s)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL while endpoint=%u state=%d is not active",
+            s->endpoint_handle, s->session_state);
+        virtio_msg_linux_bridge_fail_attach(s);
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+    }
+
+    if (!event.map_seq || !event.map_id) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL invalid identity map_seq=%" PRIu64
+            " map_id=%" PRIu64,
+            event.map_seq, event.map_id);
+        event.status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_del(s, &event);
+        if (!virtio_msg_linux_bridge_send_map_del_resp(s, &event)) {
+            return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+        }
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+    }
+
+    if (reserved) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL nonzero reserved map_seq=%" PRIu64
+            " reserved=0x%" PRIx64,
+            event.map_seq, reserved);
+        event.status = -EPROTO;
+        virtio_msg_linux_bridge_trace_map_del(s, &event);
+        if (!virtio_msg_linux_bridge_send_map_del_resp(s, &event)) {
+            return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+        }
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+    }
+
+    if (!virtio_msg_linux_bridge_handle_map_event_del(s, &event)) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED_STOP;
+    }
+
+    if (!virtio_msg_linux_bridge_send_map_del_resp(s, &event)) {
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+    }
+    return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+}
+
+static VirtIOMSGLinuxBridgeRxResult
+virtio_msg_linux_bridge_process_bridge_local_rx(VirtIOMSGLinuxBridge *s,
+                                                const VirtIOMSG *msg,
+                                                uint16_t msg_size)
+{
+    if (!virtio_msg_linux_bridge_rx_bridge_local_valid(msg, msg_size)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "malformed RX bridge-local msg=%s(0x%x) "
+            "type=0x%x dev=%u token=%u size=%u",
+            bridge_msg_id_to_str(msg->type, msg->msg_id),
+            msg->msg_id, msg->type, le16_to_cpu(msg->dev_num),
+            le16_to_cpu(msg->token), msg_size);
+        virtio_msg_linux_bridge_fail_attach(s);
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+    }
+
+    virtio_msg_linux_bridge_log_msg_summary(s, msg, true);
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_ONLINE:
+        if (!virtio_msg_linux_bridge_handle_endpoint_online(s, msg)) {
+            return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+        }
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_OFFLINE:
+        if (!virtio_msg_linux_bridge_handle_endpoint_offline(s, msg)) {
+            return VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED;
+        }
+        return VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED;
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_ADD:
+        if (s->map_add_deferred ||
+            virtio_msg_linux_bridge_has_pending_failed_map_add_resp(s)) {
+            return VIRTIO_MSG_LINUX_BRIDGE_RX_RETRY;
+        }
+        return virtio_msg_linux_bridge_handle_map_add_msg(s, msg);
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_DEL:
+        if (s->map_del_deferred) {
+            return VIRTIO_MSG_LINUX_BRIDGE_RX_RETRY;
+        }
+        return virtio_msg_linux_bridge_handle_map_del_msg(s, msg);
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static bool virtio_msg_linux_bridge_compute_ring_layout(VirtIOMSGLinuxBridge *s,
+                                                        Error **errp)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+    uint64_t tx_bytes;
+    uint64_t rx_bytes;
+    uint64_t rx_offset;
+    uint64_t total_size;
+
+    if (s->tx_ring_entries >
+        (UINT64_MAX - sizeof(struct vmsg_bridge_uapi_ring_hdr)) /
+        s->tx_ring_entry_size) {
+        error_setg(errp, "tx ring geometry overflows");
+        return false;
+    }
+
+    if (s->rx_ring_entries >
+        (UINT64_MAX - sizeof(struct vmsg_bridge_uapi_ring_hdr)) /
+        s->rx_ring_entry_size) {
+        error_setg(errp, "rx ring geometry overflows");
+        return false;
+    }
+
+    tx_bytes = sizeof(struct vmsg_bridge_uapi_ring_hdr) +
+               (uint64_t)s->tx_ring_entries * s->tx_ring_entry_size;
+    rx_bytes = sizeof(struct vmsg_bridge_uapi_ring_hdr) +
+               (uint64_t)s->rx_ring_entries * s->rx_ring_entry_size;
+
+    tx_bytes = QEMU_ALIGN_UP(tx_bytes, page_size);
+    rx_bytes = QEMU_ALIGN_UP(rx_bytes, page_size);
+    rx_offset = tx_bytes;
+
+    if (UINT64_MAX - rx_offset < rx_bytes) {
+        error_setg(errp, "ring backing size overflows");
+        return false;
+    }
+    total_size = rx_offset + rx_bytes;
+    if (total_size > SIZE_MAX) {
+        error_setg(errp, "ring backing is too large");
+        return false;
+    }
+
+    s->tx_ring_info.offset = 0;
+    s->tx_ring_info.bytes = tx_bytes;
+    s->tx_ring_info.entries = s->tx_ring_entries;
+    s->tx_ring_info.entry_size = s->tx_ring_entry_size;
+
+    s->rx_ring_info.offset = rx_offset;
+    s->rx_ring_info.bytes = rx_bytes;
+    s->rx_ring_info.entries = s->rx_ring_entries;
+    s->rx_ring_info.entry_size = s->rx_ring_entry_size;
+
+    s->rings_size = total_size;
+    return true;
+}
+
+static void virtio_msg_linux_bridge_init_ring(
+    void *rings, const struct vmsg_bridge_uapi_ring_info *ring)
+{
+    struct vmsg_bridge_uapi_ring_hdr *hdr = (void *)((uint8_t *)rings +
+                                                   ring->offset);
+
+    memset(hdr, 0, ring->bytes);
+    hdr->entries = ring->entries;
+    hdr->entry_size = ring->entry_size;
+}
+
+static bool virtio_msg_linux_bridge_setup_rings(VirtIOMSGLinuxBridge *s,
+                                                Error **errp)
+{
+    s->ring_fd = qemu_memfd_create("vmsg-bridge-rings", s->rings_size,
+                                   false, 0, 0, errp);
+    if (s->ring_fd < 0) {
+        return false;
+    }
+
+    s->rings = mmap(NULL, s->rings_size, PROT_READ | PROT_WRITE,
+                    MAP_SHARED, s->ring_fd, 0);
+    if (s->rings == MAP_FAILED) {
+        s->rings = NULL;
+        error_setg_errno(errp, errno, "failed to mmap rings");
+        return false;
+    }
+
+    virtio_msg_linux_bridge_init_ring(s->rings, &s->tx_ring_info);
+    virtio_msg_linux_bridge_init_ring(s->rings, &s->rx_ring_info);
+    return true;
+}
+
+static void virtio_msg_linux_bridge_reinit_rings(VirtIOMSGLinuxBridge *s)
+{
+    if (!s->rings) {
+        return;
+    }
+
+    virtio_msg_linux_bridge_init_ring(s->rings, &s->tx_ring_info);
+    virtio_msg_linux_bridge_init_ring(s->rings, &s->rx_ring_info);
+}
+
+static bool virtio_msg_linux_bridge_setup_eventfds(VirtIOMSGLinuxBridge *s,
+                                                   Error **errp)
+{
+    int ret;
+
+    ret = event_notifier_init(&s->kick, 0);
+    if (ret < 0) {
+        error_setg_errno(errp, -ret, "failed to create kick event notifier");
+        return false;
+    }
+    s->kick_initialized = true;
+
+    ret = event_notifier_init(&s->call, 0);
+    if (ret < 0) {
+        error_setg_errno(errp, -ret, "failed to create call event notifier");
+        virtio_msg_linux_bridge_cleanup_eventfds(s);
+        return false;
+    }
+    s->call_initialized = true;
+
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_attach(VirtIOMSGLinuxBridge *s,
+                                           Error **errp)
+{
+    struct vmsg_bridge_uapi_attach attach = { 0 };
+    VirtIOMSGLinuxBridgeCapsValidationResult caps_result;
+    VirtIOMSGLinuxBridgeSessionState session_state;
+    bool endpoint_online;
+    uint32_t attach_max_msg_size;
+    int ret;
+
+    g_assert(s->kick_initialized);
+    g_assert(s->call_initialized);
+
+    attach.endpoint_id = s->endpoint_handle;
+    attach.ring_fd = s->ring_fd;
+    attach.kick_fd = event_notifier_get_fd(&s->kick);
+    attach.call_fd = event_notifier_get_fd(&s->call);
+    attach.vmm_max_msg_size = s->vmm_max_msg_size;
+    attach.tx = s->tx_ring_info;
+    attach.rx = s->rx_ring_info;
+
+    ret = virtio_msg_linux_bridge_ioctl(s->dev_fd, VMSG_BRIDGE_IOCTL_ATTACH,
+                                        &attach);
+    if (ret < 0) {
+        error_setg_errno(errp, errno, "bridge ATTACH failed");
+        return false;
+    }
+
+    if (attach.caps.uapi_version != VMSG_BRIDGE_UAPI_VERSION) {
+        error_setg(errp,
+                   "bridge ATTACH returned unsupported UAPI version %u "
+                   "(expected %u)",
+                   attach.caps.uapi_version, VMSG_BRIDGE_UAPI_VERSION);
+        goto out_detach;
+    }
+    endpoint_online =
+        (attach.caps.flags & VMSG_BRIDGE_UAPI_CAP_F_ENDPOINT_ONLINE) != 0;
+
+    if (endpoint_online) {
+        if (attach.caps.online_epoch == 0) {
+            error_setg(errp,
+                       "bridge ATTACH online snapshot returned epoch 0");
+            goto out_detach;
+        }
+        caps_result = virtio_msg_linux_bridge_validate_caps_common(
+            attach.caps.revision, attach.caps.max_msg_size,
+            &attach_max_msg_size);
+        if (caps_result ==
+            VIRTIO_MSG_LINUX_BRIDGE_CAPS_VALIDATION_BAD_REVISION) {
+            error_setg(errp,
+                       "bridge ATTACH returned unsupported transport "
+                       "revision %u (expected %u)",
+                       attach.caps.revision,
+                       VIRTIO_MSG_LINUX_BRIDGE_REVISION_SUPPORTED);
+            goto out_detach;
+        }
+        if (caps_result ==
+            VIRTIO_MSG_LINUX_BRIDGE_CAPS_VALIDATION_BAD_MAX_MSG_SIZE) {
+            error_setg(errp,
+                       "bridge ATTACH returned unsupported max_msg_size %u "
+                       "(supported range %u..%u)",
+                       attach_max_msg_size,
+                       (unsigned int)bridge_local_min_msg_size(),
+                       (unsigned int)VIRTIO_MSG_MAX_SIZE);
+            goto out_detach;
+        }
+    } else {
+        if (attach.caps.online_epoch != 0) {
+            error_setg(errp,
+                       "bridge ATTACH offline snapshot returned non-zero "
+                       "epoch %" PRIu64,
+                       (uint64_t)attach.caps.online_epoch);
+            goto out_detach;
+        }
+        attach_max_msg_size = virtio_msg_linux_bridge_max_msg_size(s);
+    }
+
+    s->caps = attach.caps;
+    s->last_online_epoch = endpoint_online ? attach.caps.online_epoch : 0;
+    s->endpoint_max_msg_size = endpoint_online ? attach_max_msg_size : 0;
+    virtio_msg_linux_bridge_apply_caps_common(
+        s,
+        endpoint_online ? attach.caps.revision :
+            VIRTIO_MSG_LINUX_BRIDGE_REVISION_SUPPORTED,
+        attach_max_msg_size,
+        endpoint_online ? attach.caps.transport_features : 0,
+        endpoint_online ? attach.caps.bridge_features : 0);
+    session_state = endpoint_online ?
+        VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_NEEDS_TOPOLOGY :
+        VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_OFFLINE;
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    s->attached = true;
+    virtio_msg_linux_bridge_set_state(s, session_state);
+    qemu_set_fd_handler(event_notifier_get_fd(&s->call),
+                        virtio_msg_linux_bridge_callfd_read,
+                        NULL, s);
+    trace_virtio_msg_linux_bridge_fd_event(
+        s->endpoint_handle, "callfd-register-attach",
+        event_notifier_get_fd(&s->call),
+        s->session_state, 0);
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "attached", s->session_state,
+        s->caps.online_epoch, endpoint_online);
+    return true;
+
+out_detach:
+    ret = virtio_msg_linux_bridge_ioctl(s->dev_fd, VMSG_BRIDGE_IOCTL_DETACH,
+                                        NULL);
+    if (ret < 0) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "DETACH after failed attach validation failed: %s",
+            strerror(errno));
+    }
+
+    return false;
+}
+
+static void virtio_msg_linux_bridge_detach(VirtIOMSGLinuxBridge *s)
+{
+    int ret;
+
+    virtio_msg_linux_bridge_unregister_call_handler(
+        s, "callfd-remove-detach", 0);
+
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_cleanup(
+            s, VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_DETACH, 0);
+        virtio_msg_linux_bridge_set_state(
+            s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED);
+        return;
+    }
+
+    virtio_msg_linux_bridge_clear_pending_tx(s);
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    virtio_msg_linux_bridge_unmap_all(s);
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_cleanup(
+            s, VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_DETACH, 0);
+        virtio_msg_linux_bridge_set_state(
+            s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED);
+        return;
+    }
+
+    virtio_msg_linux_bridge_free_tombstones(s);
+    if (!s->attached || s->dev_fd < 0) {
+        s->attached = false;
+        virtio_msg_linux_bridge_set_state(
+            s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED);
+        return;
+    }
+
+    ret = virtio_msg_linux_bridge_ioctl(s->dev_fd, VMSG_BRIDGE_IOCTL_DETACH,
+                                        NULL);
+    if (ret < 0) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR("DETACH failed endpoint=%u: %s",
+                                      s->endpoint_handle, strerror(errno));
+    } else {
+        trace_virtio_msg_linux_bridge_lifecycle(
+            s->endpoint_handle, "detached", s->session_state,
+            s->caps.online_epoch, 0);
+    }
+    s->attached = false;
+    virtio_msg_linux_bridge_set_state(
+        s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED);
+}
+
+static void virtio_msg_linux_bridge_realize(DeviceState *dev, Error **errp)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(dev);
+
+    if (!s->devnode) {
+        s->devnode = g_strdup(VIRTIO_MSG_LINUX_BRIDGE_DEVNODE_DEFAULT);
+    }
+
+    if (!s->devnode[0]) {
+        error_setg(errp, "devnode must not be empty");
+        return;
+    }
+
+    if (s->vmm_max_msg_size < bridge_local_min_msg_size()) {
+        error_setg(errp,
+                   "invalid vmm-max-msg-size=%u: bridge-local minimum is %zu",
+                   s->vmm_max_msg_size,
+                   bridge_local_min_msg_size());
+        return;
+    }
+    if (s->vmm_max_msg_size > VIRTIO_MSG_MAX_SIZE) {
+        error_setg(errp,
+                   "invalid vmm-max-msg-size=%u: virtio-msg maximum is %u",
+                   s->vmm_max_msg_size, (unsigned int)VIRTIO_MSG_MAX_SIZE);
+        return;
+    }
+
+    if (!virtio_msg_linux_bridge_ring_valid(s->tx_ring_entries,
+                                            s->tx_ring_entry_size)) {
+        error_setg(errp,
+                   "invalid tx ring geometry: entries=%u entry-size=%u",
+                   s->tx_ring_entries, s->tx_ring_entry_size);
+        return;
+    }
+    if (!virtio_msg_linux_bridge_entry_size_matches_vmm_max(
+            s, s->tx_ring_entry_size)) {
+        error_setg(errp,
+                   "invalid tx ring entry-size=%u for vmm-max-msg-size=%u",
+                   s->tx_ring_entry_size, s->vmm_max_msg_size);
+        return;
+    }
+
+    if (!virtio_msg_linux_bridge_ring_valid(s->rx_ring_entries,
+                                            s->rx_ring_entry_size)) {
+        error_setg(errp,
+                   "invalid rx ring geometry: entries=%u entry-size=%u",
+                   s->rx_ring_entries, s->rx_ring_entry_size);
+        return;
+    }
+    if (!virtio_msg_linux_bridge_entry_size_matches_vmm_max(
+            s, s->rx_ring_entry_size)) {
+        error_setg(errp,
+                   "invalid rx ring entry-size=%u for vmm-max-msg-size=%u",
+                   s->rx_ring_entry_size, s->vmm_max_msg_size);
+        return;
+    }
+
+    if (!virtio_msg_linux_bridge_compute_ring_layout(s, errp)) {
+        return;
+    }
+
+    virtio_msg_linux_bridge_register_machine_done_notifier(s);
+
+    s->dev_fd = qemu_open(s->devnode, O_RDWR | O_NONBLOCK, errp);
+    if (s->dev_fd < 0) {
+        goto out_err;
+    }
+
+    if (!virtio_msg_linux_bridge_parse_endpoint(s, errp)) {
+        goto out_err;
+    }
+
+    if (!virtio_msg_linux_bridge_resolve_endpoint(s, errp)) {
+        goto out_err;
+    }
+
+    if (!virtio_msg_linux_bridge_setup_rings(s, errp)) {
+        goto out_err;
+    }
+
+    if (!virtio_msg_linux_bridge_setup_eventfds(s, errp)) {
+        goto out_err;
+    }
+
+    if (!virtio_msg_linux_bridge_setup_dma_as(s)) {
+        goto out_err;
+    }
+
+    virtio_msg_linux_bridge_prepare_initial_attach(s);
+
+    if (!virtio_msg_linux_bridge_add_migration_blocker(s, errp)) {
+        goto out_err;
+    }
+
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "realized", s->session_state,
+        s->caps.online_epoch, 0);
+    return;
+
+out_err:
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "realize-failed", s->session_state,
+        s->caps.online_epoch, 0);
+    virtio_msg_linux_bridge_release_resources(
+        s, VIRTIO_MSG_LINUX_BRIDGE_RELEASE_REASON_REALIZE_ERROR);
+}
+
+static void virtio_msg_linux_bridge_unrealize(DeviceState *dev)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(dev);
+
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "unrealize", s->session_state,
+        s->caps.online_epoch, 0);
+    virtio_msg_linux_bridge_release_resources(
+        s, VIRTIO_MSG_LINUX_BRIDGE_RELEASE_REASON_UNREALIZE);
+}
+
+static void virtio_msg_linux_bridge_reset_hold(Object *obj, ResetType type)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(obj);
+
+    (void)type;
+    if (s->dev_fd < 0 && !s->rings && !s->endpoint_resolved) {
+        return;
+    }
+
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "reset-hold", s->session_state,
+        s->caps.online_epoch, 0);
+    if (s->initial_attach_pending && !s->attached) {
+        virtio_msg_linux_bridge_mark_transport_offline(s);
+        return;
+    }
+
+    virtio_msg_linux_bridge_forced_session_teardown(
+        s, "callfd-remove-reset-hold", 0);
+    virtio_msg_linux_bridge_mark_transport_offline(s);
+}
+
+static void virtio_msg_linux_bridge_reset_exit(Object *obj, ResetType type)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(obj);
+    Error *local_err = NULL;
+
+    (void)type;
+    if (s->dev_fd < 0 || !s->endpoint_resolved || !s->rings ||
+        !s->kick_initialized || !s->call_initialized) {
+        return;
+    }
+
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "reset-exit", s->session_state,
+        s->caps.online_epoch, 0);
+    virtio_msg_linux_bridge_reinit_rings(s);
+    virtio_msg_linux_bridge_drain_eventfds(s);
+
+    if (!virtio_msg_linux_bridge_attach(s, &local_err)) {
+        error_reportf_err(local_err,
+                          "virtio-msg Linux bridge reset re-attach failed: ");
+        virtio_msg_linux_bridge_mark_transport_offline(s);
+        virtio_msg_linux_bridge_set_state(
+            s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED);
+        return;
+    }
+    s->initial_attach_pending = false;
+
+    virtio_msg_linux_bridge_latch_transport_caps(s);
+    if (virtio_msg_linux_bridge_state_allows_topology(s) &&
+        !virtio_msg_linux_bridge_refresh_proxy_transport_caps(s,
+                                                              &local_err)) {
+        error_reportf_err(local_err,
+                          "virtio-msg Linux bridge reset caps refresh failed: ");
+        virtio_msg_linux_bridge_fail_attach(s);
+        return;
+    }
+
+    if (!virtio_msg_linux_bridge_maybe_publish_topology(s, &local_err)) {
+        error_reportf_err(local_err,
+                          "virtio-msg Linux bridge reset topology failed: ");
+        virtio_msg_linux_bridge_fail_attach(s);
+        return;
+    }
+}
+
+static void virtio_msg_linux_bridge_process_rx_ring(VirtIOMSGLinuxBridge *s,
+                                                    bool drain_callfd)
+{
+    struct vmsg_bridge_uapi_ring_hdr *hdr;
+    size_t header_size = virtio_msg_header_size();
+
+    if (!s->attached || !s->rings) {
+        return;
+    }
+
+    if (drain_callfd) {
+        virtio_msg_linux_bridge_drain_callfd(s);
+    }
+
+    hdr = virtio_msg_linux_bridge_ring_hdr(s, &s->rx_ring_info);
+
+    while (true) {
+        VirtIOMSG msg = { 0 };
+        uint32_t prod;
+        uint32_t cons;
+        uint32_t used;
+        uint32_t slot_idx;
+        uint32_t next_cons;
+        uint8_t *entry;
+        uint16_t msg_size;
+        int ret;
+
+        prod = qatomic_load_acquire(&hdr->prod);
+        cons = qatomic_read(&hdr->cons);
+        used = virtio_msg_linux_bridge_ring_used(prod, cons);
+
+        if (used == 0) {
+            return;
+        }
+
+        if (used > s->rx_ring_info.entries) {
+            VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                "invalid RX ring occupancy used=%u entries=%u prod=%u "
+                "cons=%u",
+                used, s->rx_ring_info.entries, prod, cons);
+            virtio_msg_linux_bridge_fail_attach(s);
+            return;
+        }
+
+        if (s->deferred_cleanup !=
+                VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_NONE ||
+            s->map_add_deferred || s->map_del_deferred ||
+            virtio_msg_linux_bridge_has_pending_failed_map_add_resp(s)) {
+            return;
+        }
+
+        if (s->rx_bridge_error_pending) {
+            int report_ret =
+                virtio_msg_linux_bridge_emit_pending_rx_bridge_error(s);
+
+            if (report_ret < 0) {
+                int err = -report_ret;
+
+                if (virtio_msg_linux_bridge_errno_is_transient(err)) {
+                    virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+                    virtio_msg_linux_bridge_grow_pending_tx_retry_delay(s);
+                    return;
+                }
+
+                VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                    "BRIDGE_ERROR retry failed: %s", strerror(err));
+                virtio_msg_linux_bridge_fail_attach(s);
+                return;
+            }
+
+            qatomic_store_release(&hdr->cons, cons + 1);
+            continue;
+        }
+
+        slot_idx = virtio_msg_linux_bridge_ring_slot_index(
+            cons, s->rx_ring_info.entries);
+        entry = virtio_msg_linux_bridge_ring_entry(hdr, &s->rx_ring_info,
+                                                   slot_idx);
+        memcpy(&msg, entry, header_size);
+        msg_size = le16_to_cpu(msg.msg_size);
+        next_cons = cons + 1;
+
+        if (!virtio_msg_linux_bridge_msg_size_valid(
+                s, msg_size, s->rx_ring_info.entry_size)) {
+            VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                "malformed RX message size=%u entry_size=%u max=%u",
+                msg_size, s->rx_ring_info.entry_size,
+                virtio_msg_linux_bridge_max_msg_size(s));
+            virtio_msg_linux_bridge_fail_attach(s);
+            return;
+        }
+
+        memcpy((uint8_t *)&msg + header_size,
+               entry + header_size,
+               msg_size - header_size);
+        if (msg.type & VIRTIO_MSG_TYPE_BUS) {
+            if (virtio_msg_linux_bridge_msg_is_bridge_local(&msg)) {
+                VirtIOMSGLinuxBridgeRxResult rx_result =
+                    virtio_msg_linux_bridge_process_bridge_local_rx(
+                        s, &msg, msg_size);
+
+                switch (rx_result) {
+                case VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED:
+                    qatomic_store_release(&hdr->cons, next_cons);
+                    continue;
+                case VIRTIO_MSG_LINUX_BRIDGE_RX_CONSUMED_STOP:
+                    qatomic_store_release(&hdr->cons, next_cons);
+                    return;
+                case VIRTIO_MSG_LINUX_BRIDGE_RX_RETRY:
+                    return;
+                case VIRTIO_MSG_LINUX_BRIDGE_RX_FAILED:
+                    return;
+                default:
+                    g_assert_not_reached();
+                }
+            }
+
+            trace_virtio_msg_linux_bridge_rx_discard(
+                s->endpoint_handle, msg.msg_id, msg.type,
+                le16_to_cpu(msg.dev_num), le16_to_cpu(msg.token),
+                s->session_state);
+            qatomic_store_release(&hdr->cons, next_cons);
+            continue;
+        }
+
+        if (!virtio_msg_linux_bridge_state_allows_data(s)) {
+            trace_virtio_msg_linux_bridge_rx_discard(
+                s->endpoint_handle, msg.msg_id, msg.type,
+                le16_to_cpu(msg.dev_num), le16_to_cpu(msg.token),
+                s->session_state);
+            qatomic_store_release(&hdr->cons, next_cons);
+            continue;
+        }
+        trace_virtio_msg_linux_bridge_rx_msg(s->endpoint_handle,
+                                             msg.msg_id,
+                                             msg.type,
+                                             le16_to_cpu(msg.dev_num),
+                                             le16_to_cpu(msg.token),
+                                             msg_size);
+        virtio_msg_linux_bridge_log_msg_summary(s, &msg, true);
+        ret = virtio_msg_bus_receive(VIRTIO_MSG_BUS_DEVICE(s), &msg);
+        if (ret == VIRTIO_MSG_ERROR_RETRY) {
+            return;
+        }
+
+        if (ret != VIRTIO_MSG_NO_ERROR) {
+            VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                "rx handler returned %d (%s) for msg=%s(0x%x) "
+                "dev=%u token=%u",
+                ret, virtio_msg_linux_bridge_result_to_str(ret),
+                bridge_msg_id_to_str(msg.type, msg.msg_id),
+                msg.msg_id, msg.dev_num, msg.token);
+        }
+        if (ret != VIRTIO_MSG_NO_ERROR &&
+            virtio_msg_linux_bridge_is_transport_request(&msg)) {
+            int report_ret =
+                virtio_msg_linux_bridge_report_msg_error(s, &msg, ret);
+
+            if (report_ret < 0) {
+                int err = -report_ret;
+
+                if (virtio_msg_linux_bridge_errno_is_transient(err)) {
+                    virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+                    virtio_msg_linux_bridge_grow_pending_tx_retry_delay(s);
+                    return;
+                }
+
+                VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                    "BRIDGE_ERROR report failed msg=%s(0x%x) "
+                    "dev=%u token=%u: %s",
+                    bridge_msg_id_to_str(msg.type, msg.msg_id),
+                    msg.msg_id, msg.dev_num, msg.token, strerror(err));
+                if (virtio_msg_linux_bridge_errno_is_terminal(err)) {
+                    virtio_msg_linux_bridge_fail_attach(s);
+                    return;
+                }
+            }
+        }
+        qatomic_store_release(&hdr->cons, next_cons);
+    }
+
+}
+static void virtio_msg_linux_bridge_process(VirtIOMSGBusDevice *bd)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(bd);
+
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, true);
+    }
+    virtio_msg_linux_bridge_process_rx_ring(s, true);
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, true);
+    }
+}
+
+static void virtio_msg_linux_bridge_callfd_read(void *opaque)
+{
+    VirtIOMSGLinuxBridge *s = opaque;
+
+    virtio_msg_linux_bridge_drain_callfd(s);
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, true);
+    }
+    virtio_msg_linux_bridge_process_rx_ring(s, false);
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, true);
+    }
+}
+
+static bool virtio_msg_linux_bridge_queue_pending_tx(VirtIOMSGLinuxBridge *s,
+                                                     const VirtIOMSG *msg)
+{
+    VirtIOMSGLinuxBridgePendingTx *pending;
+
+    pending = g_try_new(VirtIOMSGLinuxBridgePendingTx, 1);
+    if (!pending) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "failed to queue pending TX msg=%s(0x%x) dev=%u "
+            "token=%u: out of memory",
+            bridge_msg_id_to_str(msg->type, msg->msg_id),
+            msg->msg_id, le16_to_cpu(msg->dev_num),
+            le16_to_cpu(msg->token));
+        return false;
+    }
+
+    pending->msg = *msg;
+    pending->retry_failures = 0;
+    QTAILQ_INSERT_TAIL(&s->pending_tx, pending, node);
+    return true;
+}
+
+static void virtio_msg_linux_bridge_clear_pending_tx(VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgePendingTx *pending;
+
+    while ((pending = QTAILQ_FIRST(&s->pending_tx))) {
+        QTAILQ_REMOVE(&s->pending_tx, pending, node);
+        g_free(pending);
+    }
+    virtio_msg_linux_bridge_cancel_pending_tx_retry(s);
+}
+
+static bool virtio_msg_linux_bridge_can_retry_rx_bridge_error(
+    const VirtIOMSGLinuxBridge *s)
+{
+    return s->attached && s->rings && s->rx_bridge_error_pending;
+}
+
+static void virtio_msg_linux_bridge_clear_rx_bridge_error(
+    VirtIOMSGLinuxBridge *s)
+{
+    s->rx_bridge_error_pending = false;
+    memset(&s->rx_bridge_error_msg, 0, sizeof(s->rx_bridge_error_msg));
+}
+
+static bool virtio_msg_linux_bridge_can_flush_pending_tx(
+    const VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgePendingTx *pending;
+
+    if (!s->attached || !s->rings) {
+        return false;
+    }
+
+    pending = QTAILQ_FIRST(&s->pending_tx);
+    if (!pending) {
+        return false;
+    }
+
+    if (virtio_msg_linux_bridge_msg_is_bridge_local(&pending->msg)) {
+        return virtio_msg_linux_bridge_bridge_local_state_allows_tx(
+            s, &pending->msg);
+    }
+
+    return virtio_msg_linux_bridge_state_allows_data(s);
+}
+
+static bool virtio_msg_linux_bridge_pending_tx_requires_fail_attach(
+    const VirtIOMSG *msg)
+{
+    if (msg->type & VIRTIO_MSG_TYPE_RESPONSE) {
+        return true;
+    }
+
+    if (virtio_msg_linux_bridge_msg_is_bridge_local(msg)) {
+        return true;
+    }
+
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_EVENT_CONFIG:
+    case VIRTIO_MSG_EVENT_AVAIL:
+    case VIRTIO_MSG_EVENT_USED:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void virtio_msg_linux_bridge_reset_pending_tx_retry_delay(
+    VirtIOMSGLinuxBridge *s)
+{
+    s->pending_tx_retry_delay_ms =
+        VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_DELAY_MIN_MS;
+}
+
+static void virtio_msg_linux_bridge_grow_pending_tx_retry_delay(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (!s->pending_tx_retry_delay_ms) {
+        virtio_msg_linux_bridge_reset_pending_tx_retry_delay(s);
+        return;
+    }
+
+    if (s->pending_tx_retry_delay_ms <
+        VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_DELAY_MAX_MS) {
+        s->pending_tx_retry_delay_ms = MIN(
+            s->pending_tx_retry_delay_ms * 2,
+            VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_DELAY_MAX_MS);
+    }
+}
+
+static void virtio_msg_linux_bridge_schedule_pending_tx_retry(
+    VirtIOMSGLinuxBridge *s)
+{
+    int64_t now;
+
+    if (!s->pending_tx_retry_timer) {
+        return;
+    }
+
+    if (!virtio_msg_linux_bridge_can_flush_pending_tx(s) &&
+        !virtio_msg_linux_bridge_can_retry_rx_bridge_error(s)) {
+        return;
+    }
+
+    if (!s->pending_tx_retry_delay_ms) {
+        virtio_msg_linux_bridge_reset_pending_tx_retry_delay(s);
+    }
+
+    now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    timer_mod_anticipate(s->pending_tx_retry_timer,
+                         now + s->pending_tx_retry_delay_ms);
+}
+
+static void virtio_msg_linux_bridge_cancel_pending_tx_retry(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (!s->pending_tx_retry_timer) {
+        return;
+    }
+
+    timer_del(s->pending_tx_retry_timer);
+    virtio_msg_linux_bridge_reset_pending_tx_retry_delay(s);
+}
+
+static void virtio_msg_linux_bridge_pending_tx_retry_cb(void *opaque)
+{
+    VirtIOMSGLinuxBridge *s = opaque;
+
+    if (!virtio_msg_linux_bridge_can_flush_pending_tx(s) &&
+        !virtio_msg_linux_bridge_can_retry_rx_bridge_error(s)) {
+        virtio_msg_linux_bridge_cancel_pending_tx_retry(s);
+        return;
+    }
+
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, false);
+    }
+    if (virtio_msg_linux_bridge_can_retry_rx_bridge_error(s)) {
+        virtio_msg_linux_bridge_process_rx_ring(s, false);
+    }
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, false);
+    }
+
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s) ||
+        virtio_msg_linux_bridge_can_retry_rx_bridge_error(s)) {
+        virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+        return;
+    }
+
+    virtio_msg_linux_bridge_cancel_pending_tx_retry(s);
+}
+
+static bool virtio_msg_linux_bridge_msg_is_bridge_local(const VirtIOMSG *msg)
+{
+    if (!(msg->type & VIRTIO_MSG_TYPE_BUS)) {
+        return false;
+    }
+
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_BUS_BRIDGE_ERROR:
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_ONLINE:
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_OFFLINE:
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_RESET:
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_DEV_ADD:
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_COMMIT:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_ADD:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_DEL:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_RELEASED:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool virtio_msg_linux_bridge_msg_is_bridge_local_tx(
+    const VirtIOMSG *msg)
+{
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_RESET:
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_DEV_ADD:
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_COMMIT:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_ADD:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_DEL:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_RELEASED:
+    case VIRTIO_MSG_BUS_BRIDGE_ERROR:
+        return virtio_msg_linux_bridge_msg_is_bridge_local(msg);
+    default:
+        return false;
+    }
+}
+
+static size_t virtio_msg_linux_bridge_bridge_local_payload_size(
+    const VirtIOMSG *msg)
+{
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_ONLINE:
+        return sizeof(struct virtio_msg_bus_bridge_endpoint_online);
+    case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_OFFLINE:
+        return sizeof(struct virtio_msg_bus_bridge_endpoint_offline);
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_RESET:
+        return sizeof(struct virtio_msg_bus_bridge_topology_reset);
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_DEV_ADD:
+        return sizeof(struct virtio_msg_bus_bridge_topology_dev_add);
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_COMMIT:
+        return sizeof(struct virtio_msg_bus_bridge_topology_commit);
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_ADD:
+        if (msg->type & VIRTIO_MSG_TYPE_RESPONSE) {
+            return sizeof(struct virtio_msg_bus_bridge_map_add_resp);
+        }
+        return sizeof(struct virtio_msg_bus_bridge_map_add_req);
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_DEL:
+        if (msg->type & VIRTIO_MSG_TYPE_RESPONSE) {
+            return sizeof(struct virtio_msg_bus_bridge_map_del_resp);
+        }
+        return sizeof(struct virtio_msg_bus_bridge_map_del_req);
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_RELEASED:
+        return sizeof(struct virtio_msg_bus_bridge_map_released);
+    case VIRTIO_MSG_BUS_BRIDGE_ERROR:
+        return sizeof(struct virtio_msg_bus_bridge_error);
+    default:
+        return 0;
+    }
+}
+
+static bool virtio_msg_linux_bridge_bridge_local_msg_valid(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSG *msg)
+{
+    uint16_t msg_size = le16_to_cpu(msg->msg_size);
+    size_t payload_size;
+    uint8_t expected_type = VIRTIO_MSG_TYPE_BUS;
+
+    if (!virtio_msg_linux_bridge_msg_is_bridge_local_tx(msg)) {
+        return false;
+    }
+
+    if (msg->msg_id == VIRTIO_MSG_BUS_BRIDGE_ERROR ||
+        msg->msg_id == VIRTIO_MSG_BUS_BRIDGE_MAP_ADD ||
+        msg->msg_id == VIRTIO_MSG_BUS_BRIDGE_MAP_DEL) {
+        expected_type |= VIRTIO_MSG_TYPE_RESPONSE;
+    }
+
+    if ((msg->type & VIRTIO_MSG_TYPE_MASK) != expected_type ||
+        le16_to_cpu(msg->dev_num) != 0) {
+        return false;
+    }
+
+    if (msg->msg_id != VIRTIO_MSG_BUS_BRIDGE_ERROR &&
+        msg->msg_id != VIRTIO_MSG_BUS_BRIDGE_MAP_ADD &&
+        msg->msg_id != VIRTIO_MSG_BUS_BRIDGE_MAP_DEL &&
+        le16_to_cpu(msg->token) != 0) {
+        return false;
+    }
+
+    payload_size = virtio_msg_linux_bridge_bridge_local_payload_size(msg);
+    if (msg_size != virtio_msg_header_size() + payload_size) {
+        return false;
+    }
+
+    return virtio_msg_linux_bridge_bridge_local_size_valid(s) &&
+        virtio_msg_linux_bridge_msg_size_valid(s, msg_size,
+                                               s->tx_ring_info.entry_size);
+}
+
+static bool virtio_msg_linux_bridge_bridge_local_state_allows_tx(
+    const VirtIOMSGLinuxBridge *s, const VirtIOMSG *msg)
+{
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_RESET:
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_DEV_ADD:
+    case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_COMMIT:
+        return virtio_msg_linux_bridge_state_allows_topology(s);
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_ADD:
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_DEL:
+    case VIRTIO_MSG_BUS_BRIDGE_ERROR:
+        return virtio_msg_linux_bridge_state_allows_data(s);
+    case VIRTIO_MSG_BUS_BRIDGE_MAP_RELEASED:
+        return virtio_msg_linux_bridge_state_allows_data(s) ||
+               s->session_state ==
+                   VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_OFFLINE ||
+               (s->deferred_cleanup !=
+                    VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_NONE &&
+                (s->session_state ==
+                     VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED ||
+                 s->session_state ==
+                     VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED));
+    default:
+        return false;
+    }
+}
+
+static bool virtio_msg_linux_bridge_msg_is_event_used(const VirtIOMSG *msg)
+{
+    return !(msg->type & (VIRTIO_MSG_TYPE_BUS | VIRTIO_MSG_TYPE_RESPONSE)) &&
+           msg->msg_id == VIRTIO_MSG_EVENT_USED;
+}
+
+static int virtio_msg_linux_bridge_write_tx_ring(VirtIOMSGLinuxBridge *s,
+                                                 VirtIOMSG *msg)
+{
+    struct vmsg_bridge_uapi_ring_hdr *hdr;
+    uint16_t msg_size = le16_to_cpu(msg->msg_size);
+    uint32_t prod;
+    uint32_t cons;
+    uint32_t used;
+    uint32_t slot_idx;
+    uint8_t *entry;
+    bool event_used = virtio_msg_linux_bridge_msg_is_event_used(msg);
+
+    hdr = virtio_msg_linux_bridge_ring_hdr(s, &s->tx_ring_info);
+    prod = qatomic_read(&hdr->prod);
+    cons = qatomic_load_acquire(&hdr->cons);
+    used = virtio_msg_linux_bridge_ring_used(prod, cons);
+
+    if (used > s->tx_ring_info.entries) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "invalid TX ring occupancy used=%u entries=%u prod=%u cons=%u",
+            used, s->tx_ring_info.entries, prod, cons);
+        virtio_msg_linux_bridge_fail_attach(s);
+        return VIRTIO_MSG_ERROR_NO_DEVICE;
+    }
+
+    if (used == s->tx_ring_info.entries) {
+        return VIRTIO_MSG_ERROR_RETRY;
+    }
+
+    slot_idx = virtio_msg_linux_bridge_ring_slot_index(
+        prod, s->tx_ring_info.entries);
+    entry = virtio_msg_linux_bridge_ring_entry(hdr, &s->tx_ring_info,
+                                               slot_idx);
+    memcpy(entry, msg, msg_size);
+
+    qatomic_store_release(&hdr->prod, prod + 1);
+
+    virtio_msg_linux_bridge_kick(s);
+    if (event_used) {
+        virtio_msg_linux_bridge_schedule_map_reclaim(s);
+    }
+    return VIRTIO_MSG_NO_ERROR;
+}
+
+static int virtio_msg_linux_bridge_send_pending_tx(VirtIOMSGLinuxBridge *s,
+                                                   VirtIOMSG *msg)
+{
+    uint16_t msg_size = le16_to_cpu(msg->msg_size);
+
+    if (!s->attached || !s->rings) {
+        return VIRTIO_MSG_ERROR_MEMORY;
+    }
+
+    if (virtio_msg_linux_bridge_msg_is_bridge_local(msg)) {
+        if (!virtio_msg_linux_bridge_bridge_local_state_allows_tx(s, msg)) {
+            return VIRTIO_MSG_ERROR_RETRY;
+        }
+        if (!virtio_msg_linux_bridge_bridge_local_msg_valid(s, msg)) {
+            return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+        }
+        goto send;
+    }
+
+    if (!virtio_msg_linux_bridge_state_allows_data(s)) {
+        return VIRTIO_MSG_ERROR_RETRY;
+    }
+
+    if (msg->type & VIRTIO_MSG_TYPE_BUS) {
+        return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+    }
+
+    if (!virtio_msg_linux_bridge_msg_size_valid(s, msg_size,
+                                                s->tx_ring_info.entry_size)) {
+        return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+    }
+
+send:
+    trace_virtio_msg_linux_bridge_tx_msg(s->endpoint_handle,
+                                         msg->msg_id,
+                                         msg->type,
+                                         le16_to_cpu(msg->dev_num),
+                                         le16_to_cpu(msg->token),
+                                         msg_size);
+    virtio_msg_linux_bridge_log_msg_summary(s, msg, false);
+    return virtio_msg_linux_bridge_write_tx_ring(s, msg);
+}
+
+static int virtio_msg_linux_bridge_send(VirtIOMSGBusDevice *bd,
+                                        VirtIOMSG *msg_req)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(bd);
+    uint16_t msg_size = le16_to_cpu(msg_req->msg_size);
+
+    if (!s->attached || !s->rings) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR("TX while bridge is detached");
+        return VIRTIO_MSG_ERROR_MEMORY;
+    }
+
+    if (!virtio_msg_linux_bridge_state_allows_data(s)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR("TX while endpoint=%u is not active",
+                                      s->endpoint_handle);
+        return VIRTIO_MSG_ERROR_RETRY;
+    }
+
+    if (!QTAILQ_EMPTY(&s->pending_tx)) {
+        return VIRTIO_MSG_ERROR_RETRY;
+    }
+
+    if (msg_req->type & VIRTIO_MSG_TYPE_BUS) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "reject TX bus-class frame msg=%s(0x%x) dev=%u token=%u",
+            bridge_msg_id_to_str(msg_req->type, msg_req->msg_id),
+            msg_req->msg_id, le16_to_cpu(msg_req->dev_num),
+            le16_to_cpu(msg_req->token));
+        return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+    }
+
+    if (!virtio_msg_linux_bridge_msg_size_valid(s, msg_size,
+                                                s->tx_ring_info.entry_size)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "reject TX msg=%s(0x%x) size=%u entry_size=%u max=%u",
+            bridge_msg_id_to_str(msg_req->type, msg_req->msg_id),
+            msg_req->msg_id, msg_size, s->tx_ring_info.entry_size,
+            virtio_msg_linux_bridge_max_msg_size(s));
+        return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+    }
+    trace_virtio_msg_linux_bridge_tx_msg(s->endpoint_handle,
+                                         msg_req->msg_id,
+                                         msg_req->type,
+                                         le16_to_cpu(msg_req->dev_num),
+                                         le16_to_cpu(msg_req->token),
+                                         msg_size);
+    virtio_msg_linux_bridge_log_msg_summary(s, msg_req, false);
+
+    return virtio_msg_linux_bridge_write_tx_ring(s, msg_req);
+}
+
+static bool virtio_msg_linux_bridge_flush_pending_tx(VirtIOMSGLinuxBridge *s,
+                                                     bool schedule_retry)
+{
+    VirtIOMSGLinuxBridgePendingTx *pending;
+    VirtIOMSGLinuxBridgeSessionState active_state =
+        VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE;
+    bool progress = false;
+
+    while ((pending = QTAILQ_FIRST(&s->pending_tx))) {
+        int ret = virtio_msg_linux_bridge_send_pending_tx(s, &pending->msg);
+
+        if (ret == VIRTIO_MSG_NO_ERROR) {
+            bool topology_commit =
+                pending->msg.msg_id == VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_COMMIT;
+            bool failed_map_add =
+                virtio_msg_linux_bridge_msg_is_failed_map_add_resp(
+                    &pending->msg);
+
+            QTAILQ_REMOVE(&s->pending_tx, pending, node);
+            g_free(pending);
+            virtio_msg_linux_bridge_reset_pending_tx_retry_delay(s);
+            progress = true;
+            if (failed_map_add) {
+                VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                    "pending MAP_ADD failure response accepted; entering "
+                    "ATTACHED_FAILED");
+                virtio_msg_linux_bridge_fail_attach(s);
+                return progress;
+            }
+            if (topology_commit &&
+                virtio_msg_linux_bridge_state_allows_topology(s)) {
+                virtio_msg_linux_bridge_set_state(s, active_state);
+            }
+            continue;
+        }
+
+        /*
+         * send() may have triggered a terminal detach path that clears the
+         * pending queue (including this node). Do not dereference or free a
+         * potentially stale pointer in that case.
+         */
+        if (!s->attached || QTAILQ_EMPTY(&s->pending_tx) ||
+            pending != QTAILQ_FIRST(&s->pending_tx)) {
+            return progress;
+        }
+
+        if (ret == VIRTIO_MSG_ERROR_RETRY) {
+            pending->retry_failures++;
+            if (pending->retry_failures >=
+                VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_MAX_FAILURES) {
+                bool fail_attach =
+                    virtio_msg_linux_bridge_pending_tx_requires_fail_attach(
+                        &pending->msg);
+
+                trace_virtio_msg_linux_bridge_pending_tx_drop(
+                    s->endpoint_handle, pending->msg.msg_id, pending->msg.type,
+                    le16_to_cpu(pending->msg.dev_num),
+                    le16_to_cpu(pending->msg.token), VIRTIO_MSG_ERROR_RETRY,
+                    pending->retry_failures, fail_attach);
+                QTAILQ_REMOVE(&s->pending_tx, pending, node);
+                g_free(pending);
+                virtio_msg_linux_bridge_reset_pending_tx_retry_delay(s);
+                progress = true;
+                if (fail_attach) {
+                    virtio_msg_linux_bridge_fail_attach(s);
+                    return progress;
+                }
+                continue;
+            }
+
+            if (schedule_retry) {
+                virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+            }
+            trace_virtio_msg_linux_bridge_pending_tx_retry(
+                s->endpoint_handle, pending->msg.msg_id, pending->msg.type,
+                le16_to_cpu(pending->msg.dev_num),
+                le16_to_cpu(pending->msg.token), pending->retry_failures,
+                VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_MAX_FAILURES,
+                s->pending_tx_retry_delay_ms);
+            virtio_msg_linux_bridge_grow_pending_tx_retry_delay(s);
+            return progress;
+        }
+
+        trace_virtio_msg_linux_bridge_pending_tx_drop(
+            s->endpoint_handle, pending->msg.msg_id, pending->msg.type,
+            le16_to_cpu(pending->msg.dev_num),
+            le16_to_cpu(pending->msg.token), ret, pending->retry_failures,
+            false);
+        QTAILQ_REMOVE(&s->pending_tx, pending, node);
+        g_free(pending);
+        virtio_msg_linux_bridge_reset_pending_tx_retry_delay(s);
+        progress = true;
+    }
+
+    if (QTAILQ_EMPTY(&s->pending_tx)) {
+        virtio_msg_linux_bridge_cancel_pending_tx_retry(s);
+        virtio_msg_linux_bridge_maybe_complete_deferred_cleanup(s);
+    }
+
+    return progress;
+}
+
+static int virtio_msg_linux_bridge_send_bridge_local_must_deliver(
+    VirtIOMSGLinuxBridge *s, VirtIOMSG *msg)
+{
+    int ret;
+
+    if (!s->attached || !s->rings) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "bridge-local TX while bridge is detached");
+        return VIRTIO_MSG_ERROR_MEMORY;
+    }
+
+    if (!virtio_msg_linux_bridge_bridge_local_state_allows_tx(s, msg)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "bridge-local TX while endpoint=%u state=%d "
+            "does not allow msg=%s(0x%x)",
+            s->endpoint_handle, s->session_state,
+            bridge_msg_id_to_str(msg->type, msg->msg_id), msg->msg_id);
+        return VIRTIO_MSG_ERROR_RETRY;
+    }
+
+    if (!virtio_msg_linux_bridge_bridge_local_msg_valid(s, msg)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "reject bridge-local TX msg=%s(0x%x) type=0x%x "
+            "dev=%u token=%u size=%u min=%zu max=%u",
+            bridge_msg_id_to_str(msg->type, msg->msg_id),
+            msg->msg_id, msg->type, le16_to_cpu(msg->dev_num),
+            le16_to_cpu(msg->token), le16_to_cpu(msg->msg_size),
+            bridge_local_min_msg_size(),
+            virtio_msg_linux_bridge_max_msg_size(s));
+        return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+    }
+
+    if (!QTAILQ_EMPTY(&s->pending_tx)) {
+        if (!virtio_msg_linux_bridge_queue_pending_tx(s, msg)) {
+            return VIRTIO_MSG_ERROR_MEMORY;
+        }
+        virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+        return VIRTIO_MSG_NO_ERROR;
+    }
+
+    ret = virtio_msg_linux_bridge_send_pending_tx(s, msg);
+    if (ret != VIRTIO_MSG_ERROR_RETRY) {
+        return ret;
+    }
+
+    if (!virtio_msg_linux_bridge_queue_pending_tx(s, msg)) {
+        return VIRTIO_MSG_ERROR_MEMORY;
+    }
+    virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+    return VIRTIO_MSG_NO_ERROR;
+}
+
+static int virtio_msg_linux_bridge_send_must_deliver(VirtIOMSGBusDevice *bd,
+                                                     VirtIOMSG *msg_req)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(bd);
+    uint16_t msg_size = le16_to_cpu(msg_req->msg_size);
+    int ret;
+
+    if (!s->attached || !s->rings) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "must-deliver TX while bridge is detached");
+        return VIRTIO_MSG_ERROR_MEMORY;
+    }
+
+    if (!virtio_msg_linux_bridge_state_allows_data(s)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "must-deliver TX while endpoint=%u is not active",
+            s->endpoint_handle);
+        return VIRTIO_MSG_ERROR_RETRY;
+    }
+
+    if (msg_req->type & VIRTIO_MSG_TYPE_BUS) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "reject must-deliver TX bus-class frame msg=%s(0x%x) "
+            "dev=%u token=%u",
+            bridge_msg_id_to_str(msg_req->type, msg_req->msg_id),
+            msg_req->msg_id, le16_to_cpu(msg_req->dev_num),
+            le16_to_cpu(msg_req->token));
+        return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+    }
+
+    if (!virtio_msg_linux_bridge_msg_size_valid(s, msg_size,
+                                                s->tx_ring_info.entry_size)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "reject must-deliver TX msg=%s(0x%x) size=%u "
+            "entry_size=%u max=%u",
+            bridge_msg_id_to_str(msg_req->type, msg_req->msg_id),
+            msg_req->msg_id, msg_size, s->tx_ring_info.entry_size,
+            virtio_msg_linux_bridge_max_msg_size(s));
+        return VIRTIO_MSG_ERROR_BAD_MESSAGE;
+    }
+
+    if (!QTAILQ_EMPTY(&s->pending_tx)) {
+        if (!virtio_msg_linux_bridge_queue_pending_tx(s, msg_req)) {
+            return VIRTIO_MSG_ERROR_MEMORY;
+        }
+        virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+        return VIRTIO_MSG_NO_ERROR;
+    }
+
+    ret = virtio_msg_linux_bridge_send(bd, msg_req);
+    if (ret != VIRTIO_MSG_ERROR_RETRY) {
+        return ret;
+    }
+
+    if (!virtio_msg_linux_bridge_queue_pending_tx(s, msg_req)) {
+        return VIRTIO_MSG_ERROR_MEMORY;
+    }
+    virtio_msg_linux_bridge_schedule_pending_tx_retry(s);
+    return VIRTIO_MSG_NO_ERROR;
+}
