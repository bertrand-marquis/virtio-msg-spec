+static struct vmsg_bridge_uapi_ring_hdr *
+virtio_msg_linux_bridge_ring_hdr(VirtIOMSGLinuxBridge *s,
+                                 const struct vmsg_bridge_uapi_ring_info *ring)
+{
+    return (void *)((uint8_t *)s->rings + ring->offset);
+}
+
+static uint8_t *
+virtio_msg_linux_bridge_ring_entry(struct vmsg_bridge_uapi_ring_hdr *hdr,
+                                   const struct vmsg_bridge_uapi_ring_info
+                                   *ring,
+                                   uint32_t idx)
+{
+    uint8_t *base = (uint8_t *)hdr + sizeof(*hdr);
+
+    return base + ((uint64_t)idx * ring->entry_size);
+}
+
+static uint32_t virtio_msg_linux_bridge_ring_slot_index(uint32_t cursor,
+                                                        uint32_t entries)
+{
+    return cursor % entries;
+}
+
+static uint32_t virtio_msg_linux_bridge_ring_used(uint32_t prod,
+                                                  uint32_t cons)
+{
+    return prod - cons;
+}
+
+static void virtio_msg_linux_bridge_purge_rx_ring(VirtIOMSGLinuxBridge *s)
+{
+    struct vmsg_bridge_uapi_ring_hdr *hdr;
+    uint32_t prod;
+    uint32_t cons;
+    uint32_t used;
+
+    if (!s->rings) {
+        return;
+    }
+
+    hdr = virtio_msg_linux_bridge_ring_hdr(s, &s->rx_ring_info);
+    prod = qatomic_load_acquire(&hdr->prod);
+    cons = qatomic_read(&hdr->cons);
+    used = virtio_msg_linux_bridge_ring_used(prod, cons);
+    if (used == 0) {
+        return;
+    }
+
+    qatomic_store_release(&hdr->cons, prod);
+}
