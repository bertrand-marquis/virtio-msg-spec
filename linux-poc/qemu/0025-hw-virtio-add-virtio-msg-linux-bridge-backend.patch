+static bool virtio_msg_linux_bridge_ring_valid(uint32_t entries,
+                                               uint32_t entry_size)
+{
+    uint32_t min_entry_size = QEMU_ALIGN_UP(VIRTIO_MSG_MAX_SIZE,
+                                            VMSG_BRIDGE_UAPI_RING_ENTRY_ALIGN);
+
+    /* Mirror the current v1 bridge UAPI requirement: exactly 256 entries. */
+    return entries == VIRTIO_MSG_LINUX_BRIDGE_RING_ENTRIES_DEFAULT &&
+        entry_size >= min_entry_size &&
+        entry_size % VMSG_BRIDGE_UAPI_RING_ENTRY_ALIGN == 0;
+}
+
+static uint32_t virtio_msg_linux_bridge_max_msg_size(VirtIOMSGLinuxBridge *s)
+{
+    uint32_t max_msg_size = s->vmm_max_msg_size;
+    uint32_t endpoint_max_msg_size = s->endpoint_max_msg_size;
+
+    if (!max_msg_size) {
+        max_msg_size = VIRTIO_MSG_MAX_SIZE;
+    }
+    if (!endpoint_max_msg_size) {
+        return max_msg_size;
+    }
+
+    return MIN(max_msg_size, endpoint_max_msg_size);
+}
+
+static uint32_t virtio_msg_linux_bridge_aligned_max_msg_size(
+    uint32_t max_msg_size)
+{
+    return QEMU_ALIGN_UP(max_msg_size, VMSG_BRIDGE_UAPI_RING_ENTRY_ALIGN);
+}
+
+static bool virtio_msg_linux_bridge_entry_size_matches_vmm_max(
+    VirtIOMSGLinuxBridge *s, uint32_t entry_size)
+{
+    uint32_t aligned_max = virtio_msg_linux_bridge_aligned_max_msg_size(
+        s->vmm_max_msg_size);
+
+    return entry_size == aligned_max &&
+        entry_size % VMSG_BRIDGE_UAPI_RING_ENTRY_ALIGN == 0;
+}
+
+static bool virtio_msg_linux_bridge_msg_size_valid(VirtIOMSGLinuxBridge *s,
+                                                   uint16_t msg_size,
+                                                   uint32_t entry_size)
+{
+    uint32_t max_size = virtio_msg_linux_bridge_max_msg_size(s);
+
+    return msg_size >= virtio_msg_header_size() &&
+           msg_size <= max_size &&
+           msg_size <= entry_size;
+}
+
+static size_t bridge_local_min_msg_size(void)
+{
+    size_t map_add_req_size = sizeof(struct virtio_msg_bus_bridge_map_add_req);
+    size_t map_add_resp_size =
+        sizeof(struct virtio_msg_bus_bridge_map_add_resp);
+
+    return virtio_msg_header_size() +
+           MAX(map_add_req_size, map_add_resp_size);
+}
+
+static bool virtio_msg_linux_bridge_bridge_local_size_valid(
+    VirtIOMSGLinuxBridge *s)
+{
+    size_t min_size = bridge_local_min_msg_size();
+
+    return s->vmm_max_msg_size >= min_size &&
+           virtio_msg_linux_bridge_max_msg_size(s) >= min_size;
+}
