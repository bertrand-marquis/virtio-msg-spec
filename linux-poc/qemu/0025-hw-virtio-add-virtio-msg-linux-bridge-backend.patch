+    virtio_msg_linux_bridge_cancel_pending_tx_retry(s);
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    qemu_bh_delete(s->map_completion_bh);
+    s->map_completion_bh = NULL;
+    qemu_bh_delete(s->map_reclaim_bh);
+    s->map_reclaim_bh = NULL;
+    timer_free(s->map_add_defer_timer);
+    s->map_add_defer_timer = NULL;
+    timer_free(s->pending_tx_retry_timer);
+    s->pending_tx_retry_timer = NULL;
