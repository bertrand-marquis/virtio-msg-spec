+static bool virtio_msg_linux_bridge_errno_is_transient(int err)
+{
+    switch (err) {
+    case EAGAIN:
+#ifdef EWOULDBLOCK
+#if EWOULDBLOCK != EAGAIN
+    case EWOULDBLOCK:
+#endif
+#endif
+    case ENOSPC:
+    case ENOMEM:
+    case EBUSY:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool virtio_msg_linux_bridge_errno_is_terminal(int err)
+{
+    switch (err) {
+    case ENOTCONN:
+    case EPROTO:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static int virtio_msg_linux_bridge_receive_error_to_errno(int ret)
+{
+    switch (ret) {
+    case VIRTIO_MSG_ERROR_RETRY:
+        return -EAGAIN;
+    case VIRTIO_MSG_ERROR_NO_DEVICE:
+        return -ENODEV;
+    case VIRTIO_MSG_ERROR_UNSUPPORTED_MESSAGE_ID:
+        return -EOPNOTSUPP;
+    case VIRTIO_MSG_ERROR_BAD_MESSAGE:
+        return -EPROTO;
+    case VIRTIO_MSG_ERROR_MEMORY:
+        return -ENOMEM;
+    case VIRTIO_MSG_ERROR_TIMEOUT:
+        return -ETIMEDOUT;
+    case VIRTIO_MSG_NO_ERROR:
+        return 0;
+    default:
+        return -EIO;
+    }
+}
+
+static bool virtio_msg_linux_bridge_is_transport_request(const VirtIOMSG *msg)
+{
+    /*
+     * Transport message IDs use bit 6 to distinguish requests from events:
+     * 0x00-0x3f and 0x80-0xbf are requests, while 0x40-0x7f and 0xc0-0xff
+     * are events. Responses and bus traffic are excluded separately.
+     */
+    return !(msg->type & (VIRTIO_MSG_TYPE_BUS | VIRTIO_MSG_TYPE_RESPONSE)) &&
+           !(msg->msg_id & VIRTIO_MSG_EVENT_CONFIG);
+}
+
+static int virtio_msg_linux_bridge_report_msg_error(VirtIOMSGLinuxBridge *s,
+                                                    const VirtIOMSG *msg,
+                                                    int ret)
+{
+    VirtIOMSG error_msg = { 0 };
+    int report_error = virtio_msg_linux_bridge_receive_error_to_errno(ret);
+
+    g_assert(report_error < 0);
+
+    virtio_msg_linux_bridge_pack_error(&error_msg, le16_to_cpu(msg->token),
+                                       le16_to_cpu(msg->dev_num),
+                                       msg->msg_id, report_error);
+
+    s->rx_bridge_error_msg = error_msg;
+    s->rx_bridge_error_pending = true;
+
+    return virtio_msg_linux_bridge_emit_pending_rx_bridge_error(s);
+}
+
+static int virtio_msg_linux_bridge_emit_pending_rx_bridge_error(
+    VirtIOMSGLinuxBridge *s)
+{
+    int send_ret;
+
+    if (!s->rx_bridge_error_pending) {
+        return 0;
+    }
+
+    if (virtio_msg_linux_bridge_can_flush_pending_tx(s)) {
+        virtio_msg_linux_bridge_flush_pending_tx(s, true);
+    }
+
+    if (!QTAILQ_EMPTY(&s->pending_tx)) {
+        return -EAGAIN;
+    }
+
+    send_ret = virtio_msg_linux_bridge_send_pending_tx(
+        s, &s->rx_bridge_error_msg);
+    if (send_ret == VIRTIO_MSG_NO_ERROR) {
+        virtio_msg_linux_bridge_clear_rx_bridge_error(s);
+        virtio_msg_linux_bridge_reset_pending_tx_retry_delay(s);
+        return 0;
+    }
+
+    switch (send_ret) {
+    case VIRTIO_MSG_ERROR_RETRY:
+        return -EAGAIN;
+    case VIRTIO_MSG_ERROR_BAD_MESSAGE:
+        return -EPROTO;
+    case VIRTIO_MSG_ERROR_NO_DEVICE:
+        return -ENOTCONN;
+    case VIRTIO_MSG_ERROR_MEMORY:
+    default:
+        return -ENOMEM;
+    }
+}
+
+static bool virtio_msg_linux_bridge_parse_endpoint(VirtIOMSGLinuxBridge *s,
+                                                   Error **errp)
+{
+    struct vmsg_bridge_uapi_endpoint_addr addr = { 0 };
+    const char *endpoint = s->endpoint;
+    const char *sep;
+    const char *bus_id = "";
+    size_t bus_name_len;
+    size_t bus_id_len;
+
+    if (!endpoint || !endpoint[0]) {
+        error_setg(errp, "endpoint is required and must not be empty");
+        return false;
+    }
+
+    sep = strchr(endpoint, ':');
+    bus_name_len = sep ? (size_t)(sep - endpoint) : strlen(endpoint);
+    if (bus_name_len == 0) {
+        error_setg(errp, "invalid endpoint '%s': bus-name is empty", endpoint);
+        return false;
+    }
+    if (bus_name_len >= VMSG_BRIDGE_UAPI_BUS_NAME_LEN) {
+        error_setg(errp,
+                   "invalid endpoint '%s': bus-name is too long (max %u chars)",
+                   endpoint, VMSG_BRIDGE_UAPI_BUS_NAME_LEN - 1);
+        return false;
+    }
+
+    memcpy(addr.bus_name, endpoint, bus_name_len);
+    if (sep) {
+        bus_id = sep + 1;
+    }
+
+    bus_id_len = strlen(bus_id);
+    if (bus_id_len >= VMSG_BRIDGE_UAPI_BUS_ID_LEN) {
+        error_setg(errp,
+                   "invalid endpoint '%s': bus-id is too long (max %u chars)",
+                   endpoint, VMSG_BRIDGE_UAPI_BUS_ID_LEN - 1);
+        return false;
+    }
+    memcpy(addr.bus_id, bus_id, bus_id_len);
+
+    s->endpoint_addr = addr;
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_resolve_endpoint(VirtIOMSGLinuxBridge *s,
+                                                     Error **errp)
+{
+    struct vmsg_bridge_uapi_resolve_endpoint resolve = { 0 };
+    int ret;
+
+    resolve.addr = s->endpoint_addr;
+    resolve.flags = s->create_endpoint ?
+        VMSG_BRIDGE_UAPI_RESOLVE_F_CREATE : 0;
+    ret = virtio_msg_linux_bridge_ioctl(s->dev_fd,
+                                        VMSG_BRIDGE_IOCTL_RESOLVE_ENDPOINT,
+                                        &resolve);
+    if (ret < 0) {
+        error_setg_errno(errp, errno,
+                         "bridge RESOLVE_ENDPOINT failed for endpoint '%s'",
+                         s->endpoint);
+        return false;
+    }
+    if (!resolve.handle) {
+        error_setg(errp,
+                   "bridge RESOLVE_ENDPOINT returned invalid handle 0 "
+                   "for endpoint '%s'",
+                   s->endpoint);
+        return false;
+    }
+
+    s->endpoint_handle = resolve.handle;
+    s->endpoint_resolved = true;
+    trace_virtio_msg_linux_bridge_endpoint_resolve(
+        s->endpoint_handle, s->endpoint, s->create_endpoint);
+    return true;
+}
+
+static void virtio_msg_linux_bridge_release_endpoint(VirtIOMSGLinuxBridge *s)
+{
+    struct vmsg_bridge_uapi_release_endpoint release = { 0 };
+    int ret;
+
+    if (!s->endpoint_resolved || s->dev_fd < 0) {
+        return;
+    }
+
+    release.handle = s->endpoint_handle;
+    ret = virtio_msg_linux_bridge_ioctl(s->dev_fd,
+                                        VMSG_BRIDGE_IOCTL_RELEASE_ENDPOINT,
+                                        &release);
+    if (ret < 0) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "RELEASE_ENDPOINT failed handle=%u: %s",
+            s->endpoint_handle, strerror(errno));
+    } else {
+        trace_virtio_msg_linux_bridge_endpoint_release(s->endpoint_handle);
+    }
+    s->endpoint_resolved = false;
+    s->endpoint_handle = 0;
+}
+
+static void virtio_msg_linux_bridge_release_rings(VirtIOMSGLinuxBridge *s)
+{
+    if (!s->rings) {
+        return;
+    }
+
+    if (munmap(s->rings, s->rings_size) < 0) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR("ring munmap failed: %s",
+                                      strerror(errno));
+    }
+    s->rings = NULL;
+    s->rings_size = 0;
+}
+
+static void
+virtio_msg_linux_bridge_map_cache_invalidate_locked(VirtIOMSGLinuxBridge *s)
+{
+    s->map_last_covering = NULL;
+}
+
+static void virtio_msg_linux_bridge_map_touch_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    s->map_use_seq++;
+    entry->last_use_seq = s->map_use_seq;
+    s->map_last_covering = entry;
+}
+
+static void virtio_msg_linux_bridge_note_live_non_retained_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    if (!entry->retain_hint) {
+        g_assert(s->non_retained_live_bytes <=
+                 UINT64_MAX - entry->mmap_length);
+        qatomic_inc(&s->non_retained_live_count);
+        s->non_retained_live_bytes += entry->mmap_length;
+
+        if (qatomic_read(&s->non_retained_live_count) >=
+            VIRTIO_MSG_LINUX_BRIDGE_MAP_RECLAIM_COUNT_LIMIT ||
+            s->non_retained_live_bytes >=
+            VIRTIO_MSG_LINUX_BRIDGE_MAP_RECLAIM_BYTE_LIMIT) {
+            virtio_msg_linux_bridge_schedule_map_reclaim_locked(s);
+        }
+    }
+}
+
+static void virtio_msg_linux_bridge_forget_live_non_retained_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    if (entry->state != VIRTIO_MSG_LINUX_BRIDGE_MAP_LIVE ||
+        entry->retain_hint) {
+        return;
+    }
+
+    g_assert(qatomic_read(&s->non_retained_live_count) > 0);
+    g_assert(s->non_retained_live_bytes >= entry->mmap_length);
+    qatomic_dec(&s->non_retained_live_count);
+    s->non_retained_live_bytes -= entry->mmap_length;
+}
+
+static bool virtio_msg_linux_bridge_ranges_overlap(uint64_t first_addr,
+                                                   uint64_t first_len,
+                                                   uint64_t second_addr,
+                                                   uint64_t second_len)
+{
+    uint64_t first_end;
+    uint64_t second_end;
+
+    if (!first_len || !second_len) {
+        return false;
+    }
+
+    if (first_addr > UINT64_MAX - first_len ||
+        second_addr > UINT64_MAX - second_len) {
+        return true;
+    }
+
+    first_end = first_addr + first_len;
+    second_end = second_addr + second_len;
+
+    return first_addr < second_end && second_addr < first_end;
+}
+
+static VirtIOMSGLinuxBridgeMapEntry *
+virtio_msg_linux_bridge_find_map_entry_by_identity_any_locked(
+    VirtIOMSGLinuxBridge *s, uint64_t epoch, uint64_t map_seq,
+    uint64_t map_id)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+
+    QTAILQ_FOREACH(entry, &s->map_entries, node) {
+        if (entry->epoch == epoch && entry->map_seq == map_seq &&
+            entry->map_id == map_id) {
+            return entry;
+        }
+    }
+
+    return NULL;
+}
+
+static VirtIOMSGLinuxBridgeMapProtocolRecord *
+virtio_msg_linux_bridge_find_map_protocol_by_identity_locked(
+    VirtIOMSGLinuxBridge *s, uint64_t epoch, uint64_t map_seq,
+    uint64_t map_id)
+{
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+
+    QTAILQ_FOREACH(record, &s->map_protocol_records, node) {
+        if (record->epoch == epoch && record->map_seq == map_seq &&
+            record->map_id == map_id) {
+            return record;
+        }
+    }
+
+    return NULL;
+}
+
+static bool virtio_msg_linux_bridge_map_entry_blocks_add_locked(
+    const VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    switch (entry->state) {
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_INSTALLING:
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_LIVE:
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_REVOKING:
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_FINALIZED:
+        return true;
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_ABSENT:
+        return false;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static bool virtio_msg_linux_bridge_map_protocol_blocks_add_locked(
+    const VirtIOMSGLinuxBridgeMapProtocolRecord *record)
+{
+    switch (record->state) {
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_PENDING:
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_DEL_SEEN:
+    case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_TOMBSTONE:
+        return true;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static VirtIOMSGLinuxBridgeMapProtocolRecord *
+virtio_msg_linux_bridge_find_map_protocol_overlap_locked(
+    VirtIOMSGLinuxBridge *s, uint64_t bus_addr, uint64_t length)
+{
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+
+    QTAILQ_FOREACH(record, &s->map_protocol_records, node) {
+        if (virtio_msg_linux_bridge_map_protocol_blocks_add_locked(record) &&
+            virtio_msg_linux_bridge_ranges_overlap(record->bus_addr,
+                                                   record->length,
+                                                   bus_addr, length)) {
+            return record;
+        }
+    }
+
+    return NULL;
+}
+
+static VirtIOMSGLinuxBridgeMapEntry *
+virtio_msg_linux_bridge_find_map_overlap_locked(
+    VirtIOMSGLinuxBridge *s, uint64_t bus_addr, uint64_t length)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+
+    QTAILQ_FOREACH(entry, &s->map_entries, node) {
+        if (virtio_msg_linux_bridge_map_entry_blocks_add_locked(entry) &&
+            virtio_msg_linux_bridge_ranges_overlap(entry->bus_addr,
+                                                   entry->length,
+                                                   bus_addr, length)) {
+            return entry;
+        }
+    }
+
+    return NULL;
+}
+
+static bool virtio_msg_linux_bridge_revoke_entry_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    if (entry->state == VIRTIO_MSG_LINUX_BRIDGE_MAP_REVOKING ||
+        entry->state == VIRTIO_MSG_LINUX_BRIDGE_MAP_FINALIZED ||
+        entry->state == VIRTIO_MSG_LINUX_BRIDGE_MAP_ABSENT) {
+        return true;
+    }
+
+    if (s->map_last_covering == entry) {
+        virtio_msg_linux_bridge_map_cache_invalidate_locked(s);
+    }
+
+    if (entry->subregion_attached) {
+        memory_region_del_subregion(&s->dma_mr, &entry->mr);
+        entry->subregion_attached = false;
+    }
+
+    virtio_msg_linux_bridge_forget_live_non_retained_locked(s, entry);
+    entry->state = VIRTIO_MSG_LINUX_BRIDGE_MAP_REVOKING;
+    trace_virtio_msg_linux_bridge_map_revoke(
+        s->endpoint_handle, entry->epoch, entry->map_seq, entry->map_id,
+        entry->bus_addr, entry->length);
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_try_finalize_revoked_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    if (entry->state != VIRTIO_MSG_LINUX_BRIDGE_MAP_REVOKING) {
+        return true;
+    }
+
+    if (s->map_last_covering == entry) {
+        virtio_msg_linux_bridge_map_cache_invalidate_locked(s);
+    }
+
+    entry->state = VIRTIO_MSG_LINUX_BRIDGE_MAP_FINALIZED;
+    return true;
+}
+
+static void virtio_msg_linux_bridge_free_finalized_entry_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    if (s->map_last_covering == entry) {
+        virtio_msg_linux_bridge_map_cache_invalidate_locked(s);
+    }
+
+    virtio_msg_linux_bridge_forget_live_non_retained_locked(s, entry);
+    entry->state = VIRTIO_MSG_LINUX_BRIDGE_MAP_ABSENT;
+    QTAILQ_REMOVE(&s->map_entries, entry, node);
+}
+
+static void virtio_msg_linux_bridge_complete_del_req_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    uint64_t epoch = entry->epoch;
+    uint64_t map_id = entry->map_id;
+    uint64_t bus_addr = entry->bus_addr;
+    uint64_t length = entry->length;
+
+    entry->del_req_pending = false;
+    virtio_msg_linux_bridge_try_finalize_revoked_locked(s, entry);
+    virtio_msg_linux_bridge_free_finalized_entry_locked(s, entry);
+    trace_virtio_msg_linux_bridge_map_event_remove(s->endpoint_handle,
+                                                   epoch, map_id, bus_addr,
+                                                   length);
+}
+
+static bool virtio_msg_linux_bridge_protocol_matches_event(
+    const VirtIOMSGLinuxBridgeMapProtocolRecord *record,
+    const VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    return record->epoch == event->epoch &&
+           record->map_seq == event->map_seq &&
+           record->map_id == event->map_id &&
+           record->bus_addr == event->bus_addr &&
+           record->length == event->length;
+}
+
+static VirtIOMSGLinuxBridgeMapProtocolRecord *
+virtio_msg_linux_bridge_find_event_protocol_locked(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+
+    record = virtio_msg_linux_bridge_find_map_protocol_by_identity_locked(
+        s, event->epoch, event->map_seq, event->map_id);
+    if (record &&
+        virtio_msg_linux_bridge_protocol_matches_event(record, event)) {
+        return record;
+    }
+
+    return NULL;
+}
+
+static void virtio_msg_linux_bridge_free_map_protocol_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapProtocolRecord *record)
+{
+    QTAILQ_REMOVE(&s->map_protocol_records, record, node);
+    g_free(record);
+}
+
+static bool virtio_msg_linux_bridge_retire_tombstone_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+
+    record = virtio_msg_linux_bridge_find_event_protocol_locked(s, event);
+    if (!record ||
+        record->state != VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_TOMBSTONE) {
+        return false;
+    }
+
+    trace_virtio_msg_linux_bridge_map_tombstone_del(
+        s->endpoint_handle, record->epoch, record->map_seq, record->map_id,
+        record->bus_addr, record->length);
+    virtio_msg_linux_bridge_free_map_protocol_locked(s, record);
+    event->status = 0;
+    virtio_msg_linux_bridge_trace_map_del(s, event);
+    return true;
+}
+
+static void virtio_msg_linux_bridge_make_release_pending_locked(
+    VirtIOMSGLinuxBridge *s, const VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+
+    record = g_new0(VirtIOMSGLinuxBridgeMapProtocolRecord, 1);
+    record->state = VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_PENDING;
+    record->map_seq = event->map_seq;
+    record->map_id = event->map_id;
+    record->epoch = event->epoch;
+    record->bus_addr = event->bus_addr;
+    record->length = event->length;
+    QTAILQ_INSERT_TAIL(&s->map_protocol_records, record, node);
+}
+
+static bool virtio_msg_linux_bridge_request_release_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry,
+    bool exceptional)
+{
+    if (entry->del_req_pending || entry->release_requested ||
+        entry->state != VIRTIO_MSG_LINUX_BRIDGE_MAP_LIVE) {
+        return false;
+    }
+
+    if (entry->retain_hint && !exceptional) {
+        return false;
+    }
+
+    entry->release_requested = true;
+    trace_virtio_msg_linux_bridge_map_release_pending(
+        s->endpoint_handle, entry->epoch, entry->map_seq, entry->map_id,
+        entry->bus_addr, entry->length, exceptional);
+    virtio_msg_linux_bridge_schedule_map_completion_bh_locked(s);
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_prepare_release_event_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry,
+    VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    if (entry->state == VIRTIO_MSG_LINUX_BRIDGE_MAP_ABSENT ||
+        entry->state == VIRTIO_MSG_LINUX_BRIDGE_MAP_INSTALLING) {
+        return false;
+    }
+
+    *event = (VirtIOMSGLinuxBridgeMapEvent) {
+        .map_seq = entry->map_seq,
+        .map_id = entry->map_id,
+        .epoch = entry->epoch,
+        .bus_addr = entry->bus_addr,
+        .length = entry->length,
+    };
+
+    if (entry->completion_kind ==
+        VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_NONE) {
+        entry->completion_kind =
+            VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_RELEASED;
+        entry->completion_generation = s->map_release_generation;
+        s->map_release_pending_count++;
+    }
+
+    if (entry->state == VIRTIO_MSG_LINUX_BRIDGE_MAP_LIVE &&
+        !virtio_msg_linux_bridge_revoke_entry_locked(s, entry)) {
+        return false;
+    }
+
+    virtio_msg_linux_bridge_try_finalize_revoked_locked(s, entry);
+    entry->release_requested = false;
+    virtio_msg_linux_bridge_free_finalized_entry_locked(s, entry);
+    virtio_msg_linux_bridge_make_release_pending_locked(s, event);
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_exceptional_release_needed(
+    const VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    return entry->retain_hint &&
+           entry->state != VIRTIO_MSG_LINUX_BRIDGE_MAP_INSTALLING &&
+           entry->state != VIRTIO_MSG_LINUX_BRIDGE_MAP_ABSENT;
+}
+
+static bool virtio_msg_linux_bridge_has_pending_map_release_locked(
+    VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+
+    QTAILQ_FOREACH(entry, &s->map_entries, node) {
+        if (entry->release_requested) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static bool virtio_msg_linux_bridge_msg_is_map_released(
+    const VirtIOMSG *msg)
+{
+    return virtio_msg_linux_bridge_msg_is_bridge_local(msg) &&
+           msg->msg_id == VIRTIO_MSG_BUS_BRIDGE_MAP_RELEASED;
+}
+
+static bool virtio_msg_linux_bridge_has_pending_map_released_tx(
+    VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgePendingTx *pending;
+
+    QTAILQ_FOREACH(pending, &s->pending_tx, node) {
+        if (virtio_msg_linux_bridge_msg_is_map_released(&pending->msg)) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static bool virtio_msg_linux_bridge_cleanup_release_pending(
+    VirtIOMSGLinuxBridge *s)
+{
+    bool pending;
+
+    qemu_mutex_lock(&s->map_lock);
+    pending = s->map_release_pending_count ||
+              virtio_msg_linux_bridge_has_pending_map_release_locked(s);
+    qemu_mutex_unlock(&s->map_lock);
+
+    return pending || virtio_msg_linux_bridge_has_pending_map_released_tx(s);
+}
+
+static void virtio_msg_linux_bridge_free_tombstones(VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+    VirtIOMSGLinuxBridgeMapProtocolRecord *next;
+
+    qemu_mutex_lock(&s->map_lock);
+    QTAILQ_FOREACH_SAFE(record, &s->map_protocol_records, node, next) {
+        if (record->state !=
+            VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_TOMBSTONE) {
+            continue;
+        }
+
+        virtio_msg_linux_bridge_free_map_protocol_locked(s, record);
+    }
+    qemu_mutex_unlock(&s->map_lock);
+}
+
+static void virtio_msg_linux_bridge_free_map_protocol_records(
+    VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+    VirtIOMSGLinuxBridgeMapProtocolRecord *next;
+
+    qemu_mutex_lock(&s->map_lock);
+    QTAILQ_FOREACH_SAFE(record, &s->map_protocol_records, node, next) {
+        virtio_msg_linux_bridge_free_map_protocol_locked(s, record);
+    }
+    qemu_mutex_unlock(&s->map_lock);
+}
+
+static void virtio_msg_linux_bridge_unref_bridge_bh(void *opaque)
+{
+    object_unref(OBJECT(opaque));
+}
+
+static void virtio_msg_linux_bridge_unref_map_entry_bh(void *opaque)
+{
+    object_unref(OBJECT(opaque));
+}
+
+static void virtio_msg_linux_bridge_defer_map_entry_unref(
+    VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    /*
+     * Convert the removed list reference into a BH reference so MAP_DEL can
+     * respond before a final unref runs map_finalize() and munmap().
+     */
+    object_ref(OBJECT(entry));
+    object_unref(OBJECT(entry));
+    aio_bh_schedule_oneshot(qemu_get_current_aio_context(),
+                            virtio_msg_linux_bridge_unref_map_entry_bh,
+                            entry);
+}
+
+static void virtio_msg_linux_bridge_map_release_completion_bh(void *opaque)
+{
+    VirtIOMSGLinuxBridgeMapCompletion *completion = opaque;
+    VirtIOMSGLinuxBridge *s = completion->bridge;
+    VirtIOMSGLinuxBridgeMapProtocolRecord *record;
+    bool send_released = false;
+    bool sent = true;
+
+    qemu_mutex_lock(&s->map_lock);
+    if (completion->generation != s->map_release_generation) {
+        qemu_mutex_unlock(&s->map_lock);
+        goto out;
+    }
+
+    record = virtio_msg_linux_bridge_find_event_protocol_locked(
+        s, &completion->event);
+    if (completion->kind ==
+        VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_RELEASED && record) {
+        switch (record->state) {
+        case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_PENDING:
+            record->state = VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_TOMBSTONE;
+            trace_virtio_msg_linux_bridge_map_tombstone(
+                s->endpoint_handle, record->epoch, record->map_seq,
+                record->map_id, record->bus_addr, record->length);
+            send_released = true;
+            break;
+        case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_DEL_SEEN:
+            virtio_msg_linux_bridge_free_map_protocol_locked(s, record);
+            break;
+        case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_TOMBSTONE:
+            break;
+        default:
+            g_assert_not_reached();
+        }
+    }
+    if (s->map_release_pending_count) {
+        s->map_release_pending_count--;
+    }
+    qemu_mutex_unlock(&s->map_lock);
+
+    if (send_released) {
+        sent = virtio_msg_linux_bridge_send_map_released(s,
+                                                         &completion->event);
+    }
+    if (sent) {
+        virtio_msg_linux_bridge_drain_after_delayed_map_response(s);
+    }
+    virtio_msg_linux_bridge_maybe_complete_deferred_cleanup(s);
+
+out:
+    object_unref(OBJECT(s));
+    g_free(completion);
+}
+
+static void virtio_msg_linux_bridge_map_finalize(Object *obj)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry =
+        VIRTIO_MSG_LINUX_BRIDGE_MAP(obj);
+    VirtIOMSGLinuxBridgeMapCompletion *completion;
+    bool ok = true;
+
+    if (entry->host_addr && entry->mmap_length) {
+        if (munmap(entry->host_addr, entry->mmap_length) < 0) {
+            VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                "mapping munmap failed epoch=%" PRIu64
+                " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                " length=0x%" PRIx64 ": %s",
+                entry->epoch, entry->map_id, entry->bus_addr,
+                entry->length, strerror(errno));
+            ok = false;
+        }
+        entry->host_addr = NULL;
+        entry->mmap_length = 0;
+    }
+
+    if (entry->bridge) {
+        trace_virtio_msg_linux_bridge_map_finalize(
+            entry->bridge->endpoint_handle, entry->epoch, entry->map_seq,
+            entry->map_id, entry->bus_addr, entry->length, ok);
+    }
+
+    if (entry->completion_kind ==
+        VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_RELEASED &&
+        entry->bridge) {
+        completion = g_new0(VirtIOMSGLinuxBridgeMapCompletion, 1);
+        completion->bridge = entry->bridge;
+        object_ref(OBJECT(completion->bridge));
+        completion->kind = entry->completion_kind;
+        completion->generation = entry->completion_generation;
+        completion->event = (VirtIOMSGLinuxBridgeMapEvent) {
+            .map_seq = entry->map_seq,
+            .map_id = entry->map_id,
+            .epoch = entry->epoch,
+            .bus_addr = entry->bus_addr,
+            .length = entry->length,
+        };
+        aio_bh_schedule_oneshot(
+            qemu_get_current_aio_context(),
+            virtio_msg_linux_bridge_map_release_completion_bh,
+            completion);
+    }
+
+    if (entry->bridge) {
+        aio_bh_schedule_oneshot(qemu_get_current_aio_context(),
+                                virtio_msg_linux_bridge_unref_bridge_bh,
+                                entry->bridge);
+        entry->bridge = NULL;
+    }
+}
+
+static bool virtio_msg_linux_bridge_map_status_is_failure(
+    const VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    return event->status < 0;
+}
+
+static bool virtio_msg_linux_bridge_msg_is_failed_map_add_resp(
+    const VirtIOMSG *msg)
+{
+    const struct virtio_msg_bus_bridge_map_add_resp *payload;
+    int32_t status;
+
+    if (!virtio_msg_linux_bridge_msg_is_bridge_local(msg) ||
+        msg->msg_id != VIRTIO_MSG_BUS_BRIDGE_MAP_ADD ||
+        !(msg->type & VIRTIO_MSG_TYPE_RESPONSE)) {
+        return false;
+    }
+
+    payload = (const void *)msg->payload_u8;
+    status = (int32_t)le32_to_cpu(payload->status);
+    return status < 0;
+}
+
+static bool virtio_msg_linux_bridge_has_pending_failed_map_add_resp(
+    const VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgePendingTx *pending;
+
+    QTAILQ_FOREACH(pending, &s->pending_tx, node) {
+        if (virtio_msg_linux_bridge_msg_is_failed_map_add_resp(
+                &pending->msg)) {
+            return true;
+        }
+    }
+
+    return false;
+}
+
+static void virtio_msg_linux_bridge_reset_map_add_defer_delay(
+    VirtIOMSGLinuxBridge *s)
+{
+    s->map_add_defer_delay_ms =
+        VIRTIO_MSG_LINUX_BRIDGE_MAP_ADD_DEFER_DELAY_MIN_MS;
+}
+
+static void virtio_msg_linux_bridge_grow_map_add_defer_delay(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (!s->map_add_defer_delay_ms) {
+        virtio_msg_linux_bridge_reset_map_add_defer_delay(s);
+        return;
+    }
+
+    if (s->map_add_defer_delay_ms <
+        VIRTIO_MSG_LINUX_BRIDGE_MAP_ADD_DEFER_DELAY_MAX_MS) {
+        s->map_add_defer_delay_ms = MIN(
+            s->map_add_defer_delay_ms * 2,
+            VIRTIO_MSG_LINUX_BRIDGE_MAP_ADD_DEFER_DELAY_MAX_MS);
+    }
+}
+
+static void virtio_msg_linux_bridge_schedule_map_add_defer(
+    VirtIOMSGLinuxBridge *s)
+{
+    int64_t now;
+
+    if (!s->map_add_defer_timer) {
+        return;
+    }
+
+    if (!s->map_add_defer_delay_ms) {
+        virtio_msg_linux_bridge_reset_map_add_defer_delay(s);
+    }
+
+    now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    timer_mod_anticipate(s->map_add_defer_timer,
+                         now + s->map_add_defer_delay_ms);
+    virtio_msg_linux_bridge_grow_map_add_defer_delay(s);
+}
+
+static void virtio_msg_linux_bridge_clear_map_add_defer(
+    VirtIOMSGLinuxBridge *s)
+{
+    s->map_add_deferred = false;
+    memset(&s->map_add_deferred_event, 0, sizeof(s->map_add_deferred_event));
+    s->map_add_defer_failures = 0;
+    if (s->map_add_defer_timer) {
+        timer_del(s->map_add_defer_timer);
+    }
+    virtio_msg_linux_bridge_reset_map_add_defer_delay(s);
+}
+
+static bool virtio_msg_linux_bridge_defer_map_add(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    if (!s->map_add_deferred) {
+        s->map_add_deferred = true;
+        s->map_add_deferred_event = *event;
+        s->map_add_defer_failures = 0;
+        virtio_msg_linux_bridge_reset_map_add_defer_delay(s);
+    }
+
+    s->map_add_defer_failures++;
+    if (s->map_add_defer_failures >=
+        VIRTIO_MSG_LINUX_BRIDGE_MAP_ADD_DEFER_MAX_FAILURES) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject after deferred setup failures map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64
+            " failures=%u",
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length, s->map_add_defer_failures);
+        virtio_msg_linux_bridge_clear_map_add_defer(s);
+        event->status = -EAGAIN;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    virtio_msg_linux_bridge_schedule_map_add_defer(s);
+    return false;
+}
+
+static void virtio_msg_linux_bridge_schedule_map_completion_bh_locked(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (s->map_completion_bh_scheduled || !s->map_completion_bh) {
+        return;
+    }
+
+    s->map_completion_bh_scheduled = true;
+    qemu_bh_schedule(s->map_completion_bh);
+}
+
+static bool virtio_msg_linux_bridge_map_passes_reclaim_policy(
+    const VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    return entry->completion_kind ==
+           VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_NONE;
+}
+
+static bool virtio_msg_linux_bridge_map_reclaim_candidate(
+    const VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    return entry->state == VIRTIO_MSG_LINUX_BRIDGE_MAP_LIVE &&
+           !entry->retain_hint &&
+           !entry->del_req_pending &&
+           !entry->release_requested &&
+           virtio_msg_linux_bridge_map_passes_reclaim_policy(entry);
+}
+
+static void virtio_msg_linux_bridge_schedule_map_reclaim_locked(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (s->map_reclaim_bh_scheduled || !s->map_reclaim_bh) {
+        return;
+    }
+
+    s->map_reclaim_bh_scheduled = true;
+    qemu_bh_schedule(s->map_reclaim_bh);
+}
+
+static void virtio_msg_linux_bridge_schedule_map_reclaim(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (!qatomic_read(&s->non_retained_live_count) ||
+        !s->map_reclaim_bh) {
+        return;
+    }
+
+    qemu_mutex_lock(&s->map_lock);
+    if (qatomic_read(&s->non_retained_live_count) &&
+        !s->map_reclaim_bh_scheduled) {
+        virtio_msg_linux_bridge_schedule_map_reclaim_locked(s);
+    }
+    qemu_mutex_unlock(&s->map_lock);
+}
+
+static void virtio_msg_linux_bridge_reclaim_non_retained_maps(
+    VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+    VirtIOMSGLinuxBridgeMapEntry *candidate = NULL;
+    VirtIOMSGLinuxBridgeMapEvent event;
+    bool pressure;
+
+    qemu_mutex_lock(&s->map_lock);
+    QTAILQ_FOREACH(entry, &s->map_entries, node) {
+        if (!virtio_msg_linux_bridge_map_reclaim_candidate(entry)) {
+            continue;
+        }
+
+        if (!candidate || entry->last_use_seq < candidate->last_use_seq) {
+            candidate = entry;
+        }
+    }
+
+    if (!candidate) {
+        qemu_mutex_unlock(&s->map_lock);
+        return;
+    }
+
+    if (!virtio_msg_linux_bridge_prepare_release_event_locked(
+            s, candidate, &event)) {
+        qemu_mutex_unlock(&s->map_lock);
+        virtio_msg_linux_bridge_fail_attach(s);
+        return;
+    }
+
+    pressure = qatomic_read(&s->non_retained_live_count) >=
+               VIRTIO_MSG_LINUX_BRIDGE_MAP_RECLAIM_COUNT_LIMIT ||
+               s->non_retained_live_bytes >=
+               VIRTIO_MSG_LINUX_BRIDGE_MAP_RECLAIM_BYTE_LIMIT;
+    if (pressure) {
+        virtio_msg_linux_bridge_schedule_map_reclaim_locked(s);
+    }
+
+    qemu_mutex_unlock(&s->map_lock);
+    object_unref(OBJECT(candidate));
+}
+
+static void virtio_msg_linux_bridge_unmap_all(VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+    VirtIOMSGLinuxBridgeMapEntry *next;
+    VirtIOMSGLinuxBridgeMapEvent event;
+
+again:
+    qemu_mutex_lock(&s->map_lock);
+    QTAILQ_FOREACH_SAFE(entry, &s->map_entries, node, next) {
+        entry->del_req_pending = false;
+
+        if (virtio_msg_linux_bridge_exceptional_release_needed(entry)) {
+            if (!entry->release_requested) {
+                virtio_msg_linux_bridge_request_release_locked(s, entry,
+                                                              true);
+            }
+            if (!virtio_msg_linux_bridge_prepare_release_event_locked(
+                    s, entry, &event)) {
+                continue;
+            }
+            qemu_mutex_unlock(&s->map_lock);
+            object_unref(OBJECT(entry));
+            goto again;
+        } else {
+            entry->release_requested = false;
+        }
+
+        virtio_msg_linux_bridge_revoke_entry_locked(s, entry);
+        virtio_msg_linux_bridge_complete_del_req_locked(s, entry);
+        qemu_mutex_unlock(&s->map_lock);
+        object_unref(OBJECT(entry));
+        goto again;
+    }
+    qemu_mutex_unlock(&s->map_lock);
+}
+
+static void virtio_msg_linux_bridge_force_unmap_all(VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+
+    qemu_mutex_lock(&s->map_lock);
+    while ((entry = QTAILQ_FIRST(&s->map_entries))) {
+        entry->del_req_pending = false;
+        entry->release_requested = false;
+        entry->completion_kind = VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_NONE;
+        entry->completion_generation = 0;
+        virtio_msg_linux_bridge_revoke_entry_locked(s, entry);
+        virtio_msg_linux_bridge_try_finalize_revoked_locked(s, entry);
+        virtio_msg_linux_bridge_free_finalized_entry_locked(s, entry);
+        qemu_mutex_unlock(&s->map_lock);
+
+        object_unref(OBJECT(entry));
+
+        qemu_mutex_lock(&s->map_lock);
+    }
+
+    s->map_release_pending_count = 0;
+    qatomic_set(&s->non_retained_live_count, 0);
+    s->non_retained_live_bytes = 0;
+    virtio_msg_linux_bridge_map_cache_invalidate_locked(s);
+    qemu_mutex_unlock(&s->map_lock);
+
+    virtio_msg_linux_bridge_free_map_protocol_records(s);
+}
+
+static bool virtio_msg_linux_bridge_handle_map_event_add(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+    VirtIOMSGLinuxBridgeMapEntry *conflict;
+    VirtIOMSGLinuxBridgeMapProtocolRecord *protocol_entry;
+    VirtIOMSGLinuxBridgeMapProtocolRecord *protocol_conflict;
+    g_autofree char *subregion_name = NULL;
+    uint64_t page_size = qemu_real_host_page_size();
+    void *host_addr;
+    int err;
+
+    if (!event->map_seq || !event->map_id) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject invalid identity map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64,
+            event->map_seq, event->epoch, event->map_id);
+        event->status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    if (!event->length ||
+        !QEMU_IS_ALIGNED(event->bus_addr, page_size) ||
+        !QEMU_IS_ALIGNED(event->length, page_size) ||
+        !QEMU_IS_ALIGNED(event->mmap_offset, page_size) ||
+        event->mmap_length < event->length) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject invalid geometry map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64
+            " mmap_offset=0x%" PRIx64 " mmap_length=0x%" PRIx64
+            " page_size=0x%" PRIx64,
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length, event->mmap_offset, event->mmap_length,
+            page_size);
+        event->status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    if (event->bus_addr > UINT64_MAX - event->length) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject address overflow map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64,
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length);
+        event->status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    if (event->mmap_length > SIZE_MAX) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject mmap_length too large map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " mmap_length=0x%" PRIx64,
+            event->map_seq, event->epoch, event->map_id, event->mmap_length);
+        event->status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    qemu_mutex_lock(&s->map_lock);
+    entry = virtio_msg_linux_bridge_find_map_entry_by_identity_any_locked(
+        s, event->epoch, event->map_seq, event->map_id);
+    protocol_entry =
+        virtio_msg_linux_bridge_find_map_protocol_by_identity_locked(
+            s, event->epoch, event->map_seq, event->map_id);
+    conflict = virtio_msg_linux_bridge_find_map_overlap_locked(
+        s, event->bus_addr, event->length);
+    protocol_conflict =
+        virtio_msg_linux_bridge_find_map_protocol_overlap_locked(
+            s, event->bus_addr, event->length);
+    qemu_mutex_unlock(&s->map_lock);
+    if (entry || protocol_entry || conflict || protocol_conflict) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject duplicate/conflict map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64
+            " duplicate=%d conflict=%d",
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length, entry != NULL || protocol_entry != NULL,
+            conflict != NULL || protocol_conflict != NULL);
+        event->status = -EEXIST;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    host_addr = mmap(NULL, event->mmap_length, PROT_READ | PROT_WRITE,
+                     MAP_SHARED, s->dev_fd, event->mmap_offset);
+    if (host_addr == MAP_FAILED) {
+        host_addr = NULL;
+        err = errno;
+        if (virtio_msg_linux_bridge_errno_is_transient(err)) {
+            return virtio_msg_linux_bridge_defer_map_add(s, event);
+        }
+
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject mmap failed map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " mmap_offset=0x%" PRIx64 " mmap_length=0x%" PRIx64
+            ": %s",
+            event->map_seq, event->epoch, event->map_id, event->mmap_offset,
+            event->mmap_length, strerror(err));
+        event->status = -err;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    qemu_mutex_lock(&s->map_lock);
+    entry = virtio_msg_linux_bridge_find_map_entry_by_identity_any_locked(
+        s, event->epoch, event->map_seq, event->map_id);
+    protocol_entry =
+        virtio_msg_linux_bridge_find_map_protocol_by_identity_locked(
+            s, event->epoch, event->map_seq, event->map_id);
+    conflict = virtio_msg_linux_bridge_find_map_overlap_locked(
+        s, event->bus_addr, event->length);
+    protocol_conflict =
+        virtio_msg_linux_bridge_find_map_protocol_overlap_locked(
+            s, event->bus_addr, event->length);
+    if (entry || protocol_entry || conflict || protocol_conflict) {
+        qemu_mutex_unlock(&s->map_lock);
+        if (munmap(host_addr, event->mmap_length) < 0) {
+            VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                "map ADD cleanup munmap failed: %s", strerror(errno));
+        }
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_ADD reject duplicate/conflict after mmap map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64
+            " duplicate=%d conflict=%d",
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length, entry != NULL || protocol_entry != NULL,
+            conflict != NULL || protocol_conflict != NULL);
+        event->status = -EEXIST;
+        virtio_msg_linux_bridge_trace_map_add(s, event);
+        return true;
+    }
+
+    entry = VIRTIO_MSG_LINUX_BRIDGE_MAP(
+        object_new(TYPE_VIRTIO_MSG_LINUX_BRIDGE_MAP));
+    entry->bridge = s;
+    object_ref(OBJECT(s));
+    entry->state = VIRTIO_MSG_LINUX_BRIDGE_MAP_INSTALLING;
+    entry->map_seq = event->map_seq;
+    entry->map_id = event->map_id;
+    entry->epoch = event->epoch;
+    entry->bus_addr = event->bus_addr;
+    entry->length = event->length;
+    entry->mmap_offset = event->mmap_offset;
+    entry->mmap_length = event->mmap_length;
+    entry->host_addr = host_addr;
+    entry->retain_hint = event->retain_hint;
+    QTAILQ_INSERT_TAIL(&s->map_entries, entry, node);
+    qemu_mutex_unlock(&s->map_lock);
+
+    subregion_name = g_strdup_printf(TYPE_VIRTIO_MSG_LINUX_BRIDGE
+                                     "-dma-map-%" PRIu64 "-%" PRIu64,
+                                     entry->epoch, entry->map_id);
+    memory_region_init_ram_ptr(&entry->mr, OBJECT(entry), subregion_name,
+                               entry->length, entry->host_addr);
+    memory_region_add_subregion(&s->dma_mr, entry->bus_addr,
+                                &entry->mr);
+    qemu_mutex_lock(&s->map_lock);
+    entry->subregion_attached = true;
+    entry->state = VIRTIO_MSG_LINUX_BRIDGE_MAP_LIVE;
+    virtio_msg_linux_bridge_note_live_non_retained_locked(s, entry);
+    virtio_msg_linux_bridge_map_touch_locked(s, entry);
+    qemu_mutex_unlock(&s->map_lock);
+    trace_virtio_msg_linux_bridge_map_event_install(s->endpoint_handle,
+                                                    entry->epoch,
+                                                    entry->map_id,
+                                                    entry->bus_addr,
+                                                    entry->length,
+                                                    entry->mmap_offset,
+                                                    entry->mmap_length);
+    event->status = 0;
+    virtio_msg_linux_bridge_trace_map_add(s, event);
+    virtio_msg_linux_bridge_clear_map_add_defer(s);
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_handle_map_event_del(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEvent *event)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+    VirtIOMSGLinuxBridgeMapProtocolRecord *protocol_entry;
+    uint64_t page_size = qemu_real_host_page_size();
+    bool ok;
+
+    if (!event->map_seq || !event->map_id) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL reject invalid identity map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64,
+            event->map_seq, event->epoch, event->map_id);
+        event->status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_del(s, event);
+        return true;
+    }
+
+    if (!event->length ||
+        !QEMU_IS_ALIGNED(event->bus_addr, page_size) ||
+        !QEMU_IS_ALIGNED(event->length, page_size)) {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL reject invalid geometry map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64
+            " page_size=0x%" PRIx64,
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length, page_size);
+        event->status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_del(s, event);
+        return true;
+    }
+
+    qemu_mutex_lock(&s->map_lock);
+    entry = virtio_msg_linux_bridge_find_map_entry_by_identity_any_locked(
+        s, event->epoch, event->map_seq, event->map_id);
+    protocol_entry =
+        virtio_msg_linux_bridge_find_map_protocol_by_identity_locked(
+            s, event->epoch, event->map_seq, event->map_id);
+    if (!entry && !protocol_entry) {
+        qemu_mutex_unlock(&s->map_lock);
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL reject unknown mapping map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64,
+            event->map_seq, event->epoch, event->map_id);
+        event->status = -ENOENT;
+        virtio_msg_linux_bridge_trace_map_del(s, event);
+        return true;
+    }
+
+    if ((entry &&
+         (entry->bus_addr != event->bus_addr ||
+          entry->length != event->length)) ||
+        (protocol_entry &&
+         (protocol_entry->bus_addr != event->bus_addr ||
+          protocol_entry->length != event->length))) {
+        uint64_t expected_addr = entry ? entry->bus_addr :
+                                 protocol_entry->bus_addr;
+        uint64_t expected_length = entry ? entry->length :
+                                   protocol_entry->length;
+
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL reject identity mismatch map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64
+            " expected_addr=0x%" PRIx64 " expected_length=0x%" PRIx64,
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length, expected_addr, expected_length);
+        qemu_mutex_unlock(&s->map_lock);
+        event->status = -EINVAL;
+        virtio_msg_linux_bridge_trace_map_del(s, event);
+        return true;
+    }
+
+    if (protocol_entry) {
+        switch (protocol_entry->state) {
+        case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_PENDING:
+            protocol_entry->state =
+                VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_DEL_SEEN;
+            event->status = 0;
+            virtio_msg_linux_bridge_trace_map_del(s, event);
+            qemu_mutex_unlock(&s->map_lock);
+            return true;
+        case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_DEL_SEEN:
+            event->status = 0;
+            virtio_msg_linux_bridge_trace_map_del(s, event);
+            qemu_mutex_unlock(&s->map_lock);
+            return true;
+        case VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_TOMBSTONE:
+            virtio_msg_linux_bridge_retire_tombstone_locked(s, event);
+            qemu_mutex_unlock(&s->map_lock);
+            return true;
+        default:
+            g_assert_not_reached();
+        }
+    }
+
+    if (!entry) {
+        qemu_mutex_unlock(&s->map_lock);
+        event->status = -ENOENT;
+        virtio_msg_linux_bridge_trace_map_del(s, event);
+        return true;
+    }
+
+    ok = virtio_msg_linux_bridge_revoke_entry_locked(s, entry);
+    if (!ok) {
+        qemu_mutex_unlock(&s->map_lock);
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "MAP_DEL reject revoke failed map_seq=%" PRIu64
+            " epoch=%" PRIu64 " map_id=%" PRIu64
+            " bus_addr=0x%" PRIx64 " length=0x%" PRIx64,
+            event->map_seq, event->epoch, event->map_id, event->bus_addr,
+            event->length);
+        event->status = -EIO;
+        virtio_msg_linux_bridge_trace_map_del(s, event);
+        return true;
+    }
+
+    if (entry->del_req_pending) {
+        virtio_msg_linux_bridge_complete_del_req_locked(s, entry);
+        qemu_mutex_unlock(&s->map_lock);
+        virtio_msg_linux_bridge_defer_map_entry_unref(entry);
+        event->status = 0;
+        virtio_msg_linux_bridge_trace_map_del(s, event);
+        return true;
+    }
+
+    virtio_msg_linux_bridge_complete_del_req_locked(s, entry);
+    qemu_mutex_unlock(&s->map_lock);
+    virtio_msg_linux_bridge_defer_map_entry_unref(entry);
+
+    event->status = 0;
+    virtio_msg_linux_bridge_trace_map_del(s, event);
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_setup_dma_as(VirtIOMSGLinuxBridge *s)
+{
+    if (s->dma_as_initialized) {
+        return true;
+    }
+
+    memory_region_init(&s->dma_mr, OBJECT(s),
+                       TYPE_VIRTIO_MSG_LINUX_BRIDGE "-dma", UINT64_MAX);
+    address_space_init(&s->dma_as, &s->dma_mr,
+                       TYPE_VIRTIO_MSG_LINUX_BRIDGE "-dma-as");
+    address_space_set_direct_map_only(&s->dma_as, true);
+    s->dma_as_initialized = true;
+    return true;
+}
+
+static void virtio_msg_linux_bridge_reset_transport_caps(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (s->dma_as_initialized) {
+        s->transport_caps.dma_as = &s->dma_as;
+    } else {
+        s->transport_caps.dma_as = &address_space_memory;
+    }
+    s->transport_caps.extra_features = 0;
+    s->transport_caps.transport_features = 0;
+    s->transport_caps.revision = VIRTIO_MSG_LINUX_BRIDGE_REVISION_SUPPORTED;
+    s->transport_caps.max_msg_size = VIRTIO_MSG_MAX_SIZE;
+    s->transport_caps.ready = false;
+    s->vmm_max_msg_size = VIRTIO_MSG_MAX_SIZE;
+    s->endpoint_max_msg_size = 0;
+}
+
+static void virtio_msg_linux_bridge_reset_proxy_transport_caps(
+    VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGProxy *proxy = virtio_msg_linux_bridge_get_proxy(s);
+
+    if (proxy) {
+        virtio_msg_reset_transport_caps(proxy);
+    }
+}
+
+static void virtio_msg_linux_bridge_mark_transport_offline(
+    VirtIOMSGLinuxBridge *s)
+{
+    if (s->dma_as_initialized) {
+        s->transport_caps.dma_as = &s->dma_as;
+    } else {
+        s->transport_caps.dma_as = &address_space_memory;
+    }
+    s->transport_caps.extra_features = 0;
+    s->transport_caps.transport_features = 0;
+    s->transport_caps.revision = VIRTIO_MSG_LINUX_BRIDGE_REVISION_SUPPORTED;
+    s->transport_caps.max_msg_size = VIRTIO_MSG_MAX_SIZE;
+    s->transport_caps.ready = false;
+    virtio_msg_linux_bridge_reset_proxy_transport_caps(s);
+}
+
+static void virtio_msg_linux_bridge_latch_transport_caps(
+    VirtIOMSGLinuxBridge *s)
+{
+    s->transport_caps.dma_as = &s->dma_as;
+    s->transport_caps.extra_features = BIT_ULL(VIRTIO_F_IOMMU_PLATFORM);
+    s->transport_caps.transport_features =
+        virtio_msg_linux_bridge_transport_features_effective(
+            s->caps.transport_features);
+    s->transport_caps.revision = s->caps.revision;
+    s->transport_caps.max_msg_size = virtio_msg_linux_bridge_max_msg_size(s);
+    s->transport_caps.ready = true;
+}
+
+static void virtio_msg_linux_bridge_prepare_initial_attach(
+    VirtIOMSGLinuxBridge *s)
+{
+    s->transport_caps.dma_as = &s->dma_as;
+    s->transport_caps.extra_features = BIT_ULL(VIRTIO_F_IOMMU_PLATFORM);
+    s->transport_caps.transport_features = 0;
+    s->transport_caps.revision = VIRTIO_MSG_LINUX_BRIDGE_REVISION_SUPPORTED;
+    s->transport_caps.max_msg_size = virtio_msg_linux_bridge_max_msg_size(s);
+    s->transport_caps.ready = true;
+    s->initial_attach_pending = true;
+}
+
+static void virtio_msg_linux_bridge_fill_transport_caps(
+    VirtIOMSGBusDevice *bd, VirtIOMSGTransportCaps *caps)
+{
+    VirtIOMSGLinuxBridge *s = VIRTIO_MSG_LINUX_BRIDGE(bd);
+
+    *caps = s->transport_caps;
+}
+
+static void virtio_msg_linux_bridge_release_dma_as(VirtIOMSGLinuxBridge *s)
+{
+    if (!s->dma_as_initialized) {
+        return;
+    }
+
+    virtio_msg_linux_bridge_unmap_all(s);
+    virtio_msg_linux_bridge_free_tombstones(s);
+    address_space_destroy(&s->dma_as);
+    object_unparent(OBJECT(&s->dma_mr));
+    s->dma_as_initialized = false;
+}
+
+static void virtio_msg_linux_bridge_clear_map_event_state(
+    VirtIOMSGLinuxBridge *s)
+{
+    virtio_msg_linux_bridge_clear_map_add_defer(s);
+    if (s->map_completion_bh) {
+        qemu_bh_cancel(s->map_completion_bh);
+    }
+    if (s->map_reclaim_bh) {
+        qemu_bh_cancel(s->map_reclaim_bh);
+    }
+    s->map_del_deferred = false;
+    memset(&s->map_del_deferred_event, 0, sizeof(s->map_del_deferred_event));
+    s->map_completion_bh_scheduled = false;
+    s->map_reclaim_bh_scheduled = false;
+}
+
+static void virtio_msg_linux_bridge_invalidate_map_release_completions(
+    VirtIOMSGLinuxBridge *s)
+{
+    qemu_mutex_lock(&s->map_lock);
+    s->map_release_generation++;
+    qemu_mutex_unlock(&s->map_lock);
+}
+
+static void virtio_msg_linux_bridge_clear_deferred_cleanup(
+    VirtIOMSGLinuxBridge *s)
+{
+    s->deferred_cleanup = VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_NONE;
+    s->deferred_cleanup_release_reason = 0;
+    s->deferred_cleanup_online_epoch = 0;
+    s->deferred_cleanup_max_msg_size = 0;
+    memset(s->deferred_cleanup_bus_name, 0,
+           sizeof(s->deferred_cleanup_bus_name));
+}
+
+static bool virtio_msg_linux_bridge_defer_cleanup(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeDeferredCleanup cleanup,
+    uint32_t release_reason)
+{
+    if (s->deferred_cleanup !=
+        VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_NONE) {
+        return false;
+    }
+
+    s->deferred_cleanup = cleanup;
+    s->deferred_cleanup_release_reason = release_reason;
+    return true;
+}
+
+static void virtio_msg_linux_bridge_defer_endpoint_offline(
+    VirtIOMSGLinuxBridge *s, uint64_t online_epoch, uint32_t reason)
+{
+    if (virtio_msg_linux_bridge_defer_cleanup(
+            s, VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_ENDPOINT_OFFLINE,
+            reason)) {
+        s->deferred_cleanup_online_epoch = online_epoch;
+    }
+}
+
+static void virtio_msg_linux_bridge_defer_enter_online(
+    VirtIOMSGLinuxBridge *s, uint64_t online_epoch, const char *bus_name,
+    uint32_t max_msg_size)
+{
+    if (virtio_msg_linux_bridge_defer_cleanup(
+            s, VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_ENTER_ONLINE, 0)) {
+        s->deferred_cleanup_online_epoch = online_epoch;
+        s->deferred_cleanup_max_msg_size = max_msg_size;
+        memcpy(s->deferred_cleanup_bus_name, bus_name,
+               sizeof(s->deferred_cleanup_bus_name));
+        s->deferred_cleanup_bus_name[VMSG_BRIDGE_UAPI_BUS_NAME_LEN - 1] =
+            '\0';
+    }
+}
+
+static void virtio_msg_linux_bridge_maybe_complete_deferred_cleanup(
+    VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeDeferredCleanup cleanup = s->deferred_cleanup;
+    uint32_t release_reason = s->deferred_cleanup_release_reason;
+    uint64_t online_epoch = s->deferred_cleanup_online_epoch;
+    uint32_t max_msg_size = s->deferred_cleanup_max_msg_size;
+    char bus_name[VMSG_BRIDGE_UAPI_BUS_NAME_LEN];
+    Error *local_err = NULL;
+
+    if (cleanup == VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_NONE ||
+        virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        return;
+    }
+
+    memcpy(bus_name, s->deferred_cleanup_bus_name, sizeof(bus_name));
+    virtio_msg_linux_bridge_clear_deferred_cleanup(s);
+
+    switch (cleanup) {
+    case VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_FAIL_ATTACH:
+        virtio_msg_linux_bridge_fail_attach(s);
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_DETACH:
+        virtio_msg_linux_bridge_detach(s);
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_ENDPOINT_OFFLINE:
+        virtio_msg_linux_bridge_complete_endpoint_offline(
+            s, online_epoch, release_reason);
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_ENTER_ONLINE:
+        if (!virtio_msg_linux_bridge_enter_online(
+                s, online_epoch, bus_name, max_msg_size, &local_err) &&
+            local_err) {
+            error_report_err(local_err);
+        }
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_RELEASE_RESOURCES:
+        virtio_msg_linux_bridge_release_resources(s, release_reason);
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_NONE:
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static bool virtio_msg_linux_bridge_add_migration_blocker(
+    VirtIOMSGLinuxBridge *s, Error **errp)
+{
+    if (s->migration_blocker) {
+        return true;
+    }
+
+    error_setg(&s->migration_blocker,
+               "%s does not support migration: "
+               "bridge session state is host-local",
+               TYPE_VIRTIO_MSG_LINUX_BRIDGE);
+    if (migrate_add_blocker(&s->migration_blocker, errp) < 0) {
+        return false;
+    }
+
+    return true;
+}
+
+static int virtio_msg_linux_bridge_call_fd(const VirtIOMSGLinuxBridge *s)
+{
+    return s->call_initialized ? event_notifier_get_fd(&s->call) : -1;
+}
+
+static void virtio_msg_linux_bridge_unregister_call_handler(
+    VirtIOMSGLinuxBridge *s, const char *event, uint32_t reason)
+{
+    int call_fd = virtio_msg_linux_bridge_call_fd(s);
+
+    if (call_fd < 0) {
+        return;
+    }
+
+    trace_virtio_msg_linux_bridge_fd_event(
+        s->endpoint_handle, event, call_fd, s->session_state, reason);
+    qemu_set_fd_handler(call_fd, NULL, NULL, NULL);
+}
+
+static void virtio_msg_linux_bridge_cleanup_eventfds(VirtIOMSGLinuxBridge *s)
+{
+    if (s->call_initialized) {
+        event_notifier_cleanup(&s->call);
+        s->call_initialized = false;
+    }
+
+    if (s->kick_initialized) {
+        event_notifier_cleanup(&s->kick);
+        s->kick_initialized = false;
+    }
+}
+
+static void virtio_msg_linux_bridge_drain_eventfds(VirtIOMSGLinuxBridge *s)
+{
+    if (s->call_initialized) {
+        event_notifier_test_and_clear(&s->call);
+    }
+
+    if (s->kick_initialized) {
+        event_notifier_test_and_clear(&s->kick);
+    }
+}
+
+static void virtio_msg_linux_bridge_detach_host_now(VirtIOMSGLinuxBridge *s,
+                                                    const char *event,
+                                                    uint32_t reason)
+{
+    int ret;
+
+    virtio_msg_linux_bridge_unregister_call_handler(s, event, reason);
+
+    if (s->attached && s->dev_fd >= 0) {
+        ret = virtio_msg_linux_bridge_ioctl(s->dev_fd,
+                                            VMSG_BRIDGE_IOCTL_DETACH,
+                                            NULL);
+        if (ret < 0) {
+            VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                "DETACH failed endpoint=%u reason=%u: %s",
+                s->endpoint_handle, reason, strerror(errno));
+        } else {
+            trace_virtio_msg_linux_bridge_lifecycle(
+                s->endpoint_handle, event, s->session_state,
+                s->caps.online_epoch, reason);
+        }
+    }
+
+    s->attached = false;
+}
+
+static void virtio_msg_linux_bridge_forced_session_teardown(
+    VirtIOMSGLinuxBridge *s, const char *event, uint32_t reason)
+{
+    virtio_msg_linux_bridge_invalidate_map_release_completions(s);
+    virtio_msg_linux_bridge_detach_host_now(s, event, reason);
+    virtio_msg_linux_bridge_clear_pending_tx(s);
+    virtio_msg_linux_bridge_clear_rx_bridge_error(s);
+    virtio_msg_linux_bridge_clear_deferred_cleanup(s);
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    virtio_msg_linux_bridge_force_unmap_all(s);
+    virtio_msg_linux_bridge_purge_rx_ring(s);
+    virtio_msg_linux_bridge_set_state(
+        s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED);
+}
+
+static void virtio_msg_linux_bridge_fail_attach(VirtIOMSGLinuxBridge *s)
+{
+    int ret;
+    int err;
+
+    virtio_msg_linux_bridge_unregister_call_handler(
+        s, "callfd-remove-fail-attach", 0);
+
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_cleanup(
+            s, VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_FAIL_ATTACH, 0);
+        virtio_msg_linux_bridge_set_state(
+            s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED);
+        return;
+    }
+
+    virtio_msg_linux_bridge_clear_pending_tx(s);
+    virtio_msg_linux_bridge_clear_rx_bridge_error(s);
+    virtio_msg_linux_bridge_purge_rx_ring(s);
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    virtio_msg_linux_bridge_unmap_all(s);
+    if (virtio_msg_linux_bridge_cleanup_release_pending(s)) {
+        virtio_msg_linux_bridge_defer_cleanup(
+            s, VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_FAIL_ATTACH, 0);
+        virtio_msg_linux_bridge_set_state(
+            s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED);
+        return;
+    }
+
+    virtio_msg_linux_bridge_free_tombstones(s);
+    if (s->attached && s->dev_fd >= 0) {
+        ret = virtio_msg_linux_bridge_ioctl(s->dev_fd,
+                                            VMSG_BRIDGE_IOCTL_DETACH,
+                                            NULL);
+        err = (ret < 0) ? errno : 0;
+        if (ret < 0) {
+            VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+                "DETACH failed while entering ATTACHED_FAILED endpoint=%u: %s",
+                s->endpoint_handle, strerror(err));
+        }
+    }
+    s->attached = false;
+    virtio_msg_linux_bridge_release_endpoint(s);
+    virtio_msg_linux_bridge_set_state(
+        s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED);
+}
+
+static void virtio_msg_linux_bridge_release_resources(VirtIOMSGLinuxBridge *s,
+                                                      uint32_t reason)
+{
+    virtio_msg_linux_bridge_forced_session_teardown(
+        s, "callfd-remove-release-resources", reason);
+    virtio_msg_linux_bridge_release_endpoint(s);
+    virtio_msg_linux_bridge_unregister_machine_done_notifier(s);
+
+    migrate_del_blocker(&s->migration_blocker);
+    virtio_msg_linux_bridge_reset_transport_caps(s);
+    virtio_msg_linux_bridge_reset_proxy_transport_caps(s);
+    virtio_msg_linux_bridge_release_dma_as(s);
+    virtio_msg_linux_bridge_release_rings(s);
+    if (s->call_initialized) {
+        trace_virtio_msg_linux_bridge_fd_event(
+            s->endpoint_handle, "callfd-close-release-resources",
+            event_notifier_get_fd(&s->call), s->session_state, reason);
+    }
+    virtio_msg_linux_bridge_cleanup_eventfds(s);
+    virtio_msg_linux_bridge_close_fd(&s->ring_fd);
+    virtio_msg_linux_bridge_close_fd(&s->dev_fd);
+    memset(&s->tx_ring_info, 0, sizeof(s->tx_ring_info));
+    memset(&s->rx_ring_info, 0, sizeof(s->rx_ring_info));
+    memset(&s->endpoint_addr, 0, sizeof(s->endpoint_addr));
+    memset(&s->caps, 0, sizeof(s->caps));
+    s->last_online_epoch = 0;
+    s->map_last_covering = NULL;
+    s->map_use_seq = 0;
+    s->endpoint_handle = 0;
+    s->endpoint_resolved = false;
+    s->last_online_epoch = 0;
+    s->attached = false;
+    s->initial_attach_pending = false;
+    s->machine_ready = false;
+    virtio_msg_linux_bridge_clear_map_event_state(s);
+    virtio_msg_linux_bridge_set_state(
+        s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED);
+}
+
+static void virtio_msg_linux_bridge_reset_devices(VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGProxy *proxy = s->parent_obj.opaque;
+    uint16_t i;
+
+    if (!proxy) {
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(proxy->devs); i++) {
+        VirtIODevice *vdev = virtio_bus_get_device(&proxy->devs[i].bus);
+
+        if (!vdev) {
+            continue;
+        }
+
+        virtio_bus_reset(&proxy->devs[i].bus);
+        proxy->devs[i].guest_features = 0;
+    }
+}
+
+static VirtIOMSGProxy *virtio_msg_linux_bridge_get_proxy(
+    VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGProxy *proxy = s->parent_obj.opaque;
+    BusState *bus;
+    DeviceState *parent;
+
+    if (proxy) {
+        return proxy;
+    }
+
+    bus = qdev_get_parent_bus(DEVICE(s));
+    if (!bus || !bus->parent) {
+        return NULL;
+    }
+
+    parent = bus->parent;
+    if (!object_dynamic_cast(OBJECT(parent), TYPE_VIRTIO_MSG)) {
+        return NULL;
+    }
+
+    return VIRTIO_MSG(parent);
+}
+
+static void virtio_msg_linux_bridge_build_device_bitmap(VirtIOMSGLinuxBridge *s,
+                                                        uint8_t *bitmap)
+{
+    VirtIOMSGProxy *proxy = virtio_msg_linux_bridge_get_proxy(s);
+    uint16_t dev_num;
+
+    memset(bitmap, 0, VIRTIO_MSG_LINUX_BRIDGE_TOPOLOGY_BITMAP_BYTES);
+    if (!proxy) {
+        return;
+    }
+
+    for (dev_num = 0; dev_num < VIRTIO_MSG_MAX_DEVS; dev_num++) {
+        VirtIODevice *vdev = virtio_bus_get_device(&proxy->devs[dev_num].bus);
+
+        if (!vdev) {
+            continue;
+        }
+
+        bitmap[dev_num / 8] |= (1U << (dev_num % 8));
+    }
+}
+
+static bool virtio_msg_linux_bridge_publish_topology(
+    VirtIOMSGLinuxBridge *s, int *errnop, Error **errp)
+{
+    uint8_t bitmap[VIRTIO_MSG_LINUX_BRIDGE_TOPOLOGY_BITMAP_BYTES];
+    uint64_t online_epoch = s->caps.online_epoch;
+    uint16_t num_devs = 0;
+    uint16_t dev_num;
+    VirtIOMSG msg = { 0 };
+    int ret;
+
+    virtio_msg_linux_bridge_build_device_bitmap(s, bitmap);
+
+    virtio_msg_linux_bridge_pack_topology_reset(&msg, online_epoch);
+    ret = virtio_msg_linux_bridge_send_bridge_local_must_deliver(s, &msg);
+    if (ret != VIRTIO_MSG_NO_ERROR) {
+        goto out_error;
+    }
+
+    for (dev_num = 0; dev_num < VIRTIO_MSG_MAX_DEVS; dev_num++) {
+        if (!(bitmap[dev_num / 8] & (1U << (dev_num % 8)))) {
+            continue;
+        }
+
+        virtio_msg_linux_bridge_pack_topology_dev_add(&msg, online_epoch,
+                                                    dev_num);
+        ret = virtio_msg_linux_bridge_send_bridge_local_must_deliver(s, &msg);
+        if (ret != VIRTIO_MSG_NO_ERROR) {
+            goto out_error;
+        }
+        num_devs++;
+    }
+
+    virtio_msg_linux_bridge_pack_topology_commit(&msg, online_epoch, num_devs);
+    ret = virtio_msg_linux_bridge_send_bridge_local_must_deliver(s, &msg);
+    if (ret == VIRTIO_MSG_NO_ERROR) {
+        trace_virtio_msg_linux_bridge_lifecycle(
+            s->endpoint_handle, "topology-published", s->session_state,
+            online_epoch, num_devs);
+        if (errnop) {
+            *errnop = 0;
+        }
+        return true;
+    }
+
+out_error:
+    if (errnop) {
+        *errnop = ret == VIRTIO_MSG_ERROR_RETRY ? EAGAIN : EPROTO;
+    }
+    if (errp) {
+        error_setg(errp, "bridge topology TX failed: %s",
+                   virtio_msg_linux_bridge_result_to_str(ret));
+    } else {
+        VIRTIO_MSG_LINUX_BRIDGE_ERROR(
+            "topology TX failed: %s",
+            virtio_msg_linux_bridge_result_to_str(ret));
+    }
+    return false;
+}
+
+static bool virtio_msg_linux_bridge_maybe_publish_topology(
+    VirtIOMSGLinuxBridge *s, Error **errp)
+{
+    int publish_errno = 0;
+
+    if (!s->attached || !s->machine_ready ||
+        !virtio_msg_linux_bridge_state_allows_topology(s)) {
+        return true;
+    }
+
+    if (!QTAILQ_EMPTY(&s->pending_tx)) {
+        return true;
+    }
+
+    if (!virtio_msg_linux_bridge_publish_topology(
+            s, &publish_errno, NULL)) {
+        if (virtio_msg_linux_bridge_errno_is_terminal(publish_errno)) {
+            if (errp) {
+                error_setg_errno(errp, publish_errno,
+                                 "bridge topology TX failed");
+            }
+            virtio_msg_linux_bridge_fail_attach(s);
+            return false;
+        }
+
+        if (virtio_msg_linux_bridge_errno_is_transient(publish_errno)) {
+            return true;
+        }
+
+        if (errp) {
+            error_setg_errno(errp, publish_errno,
+                             "bridge topology TX failed");
+        }
+        return false;
+    }
+
+    if (QTAILQ_EMPTY(&s->pending_tx)) {
+        virtio_msg_linux_bridge_set_state(
+            s, VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE);
+    }
+    return true;
+}
+
+static void virtio_msg_linux_bridge_machine_done(Notifier *notifier, void *data)
+{
+    VirtIOMSGLinuxBridge *s = container_of(notifier, VirtIOMSGLinuxBridge,
+                                           machine_done);
+    Error *local_err = NULL;
+
+    (void)data;
+    s->machine_ready = true;
+    trace_virtio_msg_linux_bridge_lifecycle(
+        s->endpoint_handle, "machine-ready", s->session_state,
+        s->caps.online_epoch, 0);
+    if (!virtio_msg_linux_bridge_maybe_publish_topology(s, &local_err)) {
+        error_report_err(local_err);
+    }
+}
