+static const Property virtio_msg_linux_bridge_properties[] = {
+    DEFINE_PROP_STRING("endpoint", VirtIOMSGLinuxBridge, endpoint),
+    DEFINE_PROP_BOOL("create-endpoint", VirtIOMSGLinuxBridge,
