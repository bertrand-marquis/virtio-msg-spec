References: <55d56a174a0f04520d4a1558630bb0b739074b13.1779975966.git.bertrand.marquis@arm.com>
From: Bertrand Marquis <bertrand.marquis@arm.com>
Date: Thu, 16 Apr 2026 19:30:47 +0200
Subject: [PATCH 25/30] hw/virtio: add virtio-msg linux bridge backend

Add the linux bridge backend that connects virtio-msg requests to the
host bridge device and maintains dynamic DMA map state.

Implement realize, reset, runtime paths, property handling, and build
wiring under hw/virtio for the bridge backend.

Fold the bridge log ownership and reduced trace surface into this patch
so backend diagnostics land in their final RFC form.

Signed-off-by: Bertrand Marquis <bertrand.marquis@arm.com>
---
 hw/virtio/Kconfig                   |    6 +
 hw/virtio/meson.build               |    2 +
 hw/virtio/trace-events              |   26 +
 hw/virtio/virtio-msg-linux-bridge.c | 5012 +++++++++++++++++++++++++++
 include/hw/virtio/virtio-msg-prot.h |    1 +
 include/hw/virtio/virtio-msg.h      |    4 +-
 6 files changed, 5050 insertions(+), 1 deletion(-)
 create mode 100644 hw/virtio/virtio-msg-linux-bridge.c

diff --git a/hw/virtio/Kconfig b/hw/virtio/Kconfig
index f362c50c59a6..1baf39127c62 100644
--- a/hw/virtio/Kconfig
+++ b/hw/virtio/Kconfig
@@ -30,6 +30,12 @@ config VIRTIO_MSG
     bool
     select VIRTIO
 
+config VIRTIO_MSG_LINUX_BRIDGE
+    bool
+    default y
+    depends on VIRTIO_MSG
+    depends on LINUX
+
 config VIRTIO_CCW
     bool
     select VIRTIO
diff --git a/hw/virtio/meson.build b/hw/virtio/meson.build
index a5b9234df1f9..f19fc132818b 100644
--- a/hw/virtio/meson.build
+++ b/hw/virtio/meson.build
@@ -17,6 +17,8 @@ specific_virtio_ss.add(when: 'CONFIG_VIRTIO_MSG', if_true: files(
