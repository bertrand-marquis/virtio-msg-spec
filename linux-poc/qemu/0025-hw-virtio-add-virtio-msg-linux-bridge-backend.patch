+static void virtio_msg_linux_bridge_set_state(
+    VirtIOMSGLinuxBridge *s,
+    VirtIOMSGLinuxBridgeSessionState state)
+{
+    s->session_state = state;
+
+    switch (state) {
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_NEEDS_TOPOLOGY:
+        s->caps.flags |= VMSG_BRIDGE_UAPI_CAP_F_ENDPOINT_ONLINE;
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE:
+        s->caps.flags |= VMSG_BRIDGE_UAPI_CAP_F_ENDPOINT_ONLINE;
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED:
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_OFFLINE:
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED:
+        s->caps.flags &= ~VMSG_BRIDGE_UAPI_CAP_F_ENDPOINT_ONLINE;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
