+virtio_msg_linux_bridge_bridge_local_rx(uint32_t endpoint_id, uint8_t msg_id, uint8_t type, uint16_t dev_num, uint16_t token, uint16_t msg_size) "ep=%u msg_id=0x%02x type=0x%02x dev=%u token=%u size=%u"
+virtio_msg_linux_bridge_bridge_local_tx(uint32_t endpoint_id, uint8_t msg_id, uint8_t type, uint16_t dev_num, uint16_t token, uint16_t msg_size) "ep=%u msg_id=0x%02x type=0x%02x dev=%u token=%u size=%u"
