+virtio_msg_linux_bridge_pending_tx_drop(uint32_t endpoint_id, uint8_t msg_id, uint8_t type, uint16_t dev_num, uint16_t token, int ret, uint32_t retries, bool fail_attach) "ep=%u msg_id=0x%02x type=0x%02x dev=%u token=%u ret=%d retries=%u fail-attach=%d"
+
 # virtio-rng.c
 virtio_rng_guest_not_ready(void *rng) "rng %p: guest not ready"
