+#define TYPE_VIRTIO_MSG_LINUX_BRIDGE "virtio-msg-linux-bridge"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtIOMSGLinuxBridge, VIRTIO_MSG_LINUX_BRIDGE)
+
+#define TYPE_VIRTIO_MSG_LINUX_BRIDGE_MAP "virtio-msg-linux-bridge-map"
+OBJECT_DECLARE_SIMPLE_TYPE(VirtIOMSGLinuxBridgeMapEntry,
+                           VIRTIO_MSG_LINUX_BRIDGE_MAP)
+
+#define VIRTIO_MSG_LINUX_BRIDGE_DEVNODE_DEFAULT "/dev/virtio-msg-bridge"
+/*
+ * Keep these defaults aligned with vmsg_bus UAPI defaults:
+ * VMSG_BRIDGE_UAPI_RING_ENTRY_ALIGN and
+ * VMSG_BRIDGE_UAPI_RING_ENTRIES_DEFAULT.
+ */
+#define VIRTIO_MSG_LINUX_BRIDGE_RING_ENTRY_SIZE_DEFAULT VIRTIO_MSG_MAX_SIZE
+#define VIRTIO_MSG_LINUX_BRIDGE_RING_ENTRIES_DEFAULT 256U
+#define VIRTIO_MSG_LINUX_BRIDGE_REVISION_SUPPORTED \
+    VIRTIO_MSG_TRANSPORT_REVISION
+#define VIRTIO_MSG_LINUX_BRIDGE_TOPOLOGY_BITMAP_BYTES \
+    ((VIRTIO_MSG_MAX_DEVS + 7) / 8)
+#define VIRTIO_MSG_LINUX_BRIDGE_PEER_REASON_READY 1U
+#define VIRTIO_MSG_LINUX_BRIDGE_PEER_REASON_DOWN  2U
+#define VIRTIO_MSG_LINUX_BRIDGE_RELEASE_REASON_REALIZE_ERROR 1U
+#define VIRTIO_MSG_LINUX_BRIDGE_RELEASE_REASON_UNREALIZE     2U
+#define VIRTIO_MSG_LINUX_BRIDGE_FD_KIND_CALL                 1U
+#define VIRTIO_MSG_LINUX_BRIDGE_FD_KIND_KICK                 2U
+#define VIRTIO_MSG_LINUX_BRIDGE_FD_KIND_RING                 3U
+#define VIRTIO_MSG_LINUX_BRIDGE_FD_KIND_DEV                  4U
+#define VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_DELAY_MIN_MS \
+    1U
+#define VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_DELAY_MAX_MS \
+    200U
+#define VIRTIO_MSG_LINUX_BRIDGE_PENDING_TX_RETRY_MAX_FAILURES \
+    8U
+#define VIRTIO_MSG_LINUX_BRIDGE_MAP_ADD_DEFER_DELAY_MIN_MS \
+    1U
+#define VIRTIO_MSG_LINUX_BRIDGE_MAP_ADD_DEFER_DELAY_MAX_MS \
+    200U
+#define VIRTIO_MSG_LINUX_BRIDGE_MAP_ADD_DEFER_MAX_FAILURES \
+    8U
+#define VIRTIO_MSG_LINUX_BRIDGE_MAP_RECLAIM_COUNT_LIMIT \
+    VIRTIO_MSG_LINUX_BRIDGE_RING_ENTRIES_DEFAULT
+#define VIRTIO_MSG_LINUX_BRIDGE_MAP_RECLAIM_BYTE_LIMIT \
+    (64ULL * 1024 * 1024)
+
+typedef enum VirtIOMSGLinuxBridgeMapLifecycleState {
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_ABSENT = 0,
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_INSTALLING,
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_LIVE,
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_REVOKING,
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_FINALIZED,
+} VirtIOMSGLinuxBridgeMapLifecycleState;
+
+typedef enum VirtIOMSGLinuxBridgeMapCompletionKind {
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_NONE = 0,
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_COMPLETE_RELEASED,
+} VirtIOMSGLinuxBridgeMapCompletionKind;
+
+typedef enum VirtIOMSGLinuxBridgeMapProtocolState {
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_PENDING = 0,
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_RELEASE_DEL_SEEN,
+    VIRTIO_MSG_LINUX_BRIDGE_MAP_PROTOCOL_TOMBSTONE,
+} VirtIOMSGLinuxBridgeMapProtocolState;
+
+typedef enum VirtIOMSGLinuxBridgeDeferredCleanup {
+    VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_NONE = 0,
+    VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_FAIL_ATTACH,
+    VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_DETACH,
+    VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_ENDPOINT_OFFLINE,
+    VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_ENTER_ONLINE,
+    VIRTIO_MSG_LINUX_BRIDGE_DEFERRED_CLEANUP_RELEASE_RESOURCES,
+} VirtIOMSGLinuxBridgeDeferredCleanup;
+
+typedef struct VirtIOMSGLinuxBridgeMapEvent VirtIOMSGLinuxBridgeMapEvent;
+struct VirtIOMSGLinuxBridgeMapEvent {
+    uint16_t token;
+    int32_t status;
+    uint64_t map_seq;
+    uint64_t map_id;
+    uint64_t epoch;
+    uint64_t bus_addr;
+    uint64_t length;
+    uint64_t mmap_offset;
+    uint64_t mmap_length;
+    uint32_t flags;
+    bool retain_hint;
+};
+
+typedef struct VirtIOMSGLinuxBridgeMapCompletion
+    VirtIOMSGLinuxBridgeMapCompletion;
+typedef struct VirtIOMSGLinuxBridgeMapProtocolRecord
+    VirtIOMSGLinuxBridgeMapProtocolRecord;
+
+struct VirtIOMSGLinuxBridgeMapEntry {
+    Object parent_obj;
+    QTAILQ_ENTRY(VirtIOMSGLinuxBridgeMapEntry) node;
+    VirtIOMSGLinuxBridge *bridge;
+    VirtIOMSGLinuxBridgeMapLifecycleState state;
+    VirtIOMSGLinuxBridgeMapCompletionKind completion_kind;
+    uint64_t completion_generation;
+    uint64_t map_seq;
+    uint64_t map_id;
+    uint64_t epoch;
+    uint64_t bus_addr;
+    uint64_t length;
+    uint64_t mmap_offset;
+    uint64_t mmap_length;
+    uint64_t last_use_seq;
+    void *host_addr;
+    MemoryRegion mr;
+    bool subregion_attached;
+    bool del_req_pending;
+    bool retain_hint;
+    bool release_requested;
+};
+
+struct VirtIOMSGLinuxBridgeMapCompletion {
+    VirtIOMSGLinuxBridge *bridge;
+    VirtIOMSGLinuxBridgeMapCompletionKind kind;
+    uint64_t generation;
+    VirtIOMSGLinuxBridgeMapEvent event;
+};
+
+struct VirtIOMSGLinuxBridgeMapProtocolRecord {
+    QTAILQ_ENTRY(VirtIOMSGLinuxBridgeMapProtocolRecord) node;
+    VirtIOMSGLinuxBridgeMapProtocolState state;
+    uint64_t map_seq;
+    uint64_t map_id;
+    uint64_t epoch;
+    uint64_t bus_addr;
+    uint64_t length;
+};
+
+typedef struct VirtIOMSGLinuxBridgePendingTx VirtIOMSGLinuxBridgePendingTx;
+struct VirtIOMSGLinuxBridgePendingTx {
+    QTAILQ_ENTRY(VirtIOMSGLinuxBridgePendingTx) node;
+    VirtIOMSG msg;
+    uint32_t retry_failures;
+};
+
+typedef enum VirtIOMSGLinuxBridgeSessionState {
+    VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED = 0,
+    VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_OFFLINE,
+    VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_NEEDS_TOPOLOGY,
+    VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE,
+    VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED,
+} VirtIOMSGLinuxBridgeSessionState;
+
+typedef struct VirtIOMSGLinuxBridge {
+    VirtIOMSGBusDevice parent_obj;
+
+    char *endpoint;
+    bool create_endpoint;
+    struct vmsg_bridge_uapi_endpoint_addr endpoint_addr;
+    uint32_t endpoint_handle;
+    bool endpoint_resolved;
+    char *devnode;
+    uint32_t tx_ring_entries;
+    uint32_t tx_ring_entry_size;
+    uint32_t rx_ring_entries;
+    uint32_t rx_ring_entry_size;
+
+    int dev_fd;
+    int ring_fd;
+    EventNotifier kick;
+    EventNotifier call;
+    bool kick_initialized;
+    bool call_initialized;
+
+    struct vmsg_bridge_uapi_ring_info tx_ring_info;
+    struct vmsg_bridge_uapi_ring_info rx_ring_info;
+    struct vmsg_bridge_uapi_caps caps;
+    VirtIOMSGTransportCaps transport_caps;
+    uint64_t last_online_epoch;
+    uint32_t vmm_max_msg_size;
+    uint32_t endpoint_max_msg_size;
+    bool rx_bridge_error_pending;
+    VirtIOMSG rx_bridge_error_msg;
+
+    void *rings;
+    size_t rings_size;
+    MemoryRegion dma_mr;
+    AddressSpace dma_as;
+    bool dma_as_initialized;
+    /* map_lock protects bridge map lists and lifecycle state. */
+    QemuMutex map_lock;
+    QTAILQ_HEAD(, VirtIOMSGLinuxBridgeMapEntry) map_entries;
+    QTAILQ_HEAD(, VirtIOMSGLinuxBridgeMapProtocolRecord)
+        map_protocol_records;
+    VirtIOMSGLinuxBridgeMapEntry *map_last_covering;
+    uint64_t map_use_seq;
+    Error *migration_blocker;
+    Notifier machine_done;
+    bool attached;
+    bool initial_attach_pending;
+    bool machine_ready;
+    VirtIOMSGLinuxBridgeSessionState session_state;
+    bool map_add_deferred;
+    bool map_del_deferred;
+    VirtIOMSGLinuxBridgeMapEvent map_add_deferred_event;
+    VirtIOMSGLinuxBridgeMapEvent map_del_deferred_event;
+    uint32_t map_add_defer_failures;
+    uint32_t map_add_defer_delay_ms;
+    uint32_t map_release_pending_count;
+    uint64_t map_release_generation;
+    uint32_t non_retained_live_count;
+    uint64_t non_retained_live_bytes;
+    bool map_completion_bh_scheduled;
+    bool map_reclaim_bh_scheduled;
+    QEMUTimer *map_add_defer_timer;
+    QEMUBH *map_completion_bh;
+    QEMUBH *map_reclaim_bh;
+    QTAILQ_HEAD(, VirtIOMSGLinuxBridgePendingTx) pending_tx;
+    QEMUTimer *pending_tx_retry_timer;
+    uint32_t pending_tx_retry_delay_ms;
+    VirtIOMSGLinuxBridgeDeferredCleanup deferred_cleanup;
+    uint32_t deferred_cleanup_release_reason;
+    uint64_t deferred_cleanup_online_epoch;
+    uint32_t deferred_cleanup_max_msg_size;
+    char deferred_cleanup_bus_name[VMSG_BRIDGE_UAPI_BUS_NAME_LEN];
+} VirtIOMSGLinuxBridge;
+
+static const char *virtio_msg_linux_bridge_result_to_str(int ret)
+{
+    switch (ret) {
+    case VIRTIO_MSG_NO_ERROR:
+        return "NO_ERROR";
+    case VIRTIO_MSG_ERROR_RETRY:
+        return "RETRY";
+    case VIRTIO_MSG_ERROR_TIMEOUT:
+        return "TIMEOUT";
+    case VIRTIO_MSG_ERROR_UNSUPPORTED_MESSAGE_ID:
+        return "UNSUPPORTED_MESSAGE_ID";
+    case VIRTIO_MSG_ERROR_BAD_MESSAGE:
+        return "BAD_MESSAGE";
+    case VIRTIO_MSG_ERROR_NO_DEVICE:
+        return "NO_DEVICE";
+    case VIRTIO_MSG_ERROR_MEMORY:
+        return "MEMORY";
+    default:
+        return "UNKNOWN";
+    }
+}
+
+#define VIRTIO_MSG_LINUX_BRIDGE_ERROR(_fmt, ...)                             \
+    qemu_log_mask(LOG_GUEST_ERROR, "virtio-msg/bridge: %s: " _fmt "\n",     \
+                  __func__, ##__VA_ARGS__)
+
+static bool virtio_msg_linux_bridge_msg_is_bridge_local(const VirtIOMSG *msg);
+
+static const char *bridge_msg_id_to_str(uint8_t type,
+                                         uint8_t msg_id)
+{
+    const char *name;
+
+    if (type & VIRTIO_MSG_TYPE_BUS) {
+        switch (msg_id) {
+        case VIRTIO_MSG_BUS_BRIDGE_ERROR:
+            return "BUS_BRIDGE_ERROR";
+        case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_ONLINE:
+            return "BUS_BRIDGE_ENDPOINT_ONLINE";
+        case VIRTIO_MSG_BUS_BRIDGE_ENDPOINT_OFFLINE:
+            return "BUS_BRIDGE_ENDPOINT_OFFLINE";
+        case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_RESET:
+            return "BUS_BRIDGE_TOPOLOGY_RESET";
+        case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_DEV_ADD:
+            return "BUS_BRIDGE_TOPOLOGY_DEV_ADD";
+        case VIRTIO_MSG_BUS_BRIDGE_TOPOLOGY_COMMIT:
+            return "BUS_BRIDGE_TOPOLOGY_COMMIT";
+        case VIRTIO_MSG_BUS_BRIDGE_MAP_ADD:
+            return "BUS_BRIDGE_MAP_ADD";
+        case VIRTIO_MSG_BUS_BRIDGE_MAP_DEL:
+            return "BUS_BRIDGE_MAP_DEL";
+        case VIRTIO_MSG_BUS_BRIDGE_MAP_RELEASED:
+            return "BUS_BRIDGE_MAP_RELEASED";
+        default:
+            break;
+        }
+    }
+
+    if (msg_id > VIRTIO_MSG_MAX) {
+        return "UNKNOWN";
+    }
+
+    name = virtio_msg_id_to_str(type, msg_id);
+    return name ? name : "UNKNOWN";
+}
