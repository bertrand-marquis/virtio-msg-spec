+virtio_msg_linux_bridge_map_tombstone(uint32_t endpoint_id, uint64_t epoch, uint64_t map_seq, uint64_t map_id, uint64_t bus_addr, uint64_t length) "ep=%u epoch=%"PRIu64" map_seq=%"PRIu64" map_id=%"PRIu64" addr=0x%"PRIx64" len=0x%"PRIx64
