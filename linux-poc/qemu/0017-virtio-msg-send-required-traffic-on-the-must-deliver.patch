diff --git a/include/hw/virtio/virtio-msg-bus.h b/include/hw/virtio/virtio-msg-bus.h
index d99d5369aea9..d85062d36c9f 100644
--- a/include/hw/virtio/virtio-msg-bus.h
+++ b/include/hw/virtio/virtio-msg-bus.h
@@ -49,6 +49,12 @@ struct VirtIOMSGBusDeviceClass {
      * Called by the transport to send a message.
      */
     int (*send)(VirtIOMSGBusDevice *bd, VirtIOMSG *msg_req);
+
+    /*
+     * Called by the transport to send required traffic that must be
+     * delivered eventually.
+     */
+    int (*send_must_deliver)(VirtIOMSGBusDevice *bd, VirtIOMSG *msg_req);
 };
 
 typedef struct VirtIOMSGBusDevice {
@@ -96,6 +102,7 @@ virtio_msg_bus_receive(VirtIOMSGBusDevice *bd, VirtIOMSG *msg)
 }
 
 int virtio_msg_bus_send(BusState *bus, VirtIOMSG *msg_req);
+int virtio_msg_bus_send_must_deliver(BusState *bus, VirtIOMSG *msg_req);
 
 static inline AddressSpace *virtio_msg_bus_get_remote_as(BusState *bus)
 {
