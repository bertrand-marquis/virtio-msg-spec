+/*
+ * Keep this enabled to route virtio-msg diagnostics through LOG_GUEST_ERROR,
+ * which makes them visible with "-d guest_errors". Comment it out while
+ * debugging to print the same diagnostics to stderr without requiring -d.
+ */
+#define VIRTIO_MSG_DEBUG_GUEST_ERRORS_ONLY 1
+
+/*
+ * Compile-time virtio-msg log subject switches.
+ */
+#define VIRTIO_MSG_LOG_EVENT 1
+#define VIRTIO_MSG_LOG_MAP_CTL 1
+#define VIRTIO_MSG_LOG_MAP_LIFE 1
+#define VIRTIO_MSG_LOG_DMA 0
+#define VIRTIO_MSG_LOG_FLOW 0
+#define VIRTIO_MSG_LOG_ERROR 1
+
+static inline const char *virtio_msg_result_to_str(int ret)
+{
+    switch (ret) {
+    case VIRTIO_MSG_NO_ERROR:
+        return "NO_ERROR";
+    case VIRTIO_MSG_ERROR_RETRY:
+        return "RETRY";
+    case VIRTIO_MSG_ERROR_TIMEOUT:
+        return "TIMEOUT";
+    case VIRTIO_MSG_ERROR_UNSUPPORTED_MESSAGE_ID:
+        return "UNSUPPORTED_MESSAGE_ID";
+    case VIRTIO_MSG_ERROR_BAD_MESSAGE:
+        return "BAD_MESSAGE";
+    case VIRTIO_MSG_ERROR_NO_DEVICE:
+        return "NO_DEVICE";
+    case VIRTIO_MSG_ERROR_MEMORY:
+        return "MEMORY";
+    default:
+        return "UNKNOWN";
+    }
+}
+
+static inline const char *virtio_msg_debug_id_to_str(uint8_t type,
+                                                      uint8_t msg_id)
+{
+    const char *name = NULL;
+
+    if (msg_id <= VIRTIO_MSG_MAX) {
+        name = virtio_msg_id_to_str(type, msg_id);
+    }
+
+    return name ? name : "UNKNOWN";
+}
+
+static inline G_GNUC_PRINTF(2, 3)
+void virtio_msg_debug_log_impl(const char *scope, const char *fmt, ...)
+{
+    va_list ap;
+    char *msg;
+
+    va_start(ap, fmt);
+    msg = g_strdup_vprintf(fmt, ap);
+    va_end(ap);
+
+#ifdef VIRTIO_MSG_DEBUG_GUEST_ERRORS_ONLY
+    qemu_log_mask(LOG_GUEST_ERROR, "virtio-msg/%s: %s\n", scope, msg);
+#else
+    fprintf(stderr, "virtio-msg/%s: %s\n", scope, msg);
+#endif
+
+    g_free(msg);
+}
+
+#define VIRTIO_MSG_LOG(_scope, _fmt, ...)                                    \
+    virtio_msg_debug_log_impl((_scope), "%s: " _fmt, __func__,               \
+                              ##__VA_ARGS__)
+
+#define VIRTIO_MSG_LOG_MSG(_scope, _dir, _msg)                               \
+    virtio_msg_debug_log_impl(                                                \
+        (_scope),                                                             \
+        "%s: %s msg=%s(0x%x) type=0x%x dev=%u token=%u size=%u",             \
+        __func__, (_dir),                                                     \
+        virtio_msg_debug_id_to_str((_msg)->type, (_msg)->msg_id),            \
+        (_msg)->msg_id, (_msg)->type, le16_to_cpu((_msg)->dev_num),          \
+        le16_to_cpu((_msg)->token), le16_to_cpu((_msg)->msg_size))
+
+#if VIRTIO_MSG_LOG_EVENT
+#define VIRTIO_MSG_EVENT_LOG(_scope, _fmt, ...)                              \
+    VIRTIO_MSG_LOG((_scope), "[event] " _fmt, ##__VA_ARGS__)
+#define VIRTIO_MSG_EVENT_LOG_MSG(_scope, _dir, _msg)                         \
+    VIRTIO_MSG_LOG_MSG((_scope), "[event] " _dir, (_msg))
+#else
+#define VIRTIO_MSG_EVENT_LOG(_scope, _fmt, ...) do { } while (0)
+#define VIRTIO_MSG_EVENT_LOG_MSG(_scope, _dir, _msg) do { } while (0)
+#endif
+
+#if VIRTIO_MSG_LOG_MAP_CTL
