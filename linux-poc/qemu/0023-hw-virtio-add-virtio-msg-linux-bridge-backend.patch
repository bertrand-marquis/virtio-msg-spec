+static bool virtio_msg_linux_bridge_map_busy_locked(
+    const VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    return entry->pin_refs != 0 ||
+           entry->active_refs != 0 ||
+           entry->install_refs != 0;
+}
+
+static bool virtio_msg_linux_bridge_ranges_overlap(uint64_t first_addr,
+                                                   uint64_t first_len,
+                                                   uint64_t second_addr,
+                                                   uint64_t second_len)
+{
+    uint64_t first_end;
+    uint64_t second_end;
+
+    if (!first_len || !second_len) {
+        return false;
+    }
+
+    if (first_addr > UINT64_MAX - first_len ||
+        second_addr > UINT64_MAX - second_len) {
+        return true;
+    }
+
+    first_end = first_addr + first_len;
+    second_end = second_addr + second_len;
+
+    return first_addr < second_end && second_addr < first_end;
+}
+
+static VirtIOMSGLinuxBridgeMapEntry *
+virtio_msg_linux_bridge_find_map_entry_by_id_locked(
+    VirtIOMSGLinuxBridge *s, uint64_t epoch, uint64_t map_id)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+
+    QTAILQ_FOREACH(entry, &s->map_entries, node) {
+        if (!entry->revoked &&
+            entry->epoch == epoch && entry->map_id == map_id) {
+            return entry;
+        }
+    }
+
+    return NULL;
+}
+
+static VirtIOMSGLinuxBridgeMapEntry *
+virtio_msg_linux_bridge_find_map_entry_by_id_any_locked(
+    VirtIOMSGLinuxBridge *s, uint64_t epoch, uint64_t map_id)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+
+    QTAILQ_FOREACH(entry, &s->map_entries, node) {
+        if (entry->epoch == epoch && entry->map_id == map_id) {
+            return entry;
+        }
+    }
+
+    return NULL;
+}
+
+static VirtIOMSGLinuxBridgeMapEntry *
+virtio_msg_linux_bridge_find_map_overlap_locked(
+    VirtIOMSGLinuxBridge *s, uint64_t bus_addr, uint64_t length)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+
+    QTAILQ_FOREACH(entry, &s->map_entries, node) {
+        if (!entry->revoked &&
+            virtio_msg_linux_bridge_ranges_overlap(entry->bus_addr,
+                                                   entry->length,
+                                                   bus_addr, length)) {
+            return entry;
+        }
+    }
+
+    return NULL;
+}
+
+static bool virtio_msg_linux_bridge_revoke_entry_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    if (entry->revoked) {
+        VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                                "revoke skip already revoked epoch=%" PRIu64
+                                " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                                " length=0x%" PRIx64
+                                " del_req_pending=%d attached=%d",
+                                entry->epoch, entry->map_id, entry->bus_addr,
+                                entry->length, entry->del_req_pending,
+                                entry->subregion_attached);
+        return true;
+    }
+
+    VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                            "revoke begin epoch=%" PRIu64
+                            " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                            " length=0x%" PRIx64
+                            " del_req_pending=%d attached=%d"
+                            " pin_refs=%u active_refs=%u install_refs=%u",
+                            entry->epoch, entry->map_id, entry->bus_addr,
+                            entry->length, entry->del_req_pending,
+                            entry->subregion_attached, entry->pin_refs,
+                            entry->active_refs, entry->install_refs);
+    if (s->map_last_covering == entry) {
+        VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                                "revoke invalidating covering cache "
+                                "epoch=%" PRIu64 " map_id=%" PRIu64,
+                                entry->epoch, entry->map_id);
+        virtio_msg_linux_bridge_map_cache_invalidate_locked(s);
+    }
+
+    if (entry->subregion_attached) {
+        VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                                "revoke detaching subregion epoch=%" PRIu64
+                                " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                                " length=0x%" PRIx64,
+                                entry->epoch, entry->map_id, entry->bus_addr,
+                                entry->length);
+        memory_region_del_subregion(&s->dma_mr, &entry->subregion_mr);
+        object_unparent(OBJECT(&entry->subregion_mr));
+        entry->subregion_attached = false;
+        VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                                "revoke detached subregion epoch=%" PRIu64
+                                " map_id=%" PRIu64,
+                                entry->epoch, entry->map_id);
+    }
+
+    VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                            "revoke mapping epoch=%" PRIu64
+                            " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                            " length=0x%" PRIx64 " pin_refs=%u active_refs=%u",
+                            entry->epoch, entry->map_id, entry->bus_addr,
+                            entry->length, entry->pin_refs,
+                            entry->active_refs);
+    entry->revoked = true;
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_try_finalize_revoked_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    bool ok = true;
+
+    if (!entry->revoked) {
+        return true;
+    }
+
+    if (virtio_msg_linux_bridge_map_busy_locked(entry)) {
+        VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                                "finalize deferred epoch=%" PRIu64
+                                " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                                " length=0x%" PRIx64
+                                " del_req_pending=%d pin_refs=%u"
+                                " active_refs=%u install_refs=%u",
+                                entry->epoch, entry->map_id, entry->bus_addr,
+                                entry->length, entry->del_req_pending,
+                                entry->pin_refs, entry->active_refs,
+                                entry->install_refs);
+        return true;
+    }
+
+    if (s->map_last_covering == entry) {
+        virtio_msg_linux_bridge_map_cache_invalidate_locked(s);
+    }
+
+    QTAILQ_REMOVE(&s->map_entries, entry, node);
+
+    if (entry->host_addr && entry->mmap_length) {
+        if (munmap(entry->host_addr, entry->mmap_length) < 0) {
+            VIRTIO_MSG_ERROR_LOG("bridge",
+                                 "mapping munmap failed epoch=%" PRIu64
+                                 " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                                 " length=0x%" PRIx64 ": %s",
+                                 entry->epoch, entry->map_id, entry->bus_addr,
+                                 entry->length, strerror(errno));
+            ok = false;
+        }
+    }
+
+    VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                            "finalize revoked mapping epoch=%" PRIu64
+                            " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                            " length=0x%" PRIx64,
+                            entry->epoch, entry->map_id, entry->bus_addr,
+                            entry->length);
+    aio_bh_schedule_oneshot(qemu_get_current_aio_context(),
+                            virtio_msg_linux_bridge_free_map_entry_bh, entry);
+    return ok;
+}
+
+static bool virtio_msg_linux_bridge_complete_del_req_locked(
+    VirtIOMSGLinuxBridge *s, VirtIOMSGLinuxBridgeMapEntry *entry)
+{
+    bool ok;
+    uint64_t epoch = entry->epoch;
+    uint64_t map_id = entry->map_id;
+    uint64_t bus_addr = entry->bus_addr;
+    uint64_t length = entry->length;
+
+    entry->del_req_pending = false;
+    VIRTIO_MSG_MAP_CTL_LOG("bridge",
+                           "complete DEL_REQ epoch=%" PRIu64
+                           " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                           " length=0x%" PRIx64,
+                           epoch, map_id, bus_addr, length);
+    ok = virtio_msg_linux_bridge_try_finalize_revoked_locked(s, entry);
+    if (!ok) {
+        return false;
+    }
+
+    trace_virtio_msg_linux_bridge_map_event_remove(s->endpoint_handle,
+                                                   epoch, map_id, bus_addr,
+                                                   length);
+    return true;
+}
+
+static void virtio_msg_linux_bridge_free_map_entry_bh(void *opaque)
+{
+    g_free(opaque);
+}
+
+static void virtio_msg_linux_bridge_unmap_all(VirtIOMSGLinuxBridge *s)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry;
+    VirtIOMSGLinuxBridgeMapEntry *next;
+
+    qemu_mutex_lock(&s->map_lock);
+    QTAILQ_FOREACH_SAFE(entry, &s->map_entries, node, next) {
+        entry->del_req_pending = false;
+        virtio_msg_linux_bridge_revoke_entry_locked(s, entry);
+        virtio_msg_linux_bridge_try_finalize_revoked_locked(s, entry);
+    }
+    qemu_mutex_unlock(&s->map_lock);
+}
+
+static uint32_t *virtio_msg_linux_bridge_map_refs_by_kind(
+    VirtIOMSGLinuxBridgeMapEntry *entry, RAMBlockMapKind kind)
+{
+    switch (kind) {
+    case RAM_BLOCK_MAP_KIND_DIRECT:
+        return &entry->active_refs;
+    case RAM_BLOCK_MAP_KIND_CACHE:
+        return &entry->pin_refs;
+    default:
+        return NULL;
+    }
+}
+
+static void *virtio_msg_linux_bridge_ram_map(void *opaque, RAMBlock *block,
+                                             ram_addr_t offset, hwaddr *len,
+                                             bool is_write,
+                                             RAMBlockMapKind kind)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry = opaque;
+    VirtIOMSGLinuxBridge *s = entry->bridge;
+    uint32_t *refs;
+    void *host_ptr = NULL;
+
+    (void)block;
+    if (!len || *len == 0) {
+        return NULL;
+    }
+
+    qemu_mutex_lock(&s->map_lock);
+    refs = virtio_msg_linux_bridge_map_refs_by_kind(entry, kind);
+    if (entry->revoked || !entry->host_addr || offset >= entry->length ||
+        !refs || *refs == UINT32_MAX) {
+        *len = 0;
+        goto out;
+    }
+
+    *len = MIN(*len, entry->length - offset);
+    host_ptr = (uint8_t *)entry->host_addr + offset;
+    (*refs)++;
+    virtio_msg_linux_bridge_map_touch_locked(s, entry);
+out:
+    qemu_mutex_unlock(&s->map_lock);
+    return host_ptr;
+}
+
+static bool virtio_msg_linux_bridge_ram_from_host(void *opaque, RAMBlock *block,
+                                                  void *host,
+                                                  ram_addr_t *offset)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry = opaque;
+    uintptr_t base;
+    uintptr_t ptr;
+    ram_addr_t delta;
+
+    (void)block;
+    if (!entry->host_addr || !host) {
+        return false;
+    }
+
+    base = (uintptr_t)entry->host_addr;
+    ptr = (uintptr_t)host;
+    if (ptr < base) {
+        return false;
+    }
+
+    delta = ptr - base;
+    if (delta >= entry->length) {
+        return false;
+    }
+
+    *offset = delta;
+    return true;
+}
+
+static void virtio_msg_linux_bridge_ram_put(void *opaque, RAMBlock *block,
+                                            void *host, ram_addr_t offset,
+                                            hwaddr len, bool is_write,
+                                            RAMBlockMapKind kind)
+{
+    VirtIOMSGLinuxBridgeMapEntry *entry = opaque;
+    VirtIOMSGLinuxBridge *s = entry->bridge;
+    uint32_t *refs;
+
+    (void)block;
+    (void)host;
+    (void)offset;
+    (void)len;
+
+    qemu_mutex_lock(&s->map_lock);
+    refs = virtio_msg_linux_bridge_map_refs_by_kind(entry, kind);
+    if (!refs) {
+        qemu_mutex_unlock(&s->map_lock);
+        return;
+    }
+
+    if (!*refs) {
+        VIRTIO_MSG_LOG("bridge",
+                       "unbalanced mapping release epoch=%" PRIu64
+                       " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                       " length=0x%" PRIx64,
+                       entry->epoch, entry->map_id,
+                       entry->bus_addr, entry->length);
+        qemu_mutex_unlock(&s->map_lock);
+        return;
+    }
+
+    (*refs)--;
+    if (!entry->revoked) {
+        virtio_msg_linux_bridge_map_touch_locked(s, entry);
+    }
+    if (entry->revoked || entry->del_req_pending) {
+        VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                                "release ref epoch=%" PRIu64
+                                " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                                " length=0x%" PRIx64
+                                " revoked=%d del_req_pending=%d"
+                                " pin_refs=%u active_refs=%u install_refs=%u",
+                                entry->epoch, entry->map_id, entry->bus_addr,
+                                entry->length, entry->revoked,
+                                entry->del_req_pending, entry->pin_refs,
+                                entry->active_refs, entry->install_refs);
+    }
+    if (!entry->del_req_pending) {
+        virtio_msg_linux_bridge_try_finalize_revoked_locked(s, entry);
+    } else if (entry->revoked &&
+               !virtio_msg_linux_bridge_map_busy_locked(entry)) {
+        VIRTIO_MSG_MAP_LIFE_LOG("bridge",
+                                "pending revoke reached zero refs "
+                                "epoch=%" PRIu64
+                                " map_id=%" PRIu64 " bus_addr=0x%" PRIx64
+                                " length=0x%" PRIx64
+                                " waiting for DEL_REQ retry completion",
+                                entry->epoch, entry->map_id, entry->bus_addr,
+                                entry->length);
+    }
+    qemu_mutex_unlock(&s->map_lock);
+}
+
+static const RAMBlockMapOps virtio_msg_linux_bridge_ram_map_ops = {
+    .map = virtio_msg_linux_bridge_ram_map,
+    .from_host = virtio_msg_linux_bridge_ram_from_host,
+    .put = virtio_msg_linux_bridge_ram_put,
+};
