+#else
+#define VIRTIO_MSG_MAP_LIFE_LOG(_scope, _fmt, ...) do { } while (0)
+#endif
+
+#if VIRTIO_MSG_LOG_DMA
+#define VIRTIO_MSG_DMA_LOG(_scope, _fmt, ...)                                \
