+static void virtio_msg_linux_bridge_msg_payload_summary(const VirtIOMSG *msg,
+                                                        char *buf,
+                                                        size_t buf_size)
+{
+    bool response = msg->type & VIRTIO_MSG_TYPE_RESPONSE;
+
+    if (!buf_size) {
+        return;
+    }
+
+    buf[0] = '\0';
+
+    if (msg->type & VIRTIO_MSG_TYPE_BUS) {
+        switch (msg->msg_id) {
+        case VIRTIO_MSG_BUS_GET_DEVICES:
+            if (response) {
+                snprintf(buf, buf_size,
+                         "offset=%u num=%u next_offset=%u",
+                         le16_to_cpu(msg->bus_get_devices_resp.offset),
+                         le16_to_cpu(msg->bus_get_devices_resp.num),
+                         le16_to_cpu(msg->bus_get_devices_resp.next_offset));
+            } else {
+                snprintf(buf, buf_size, "offset=%u num=%u",
+                         le16_to_cpu(msg->bus_get_devices.offset),
+                         le16_to_cpu(msg->bus_get_devices.num));
+            }
+            break;
+        case VIRTIO_MSG_BUS_PING:
+            snprintf(buf, buf_size, "data=0x%x",
+                     response ? le32_to_cpu(msg->bus_ping_resp.data) :
+                     le32_to_cpu(msg->bus_ping.data));
+            break;
+        case VIRTIO_MSG_BUS_EVENT_DEVICE:
+            snprintf(buf, buf_size,
+                     "dev=%u state=0x%x",
+                     le16_to_cpu(msg->bus_event_device.dev_num),
+                     le16_to_cpu(msg->bus_event_device.dev_state));
+            break;
+        default:
+            break;
+        }
+        return;
+    }
+
+    if (response) {
+        switch (msg->msg_id) {
+        case VIRTIO_MSG_GET_VQUEUE:
+            snprintf(buf, buf_size,
+                     "idx=%u max=%u size=%u desc=0x%" PRIx64
+                     " driver=0x%" PRIx64 " device=0x%" PRIx64,
+                     le32_to_cpu(msg->get_vqueue_resp.index),
+                     le32_to_cpu(msg->get_vqueue_resp.max_size),
+                     le32_to_cpu(msg->get_vqueue_resp.size),
+                     le64_to_cpu(msg->get_vqueue_resp.descriptor_addr),
+                     le64_to_cpu(msg->get_vqueue_resp.driver_addr),
+                     le64_to_cpu(msg->get_vqueue_resp.device_addr));
+            break;
+        case VIRTIO_MSG_GET_CONFIG:
+            snprintf(buf, buf_size, "offset=%u size=%u",
+                     le32_to_cpu(msg->get_config_resp.offset),
+                     le32_to_cpu(msg->get_config_resp.size));
+            break;
+        case VIRTIO_MSG_SET_CONFIG:
+            snprintf(buf, buf_size, "offset=%u size=%u",
+                     le32_to_cpu(msg->set_config_resp.offset),
+                     le32_to_cpu(msg->set_config_resp.size));
+            break;
+        default:
+            break;
+        }
+        return;
+    }
+
+    switch (msg->msg_id) {
+    case VIRTIO_MSG_GET_VQUEUE:
+        snprintf(buf, buf_size, "idx=%u",
+                 le32_to_cpu(msg->get_vqueue.index));
+        break;
+    case VIRTIO_MSG_SET_VQUEUE:
+        snprintf(buf, buf_size,
+                 "idx=%u size=%u desc=0x%" PRIx64
+                 " driver=0x%" PRIx64 " device=0x%" PRIx64,
+                 le32_to_cpu(msg->set_vqueue.index),
+                 le32_to_cpu(msg->set_vqueue.size),
+                 le64_to_cpu(msg->set_vqueue.descriptor_addr),
+                 le64_to_cpu(msg->set_vqueue.driver_addr),
+                 le64_to_cpu(msg->set_vqueue.device_addr));
+        break;
+    case VIRTIO_MSG_RESET_VQUEUE:
+        snprintf(buf, buf_size, "idx=%u",
+                 le32_to_cpu(msg->reset_vqueue.index));
+        break;
+    case VIRTIO_MSG_GET_CONFIG:
+        snprintf(buf, buf_size, "offset=%u size=%u",
+                 le32_to_cpu(msg->get_config.offset),
+                 le32_to_cpu(msg->get_config.size));
+        break;
+    case VIRTIO_MSG_SET_CONFIG:
+        snprintf(buf, buf_size, "offset=%u size=%u",
+                 le32_to_cpu(msg->set_config.offset),
+                 le32_to_cpu(msg->set_config.size));
+        break;
+    case VIRTIO_MSG_EVENT_CONFIG:
+        snprintf(buf, buf_size,
+                 "status=0x%x gen=%u offset=%u size=%u",
+                 le32_to_cpu(msg->event_config.status),
+                 le32_to_cpu(msg->event_config.generation),
+                 le32_to_cpu(msg->event_config.offset),
+                 le32_to_cpu(msg->event_config.size));
+        break;
+    case VIRTIO_MSG_EVENT_AVAIL:
+        snprintf(buf, buf_size,
+                 "idx=%u next_wrap=0x%x",
+                 le32_to_cpu(msg->event_avail.index),
+                 le32_to_cpu(msg->event_avail.next_offset_wrap));
+        break;
+    case VIRTIO_MSG_EVENT_USED:
+        snprintf(buf, buf_size, "idx=%u",
+                 le32_to_cpu(msg->event_used.index));
+        break;
+    default:
+        break;
+    }
+}
+
+static void virtio_msg_linux_bridge_log_msg_summary(VirtIOMSGLinuxBridge *s,
+                                                   const VirtIOMSG *msg,
+                                                   bool rx)
+{
+    char payload[192];
+    const char *name = virtio_msg_debug_id_to_str(msg->type, msg->msg_id);
+    const char *direction = virtio_msg_linux_bridge_msg_direction(rx);
+    uint16_t dev_num = le16_to_cpu(msg->dev_num);
+    uint16_t token = le16_to_cpu(msg->token);
+    uint16_t size = le16_to_cpu(msg->msg_size);
+    uint32_t endpoint_handle = s ? s->endpoint_handle : 0;
+
+    virtio_msg_linux_bridge_msg_payload_summary(msg, payload, sizeof(payload));
+
+    virtio_msg_debug_log_impl("bridge",
+                              "%s: endpoint=%" PRIu32 " %s %s dev=%u token=%u "
+                              "size=%u%s%s",
+                              __func__, endpoint_handle, direction,
+                              name ? name : "UNKNOWN",
+                              dev_num, token, size,
+                              payload[0] ? " " : "", payload);
+}
+
+static void virtio_msg_linux_bridge_log_map_event_summary(
+    const char *stage,
+    VirtIOMSGLinuxBridge *s,
+    const struct vmsg_bridge_uapi_map_event *event)
+{
+    uint32_t endpoint_handle = s ? s->endpoint_handle : 0;
+    virtio_msg_debug_log_impl(
+        "bridge",
+        "%s: endpoint=%" PRIu32 " %s epoch=%" PRIu64 " map_id=%" PRIu64
+        " seq=%" PRIu64 " addr=0x%" PRIx64 " len=0x%" PRIx64 "",
+        __func__, endpoint_handle, stage,
+        (uint64_t)event->epoch,
+        (uint64_t)event->map_id,
+        (uint64_t)event->seq,
+        (uint64_t)event->bus_addr,
+        (uint64_t)event->length);
+}
+
+static void virtio_msg_linux_bridge_cancel_topology_retry(
+    VirtIOMSGLinuxBridge *s);
+
+static void virtio_msg_linux_bridge_set_state(
+    VirtIOMSGLinuxBridge *s,
+    VirtIOMSGLinuxBridgeSessionState state)
+{
+    s->session_state = state;
+
+    switch (state) {
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_NEEDS_TOPOLOGY:
+        s->caps.flags |= VMSG_BRIDGE_UAPI_CAP_F_ENDPOINT_ONLINE;
+        s->topology_retry_failures = 0;
+        s->topology_retry_delay_ms =
+            VIRTIO_MSG_LINUX_BRIDGE_TOPOLOGY_RETRY_DELAY_MIN_MS;
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE:
+        s->caps.flags |= VMSG_BRIDGE_UAPI_CAP_F_ENDPOINT_ONLINE;
+        virtio_msg_linux_bridge_cancel_topology_retry(s);
+        break;
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED:
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_OFFLINE:
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED:
+        s->caps.flags &= ~VMSG_BRIDGE_UAPI_CAP_F_ENDPOINT_ONLINE;
+        virtio_msg_linux_bridge_cancel_topology_retry(s);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static bool virtio_msg_linux_bridge_state_allows_control(
+    const VirtIOMSGLinuxBridge *s)
+{
+    switch (s->session_state) {
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_OFFLINE:
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_NEEDS_TOPOLOGY:
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE:
+        return true;
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_DETACHED:
+    case VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_FAILED:
+        return false;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static bool virtio_msg_linux_bridge_state_allows_topology(
+    const VirtIOMSGLinuxBridge *s)
+{
+    return s->session_state ==
+        VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_NEEDS_TOPOLOGY;
+}
+
+static bool virtio_msg_linux_bridge_state_allows_map(
+    const VirtIOMSGLinuxBridge *s)
+{
+    return s->session_state ==
+        VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE;
+}
+
+static bool virtio_msg_linux_bridge_state_allows_data(
+    const VirtIOMSGLinuxBridge *s)
+{
+    return s->session_state ==
+        VIRTIO_MSG_LINUX_BRIDGE_SESSION_STATE_ATTACHED_ONLINE_ACTIVE;
+}
