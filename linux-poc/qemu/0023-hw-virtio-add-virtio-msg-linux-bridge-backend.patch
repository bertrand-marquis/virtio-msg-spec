+static int virtio_msg_linux_bridge_ioctl(int fd, unsigned long req, void *arg)
+{
+    int ret;
+
+    do {
+        ret = ioctl(fd, req, arg);
+    } while (ret < 0 && errno == EINTR);
+
+    return ret;
+}
