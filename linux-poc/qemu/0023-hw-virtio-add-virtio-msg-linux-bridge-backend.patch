+static bool virtio_msg_linux_bridge_errno_is_transient(int err)
+{
+    switch (err) {
+    case EAGAIN:
+#ifdef EWOULDBLOCK
+#if EWOULDBLOCK != EAGAIN
+    case EWOULDBLOCK:
+#endif
+#endif
+    case ENOSPC:
+    case ENOMEM:
+    case EBUSY:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static bool virtio_msg_linux_bridge_errno_is_terminal(int err)
+{
+    switch (err) {
+    case ENOTCONN:
+    case EPROTO:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static int virtio_msg_linux_bridge_receive_error_to_errno(int ret)
+{
+    switch (ret) {
+    case VIRTIO_MSG_ERROR_NO_DEVICE:
+        return -ENODEV;
+    case VIRTIO_MSG_ERROR_UNSUPPORTED_MESSAGE_ID:
+        return -EOPNOTSUPP;
+    case VIRTIO_MSG_ERROR_BAD_MESSAGE:
+        return -EPROTO;
+    case VIRTIO_MSG_ERROR_MEMORY:
+        return -ENOMEM;
+    case VIRTIO_MSG_ERROR_TIMEOUT:
+        return -ETIMEDOUT;
+    default:
+        return 0;
+    }
+}
+
+static bool virtio_msg_linux_bridge_is_transport_request(const VirtIOMSG *msg)
+{
+    /*
+     * Transport message IDs use bit 6 to distinguish requests from events:
+     * 0x00-0x3f and 0x80-0xbf are requests, while 0x40-0x7f and 0xc0-0xff
+     * are events. Responses and bus traffic are excluded separately.
+     */
+    return !(msg->type & (VIRTIO_MSG_TYPE_BUS | VIRTIO_MSG_TYPE_RESPONSE)) &&
+           !(msg->msg_id & VIRTIO_MSG_EVENT_CONFIG);
+}
+
+static int virtio_msg_linux_bridge_report_msg_error(VirtIOMSGLinuxBridge *s,
+                                                    const VirtIOMSG *msg,
+                                                    int ret)
+{
+    struct vmsg_bridge_uapi_msg_error msg_error = { 0 };
+    int report_error = virtio_msg_linux_bridge_receive_error_to_errno(ret);
+
+    if (!report_error) {
+        return 0;
+    }
+
+    msg_error.dev_num = msg->dev_num;
+    msg_error.token = msg->token;
+    msg_error.msg_id = msg->msg_id;
+    msg_error.error = report_error;
+
+    if (virtio_msg_linux_bridge_ioctl(s->dev_fd, VMSG_BRIDGE_IOCTL_MSG_ERROR,
+                                      &msg_error) >= 0) {
+        return 0;
+    }
+
+    return -errno;
+}
+
+static bool virtio_msg_linux_bridge_parse_endpoint(VirtIOMSGLinuxBridge *s,
+                                                   Error **errp)
+{
+    struct vmsg_bridge_uapi_endpoint_addr addr = { 0 };
+    const char *endpoint = s->endpoint;
+    const char *sep;
+    const char *bus_id = "";
+    size_t bus_name_len;
+    size_t bus_id_len;
+
+    if (!endpoint || !endpoint[0]) {
+        VIRTIO_MSG_LOG("bridge", "endpoint property is empty");
+        error_setg(errp, "endpoint is required and must not be empty");
+        return false;
+    }
+
+    sep = strchr(endpoint, ':');
+    bus_name_len = sep ? (size_t)(sep - endpoint) : strlen(endpoint);
+    if (bus_name_len == 0) {
+        VIRTIO_MSG_LOG("bridge", "invalid endpoint '%s': empty bus name",
+                       endpoint);
+        error_setg(errp, "invalid endpoint '%s': bus-name is empty", endpoint);
+        return false;
+    }
+    if (bus_name_len >= VMSG_BRIDGE_UAPI_BUS_NAME_LEN) {
+        VIRTIO_MSG_LOG("bridge", "invalid endpoint '%s': bus name too long",
+                       endpoint);
+        error_setg(errp,
+                   "invalid endpoint '%s': bus-name is too long (max %u chars)",
+                   endpoint, VMSG_BRIDGE_UAPI_BUS_NAME_LEN - 1);
+        return false;
+    }
+
+    memcpy(addr.bus_name, endpoint, bus_name_len);
+    if (sep) {
+        bus_id = sep + 1;
+    }
+
+    bus_id_len = strlen(bus_id);
+    if (bus_id_len >= VMSG_BRIDGE_UAPI_BUS_ID_LEN) {
+        VIRTIO_MSG_LOG("bridge", "invalid endpoint '%s': bus id too long",
+                       endpoint);
+        error_setg(errp,
+                   "invalid endpoint '%s': bus-id is too long (max %u chars)",
+                   endpoint, VMSG_BRIDGE_UAPI_BUS_ID_LEN - 1);
+        return false;
+    }
+    memcpy(addr.bus_id, bus_id, bus_id_len);
+
+    s->endpoint_addr = addr;
+    return true;
+}
+
+static bool virtio_msg_linux_bridge_resolve_endpoint(VirtIOMSGLinuxBridge *s,
+                                                     Error **errp)
+{
+    struct vmsg_bridge_uapi_resolve_endpoint resolve = { 0 };
+    int ret;
+
+    resolve.addr = s->endpoint_addr;
+    resolve.flags = s->create_endpoint ?
+        VMSG_BRIDGE_UAPI_RESOLVE_F_CREATE : 0;
+    ret = virtio_msg_linux_bridge_ioctl(s->dev_fd,
+                                        VMSG_BRIDGE_IOCTL_RESOLVE_ENDPOINT,
+                                        &resolve);
+    if (ret < 0) {
+        VIRTIO_MSG_LOG("bridge",
+                       "RESOLVE_ENDPOINT failed endpoint=%s create=%d: %s",
+                       s->endpoint, s->create_endpoint, strerror(errno));
+        error_setg_errno(errp, errno,
+                         "bridge RESOLVE_ENDPOINT failed for endpoint '%s'",
+                         s->endpoint);
+        return false;
+    }
+    if (!resolve.handle) {
+        VIRTIO_MSG_LOG("bridge",
+                       "RESOLVE_ENDPOINT returned handle 0 endpoint=%s",
+                       s->endpoint);
+        error_setg(errp,
+                   "bridge RESOLVE_ENDPOINT returned invalid handle 0 "
+                   "for endpoint '%s'",
+                   s->endpoint);
+        return false;
+    }
+
+    s->endpoint_handle = resolve.handle;
+    s->endpoint_resolved = true;
+    VIRTIO_MSG_LOG("bridge", "resolved endpoint=%s handle=%u create=%d",
+                   s->endpoint, s->endpoint_handle, s->create_endpoint);
+    return true;
+}
+
+static void virtio_msg_linux_bridge_release_endpoint(VirtIOMSGLinuxBridge *s)
+{
+    struct vmsg_bridge_uapi_release_endpoint release = { 0 };
+    int ret;
+
+    if (!s->endpoint_resolved || s->dev_fd < 0) {
+        return;
+    }
+
+    release.handle = s->endpoint_handle;
+    ret = virtio_msg_linux_bridge_ioctl(s->dev_fd,
+                                        VMSG_BRIDGE_IOCTL_RELEASE_ENDPOINT,
+                                        &release);
+    if (ret < 0) {
+        VIRTIO_MSG_LOG("bridge",
+                       "RELEASE_ENDPOINT failed handle=%u: %s",
+                       s->endpoint_handle, strerror(errno));
+    } else {
+        VIRTIO_MSG_LOG("bridge", "released endpoint handle=%u",
+                       s->endpoint_handle);
+    }
+    s->endpoint_resolved = false;
+    s->endpoint_handle = 0;
+}
+
+static void virtio_msg_linux_bridge_release_rings(VirtIOMSGLinuxBridge *s)
+{
+    if (!s->rings) {
+        return;
+    }
+
+    if (munmap(s->rings, s->rings_size) < 0) {
+        VIRTIO_MSG_LOG("bridge", "ring munmap failed: %s", strerror(errno));
+    }
+    s->rings = NULL;
+    s->rings_size = 0;
+}
